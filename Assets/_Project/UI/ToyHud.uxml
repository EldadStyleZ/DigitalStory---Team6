<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="ToyHud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="bottom" class="bottom" picking-mode="Ignore">
            <ui:VisualElement name="combo-row" class="combo-row" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="flute" class="flute" picking-mode="Ignore">
            <ui:Label class="group-name group-call" text="Call" picking-mode="Ignore" />
            <ui:Label class="group-name group-march" text="March" picking-mode="Ignore" />
            <ui:Label class="group-name group-scare" text="Scare" picking-mode="Ignore" />
            <ui:VisualElement name="hole-1" class="hole hole-1"><ui:Label class="hole-number" text="1" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hole-2" class="hole hole-2"><ui:Label class="hole-number" text="2" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hole-3" class="hole hole-3"><ui:Label class="hole-number" text="3" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hole-4" class="hole hole-4"><ui:Label class="hole-number" text="4" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hole-5" class="hole hole-5"><ui:Label class="hole-number" text="5" picking-mode="Ignore" /></ui:VisualElement>
            <ui:VisualElement name="hole-6" class="hole hole-6"><ui:Label class="hole-number" text="6" picking-mode="Ignore" /></ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
