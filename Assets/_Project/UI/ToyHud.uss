.hud {
    flex-grow: 1;
    justify-content: flex-end;
}

.bottom {
    align-items: center;
    margin-bottom: 8px;
}

.combo-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0 10px 4px 10px;
}

/* The team's flute, upright on the right. FluteBar swaps its picture to show the hole being played. */
.flute {
    position: absolute;
    right: 24px;
    top: 105px;
    width: 52px;
    height: 310px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Each hole is a see-through button over a hole in the picture, at the spot measured from the team's drawings. */
.hole {
    position: absolute;
    left: 43.3%;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    margin-top: -12px;
    border-radius: 12px;
}

.hole-1 { top: 30.8%; }
.hole-2 { top: 39%; }
.hole-3 { top: 52.7%; }
.hole-4 { top: 60.3%; }
.hole-5 { top: 74.1%; }
.hole-6 { top: 81.1%; }

.hole--held {
    background-color: rgba(255, 214, 102, 0.3);
}

.hole-number {
    position: absolute;
    left: -16px;
    top: 4px;
    padding: 0;
    color: rgba(243, 234, 214, 0.75);
    font-size: 11px;
}

.group-name {
    position: absolute;
    right: 64px;
    width: 60px;
    padding: 0;
    color: rgb(243, 234, 214);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.group-call { top: 32%; }
.group-march { top: 53.5%; }
.group-scare { top: 74.6%; }

.chip {
    flex-direction: row;
    align-items: center;
    margin: 3px;
    padding: 3px 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
    background-color: rgba(18, 20, 34, 0.84);
}

.chip--resting {
    opacity: 0.35;
}

.chip--glowing {
    background-color: rgba(40, 42, 60, 0.95);
}

.chip-title {
    margin-right: 6px;
    padding: 0;
    color: rgb(243, 234, 214);
    font-size: 13px;
}

.chip-keys {
    flex-direction: row;
}

.key {
    width: 17px;
    height: 17px;
    margin-left: 2px;
    padding: 0;
    border-radius: 4px;
    background-color: rgb(232, 197, 71);
    color: rgb(35, 28, 12);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
