/* The hive defense HUD. Colours match the existing HUD (HudConfig). */
.hud-root {
    --text: rgb(243, 234, 214);
    --caption: rgb(170, 167, 187);
    --panel: rgba(18, 20, 34, 0.55);
    --track: rgba(255, 255, 255, 0.12);
    --gold: rgb(232, 197, 71);
    --wasp: rgb(242, 181, 68);
    --danger: rgb(224, 72, 60);
    --alarm: rgb(255, 150, 40);
    --fury: rgb(176, 92, 230);
    --fury-glow: rgb(255, 214, 90);
    --overlay: rgba(9, 10, 20, 0.74);
    --key-text: rgb(35, 28, 12);
    --farm: rgb(140, 200, 190);
    --survive: rgb(255, 150, 40);
    --health: rgb(77, 217, 77);
    --store: rgb(255, 199, 38);
    --nest: rgb(255, 200, 120);

    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
    font-size: 13px;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.panel {
    background-color: var(--panel);
    border-radius: 6px;
    padding: 3px 8px;
    margin-bottom: 4px;
    min-width: 150px;
}

.panel-title {
    color: var(--caption);
    font-size: 11px;
    padding: 0;
    margin-right: 8px;
}

.bar-track {
    height: 6px;
    margin-top: 2px;
    background-color: var(--track);
    border-radius: 3px;
    overflow: hidden;
}

.bar-fill {
    width: 0;
    height: 100%;
    border-radius: 3px;
}

/* Top left: wasps and Fury */
.top-left {
    position: absolute;
    left: 12px;
    top: 12px;
}

.wasp-count {
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
    padding: 0;
}

.wasp-count--low {
    color: var(--alarm);
}

.wasp-fill {
    background-color: var(--wasp);
}

.wasp-fill--low {
    background-color: var(--alarm);
}

.fury-keys {
    color: var(--caption);
    font-size: 11px;
    padding: 0;
}

.fury-fill {
    background-color: var(--fury);
}

.fury-panel--full {
    border-width: 2px;
    border-color: var(--fury-glow);
    background-color: rgba(70, 30, 100, 0.9);
}

.fury-panel--full .fury-fill {
    background-color: var(--fury-glow);
}

.fury-panel--full .fury-keys {
    color: var(--fury-glow);
    -unity-font-style: bold;
}

/* Top centre: the phase. Calm for a farm phase, warm for a survive phase. */
.top-center {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    align-items: center;
}

.phase-label {
    font-size: 18px;
    -unity-font-style: bold;
    background-color: var(--panel);
    border-radius: 6px;
    padding: 2px 12px;
    border-bottom-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.phase-label--farm {
    color: var(--farm);
    border-color: var(--farm);
}

.phase-label--survive {
    color: var(--survive);
    border-color: var(--survive);
}

/* On their own backing, because bare caption text is unreadable over the bright grass. */
.top-center .phase-hint {
    font-size: 12px;
    color: var(--caption);
    margin-top: 4px;
}

.top-center .banner-line {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--text);
    margin-top: 4px;
    padding: 2px 16px;
}

.top-center .granted-line {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--wasp);
    margin-top: 2px;
}

/* Hives, down the left side: in the top-left column under the wasps, Fury and the nest count, so nothing overlaps as it grows */
.hives {
    flex-direction: column;
}

.hive-panel {
    min-width: 150px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(10, 12, 8, 0.42);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 200, 90, 0.22);
    padding: 4px 14px 4px 4px;
    margin-bottom: 6px;
}

/* The bars live in the hexagon emblem now: its rim is the health and the honey inside is the store. */
.hive-panel .bar-track {
    display: none;
}

.hive-body {
    margin-left: 8px;
}

.hive-title {
    color: var(--text);
    font-size: 11px;
    padding: 0;
}

/* Green health and a gold store, as on the bars over the hives in the world. */
.hive-fill {
    background-color: var(--health);
}

/* The store is a smaller bar and a number, so health stays the main bar. */
.bar-track--thin {
    height: 3px;
    margin-top: 3px;
}

.hive-store-fill {
    background-color: var(--store);
}

.hive-store-label {
    color: var(--store);
    font-size: 11px;
    padding: 0;
}

.hive-stopped {
    display: none;
    flex-grow: 1;
    margin-left: 6px;
    color: var(--alarm);
    font-size: 10px;
    padding: 0;
}

.hive-stopped--shown {
    display: flex;
}

.hive-hint {
    display: none;
    color: var(--gold);
    font-size: 11px;
    padding: 0;
    margin-top: 2px;
}

.hive-hint--shown {
    display: flex;
}

.hive-panel--flash {
    border-color: var(--alarm);
    background-color: rgba(120, 35, 12, 0.55);
}

.hive-panel--flash .hive-fill {
    background-color: var(--alarm);
}

.hive-panel--destroyed {
    opacity: 0.4;
}

/* Bottom: recent notes */
.bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    align-items: center;
}

.notes {
    flex-direction: row;
    justify-content: center;
    height: 26px;
    margin-bottom: 4px;
}

.note {
    width: 22px;
    height: 22px;
    margin: 0 3px;
    border-radius: 11px;
    font-size: 12px;
    color: var(--key-text);
    -unity-text-align: middle-center;
    padding: 0;
    display: none;
}

.note--shown {
    display: flex;
}

/* Lines above the notes: the first prompt and discoveries. Hidden until shown. */
.line {
    display: none;
    font-size: 13px;
    padding: 1px 10px;
    margin-bottom: 3px;
    border-radius: 6px;
    background-color: var(--panel);
}

.line--shown {
    display: flex;
}

.prompt-line {
    color: var(--caption);
}

.message-line {
    -unity-font-style: bold;
}

.note--hint {
    border-width: 2px;
    border-color: var(--fury-glow);
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin: 0 1px;
}

/* The songbook, bottom right, where it leaves room for the hives on the left even at fourteen songs. Quiet: no panel and partly see-through, but its notes stay readable. */
.songbook {
    position: absolute;
    right: 12px;
    bottom: 10px;
    opacity: 0.75;
}

.songbook-title {
    color: var(--caption);
    font-size: 11px;
    padding: 0;
    margin-bottom: 2px;
}

/* Wide enough for seven notes, the name and the cost. */
.songbook-chips {
    width: 264px;
}

.chip {
    flex-direction: row;
    align-items: center;
    height: 22px;
    margin-bottom: 2px;
    padding: 0 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    background-color: rgba(255, 255, 255, 0.04);
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.05s;
}

.chip-mark,
.chip-title,
.chip-cost {
    display: none;
}

.chip--known {
    border-color: rgba(255, 255, 255, 0.22);
    background-color: var(--panel);
}

.chip--known .chip-mark,
.chip--known .chip-title,
.chip--known .chip-cost {
    display: flex;
}

.chip--known.chip--resting {
    opacity: 0.7;
}

/* The songbook's own opacity caps brightness, so the flash lifts the backing and the border. */
.chip--bright {
    border-color: var(--text);
    background-color: rgba(255, 255, 255, 0.30);
}

.chip--nudge {
    translate: 3px 0;
    border-color: var(--text);
}

/* Category marks, so colour is never the only cue: diamond attack, circle defense, square power. */
.chip-mark {
    width: 8px;
    height: 8px;
    margin-right: 6px;
}

.chip-mark--attack {
    rotate: 45deg;
    width: 7px;
    height: 7px;
}

.chip-mark--defense {
    border-radius: 4px;
}

.chip-mark--power {
    border-radius: 1px;
}

.chip-title {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    padding: 0;
    overflow: hidden;
}

/* Pushed right, so the letters and dots line up whether or not the name shows. */
.chip-pips {
    flex-direction: row;
    margin-left: auto;
}

.chip-cost {
    min-width: 34px;
    margin-left: 6px;
    font-size: 11px;
    color: var(--wasp);
    -unity-text-align: middle-right;
    padding: 0;
}

.chip-cost--free {
    color: var(--caption);
}

.chip-cost--none {
    color: var(--caption);
}

.pip {
    width: 15px;
    height: 15px;
    margin-left: 2px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--key-text);
    -unity-text-align: middle-center;
    padding: 0;
}

/* A note not found yet: a small dot. The first one is tinted with the category colour in code. Every pip also has the
   pip class, and with equal weight the later rule wins, so this one must come after .pip. The dot is centred among the
   taller letter pips. */
.pip--unknown {
    width: 7px;
    height: 7px;
    margin-left: 5px;
    margin-right: 4px;
    margin-top: 0;
    border-radius: 4px;
    align-self: center;
    background-color: rgba(255, 255, 255, 0.25);
}

.chip-cooldown {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
}

/* Controller symbols (ControlSymbols.cs). A face button is a diamond of four dots with the pressed position filled; in a
   prompt the filled dot takes the note's colour from the hole classes below, which come later and so win. A prompt with
   symbols lays its words and diamonds out in a row inside its own label. */
.pad-prompt {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.pad-part {
    padding: 0;
    margin: 0 2px;
}

.pad-diamond {
    width: 12px;
    height: 12px;
    margin: 0 2px;
    flex-shrink: 0;
}

.pad-dot {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.3);
}

.pad-dot--west { left: 0; top: 33.3%; }
.pad-dot--south { left: 33.3%; top: 66.6%; }
.pad-dot--east { left: 66.6%; top: 33.3%; }
.pad-dot--north { left: 33.3%; top: 0; }

.pad-dot--on {
    background-color: var(--text);
}

/* Inside a recent note or a songbook pip, which already wear the note's colour: centred, in the letters' dark colour. */
.pad-diamond--cell {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin: 0;
}

.pad-diamond--cell .pad-dot {
    background-color: rgba(0, 0, 0, 0.25);
}

.pad-diamond--cell .pad-dot--on {
    background-color: var(--key-text);
}

.giant-line .pad-diamond {
    width: 18px;
    height: 18px;
}

.giant-line .pad-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
}

.giant-line--small .pad-diamond {
    width: 15px;
    height: 15px;
}

.giant-line--small .pad-dot {
    width: 5px;
    height: 5px;
    border-radius: 2.5px;
}

/* The six holes, in the order of the flute */
.hole-0 { background-color: rgb(240, 120, 110); }
.hole-1 { background-color: rgb(240, 170, 90); }
.hole-2 { background-color: rgb(240, 220, 100); }
.hole-3 { background-color: rgb(130, 210, 120); }
.hole-4 { background-color: rgb(110, 180, 240); }
.hole-5 { background-color: rgb(190, 140, 240); }

/* Arrows to hives under attack, off screen */
.offscreen-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hive-arrow {
    position: absolute;
    width: 40px;
    height: 40px;
    translate: -50% -50%;
    background-color: var(--alarm);
    border-radius: 20px;
    color: white;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    display: none;
}

.hive-arrow--shown {
    display: flex;
}

/* End screen */
.end-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--overlay);
    align-items: center;
    justify-content: center;
    display: none;
}

.end-screen--shown {
    display: flex;
}

.end-card {
    align-items: center;
    padding: 24px 40px;
    background-color: var(--panel);
    border-radius: 12px;
    border-width: 3px;
    border-color: var(--gold);
}

.end-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--gold);
    padding: 0;
}

.end-screen--lost .end-card {
    border-color: var(--danger);
}

.end-screen--lost .end-title {
    color: var(--danger);
}

.end-hint {
    font-size: 16px;
    color: var(--caption);
    margin-top: 12px;
    padding: 0;
}

/* Swarm level and nests. Quiet: small text beside the wasp count and under the Fury bar. */
.level-label {
    color: var(--nest);
    font-size: 11px;
    -unity-font-style: bold;
    padding: 0;
    margin-left: 8px;
}

.nest-count {
    align-self: flex-start;
    margin-bottom: 4px;
    color: var(--nest);
    font-size: 11px;
    background-color: var(--panel);
    border-radius: 6px;
    padding: 1px 8px;
}

.top-center .level-line {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--nest);
    margin-top: 2px;
}

.hum-line {
    color: var(--nest);
    -unity-font-style: bold;
}

/* A nest's combo (NestComboView.cs, plan section U): large, near the top centre, while the core stands in an open nest's
   ring. Each slot wears its note's colour from the hole classes, dim until played; a played slot is bright and ringed.
   The pop, the shake and the burst are driven from code, on scale, translate and opacity. */
.combo-box {
    position: absolute;
    top: 92px;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}

.combo--shown {
    display: flex;
}

.combo-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--nest);
    background-color: var(--panel);
    border-radius: 6px;
    padding: 1px 10px;
    margin-bottom: 6px;
}

.combo-slots {
    flex-direction: row;
    justify-content: center;
    padding: 6px 8px;
    border-radius: 12px;
    background-color: var(--panel);
}

.combo-slot {
    width: 44px;
    height: 44px;
    margin: 0 5px;
    border-radius: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--key-text);
    -unity-text-align: middle-center;
    padding: 0;
    opacity: 0.38;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

.combo-slot--filled {
    opacity: 1;
    border-color: var(--text);
}

.combo-slot--hidden {
    display: none;
}

.combo-slots .pad-diamond--cell {
    width: 24px;
    height: 24px;
}

.combo-slots .pad-diamond--cell .pad-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

/* Arrows to open nests, off screen. Smaller and quieter than the hive alarm arrows. */
.nest-arrow {
    position: absolute;
    width: 26px;
    height: 26px;
    translate: -50% -50%;
    background-color: var(--nest);
    border-radius: 13px;
    color: var(--key-text);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    display: none;
}

.nest-arrow--shown {
    display: flex;
}

/* The swarm is gone and on its way back, and a hive is under attack. */
.swarm-line {
    -unity-font-style: bold;
    font-size: 16px;
    color: rgb(255, 214, 120);
}

.dome-line {
    -unity-font-style: bold;
    color: rgb(150, 200, 255);
}

/* Numbers that rise from each hit. Placed by script from world to panel coordinates; never block the pointer. */
.damage-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.dmg {
    position: absolute;
    translate: -50% -100%;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
}

.dmg--hit {
    font-size: 16px;
    color: rgb(255, 255, 255);
}

.dmg--kill {
    font-size: 26px;
    color: rgb(255, 176, 60);
}

.dmg--blocked {
    font-size: 15px;
    color: rgb(110, 175, 255);
}

/* Plan section Y: a kill chain's milestone (x3, x6, x10) stamps high in the middle, lands from a larger scale and fades. */
.chain-stamp {
    position: absolute;
    left: 50%;
    top: 20%;
    translate: -50% -50%;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 205, 70);
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.9);
    white-space: nowrap;
}

/* The giant's hint: one line of its moves, one of its two hand launches and, the first times, a smaller line of its phrases.
   Near the top, in the night sky above the chase camera's giant, so it never covers its head. It fades out on its own after a
   few seconds. */
.giant-hint {
    position: absolute;
    left: 0;
    right: 0;
    top: 11%;
    align-items: center;
}

.giant-line {
    opacity: 0;
    -unity-font-style: bold;
    font-size: 20px;
    padding: 3px 14px;
    margin-bottom: 4px;
    border-radius: 6px;
    background-color: var(--panel);
    color: var(--fury-glow);
    transition-property: opacity;
    transition-duration: 0.8s;
}

.giant-line--small {
    font-size: 14px;
    color: var(--text);
}

.giant-line--hands {
    font-size: 16px;
    color: var(--text);
}

/* While the giant stands, the lines at the bottom (the "New song" toast among them) move to the bottom left corner, clear
   of the chase view's giant (songs-v2 R). */
.bottom--giant {
    left: 16px;
    right: auto;
    bottom: 16px;
    align-items: flex-start;
}

.giant-line--shown {
    opacity: 1;
}

/* The giant strip: a ring of the seconds left and the cooldown marks of the slam, the roar and the two hands. Shown only
   while the giant stands, in the bottom right corner, where the songbook stands aside for it, so it never covers the giant's
   legs in the chase view (songs-v2 R). */
.giant-strip {
    display: none;
    position: absolute;
    right: 16px;
    bottom: 16px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.giant-strip--shown {
    display: flex;
}

.giant-ring {
    width: 58px;
    height: 58px;
    justify-content: center;
    align-items: center;
}

.giant-seconds {
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--fury-glow);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.giant-marks {
    margin-left: 10px;
    padding: 4px 8px;
    border-radius: 6px;
    background-color: var(--panel);
}

.giant-mark-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.giant-mark-label {
    width: 58px;
    font-size: 12px;
    color: var(--caption);
    margin: 0 4px 0 0;
    padding: 0;
}

.giant-mark {
    width: 40px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--track);
    overflow: hidden;
}

.giant-mark-fill {
    width: 0;
    height: 100%;
    background-color: var(--caption);
}

.giant-mark--ready {
    background-color: var(--fury-glow);
}

/* No song can be cast while the giant stands, so the songbook steps aside and leaves the chase view clear. */
.songbook--hidden {
    display: none;
}
