/* The hive defense HUD. Colours match the existing HUD (HudConfig). */
.hud-root {
    --text: rgb(243, 234, 214);
    --caption: rgb(170, 167, 187);
    --panel: rgba(18, 20, 34, 0.55);
    --track: rgba(255, 255, 255, 0.12);
    --gold: rgb(232, 197, 71);
    --wasp: rgb(242, 181, 68);
    --danger: rgb(224, 72, 60);
    --alarm: rgb(255, 150, 40);
    --fury: rgb(176, 92, 230);
    --fury-glow: rgb(255, 214, 90);
    --overlay: rgba(9, 10, 20, 0.74);
    --key-text: rgb(35, 28, 12);

    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
    font-size: 13px;
}

.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.panel {
    background-color: var(--panel);
    border-radius: 6px;
    padding: 3px 8px;
    margin-bottom: 4px;
    min-width: 150px;
}

.panel-title {
    color: var(--caption);
    font-size: 11px;
    padding: 0;
    margin-right: 8px;
}

.bar-track {
    height: 6px;
    margin-top: 2px;
    background-color: var(--track);
    border-radius: 3px;
    overflow: hidden;
}

.bar-fill {
    width: 0;
    height: 100%;
    border-radius: 3px;
}

/* Top left: wasps and Fury */
.top-left {
    position: absolute;
    left: 12px;
    top: 12px;
}

.wasp-count {
    color: var(--text);
    font-size: 13px;
    -unity-font-style: bold;
    padding: 0;
}

.wasp-count--low {
    color: var(--alarm);
}

.wasp-fill {
    background-color: var(--wasp);
}

.wasp-fill--low {
    background-color: var(--alarm);
}

.fury-keys {
    color: var(--caption);
    font-size: 11px;
    padding: 0;
}

.fury-fill {
    background-color: var(--fury);
}

.fury-panel--full {
    border-width: 2px;
    border-color: var(--fury-glow);
    background-color: rgba(70, 30, 100, 0.9);
}

.fury-panel--full .fury-fill {
    background-color: var(--fury-glow);
}

.fury-panel--full .fury-keys {
    color: var(--fury-glow);
    -unity-font-style: bold;
}

/* Top centre: waves */
.top-center {
    position: absolute;
    top: 12px;
    left: 0;
    right: 0;
    align-items: center;
}

.wave-label {
    font-size: 18px;
    -unity-font-style: bold;
    background-color: var(--panel);
    border-radius: 6px;
    padding: 2px 12px;
}

/* On its own backing, because bare caption text is unreadable over the bright grass. */
.next-wave-label {
    font-size: 14px;
    color: var(--text);
    background-color: var(--panel);
    border-radius: 6px;
    margin-top: 4px;
    padding: 2px 10px;
}

/* Hives, down the left side */
.hives {
    position: absolute;
    left: 12px;
    top: 92px;
}

.hive-panel {
    min-width: 120px;
    background-color: var(--panel);
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    padding: 2px 8px;
    margin-bottom: 4px;
}

.hive-title {
    color: var(--text);
    font-size: 11px;
    padding: 0;
}

.hive-fill {
    background-color: var(--gold);
}

.hive-panel--flash {
    border-color: var(--alarm);
    background-color: rgba(130, 70, 10, 0.85);
}

.hive-panel--flash .hive-fill {
    background-color: var(--alarm);
}

.hive-panel--destroyed {
    opacity: 0.4;
}

/* Bottom: recent notes */
.bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    align-items: center;
}

.notes {
    flex-direction: row;
    justify-content: center;
    height: 26px;
    margin-bottom: 4px;
}

.note {
    width: 22px;
    height: 22px;
    margin: 0 3px;
    border-radius: 11px;
    font-size: 12px;
    color: var(--key-text);
    -unity-text-align: middle-center;
    padding: 0;
    display: none;
}

.note--shown {
    display: flex;
}

/* Lines above the notes: the first prompt and discoveries. Hidden until shown. */
.line {
    display: none;
    font-size: 13px;
    padding: 1px 10px;
    margin-bottom: 3px;
    border-radius: 6px;
    background-color: var(--panel);
}

.line--shown {
    display: flex;
}

.prompt-line {
    color: var(--caption);
}

.message-line {
    -unity-font-style: bold;
}

.note--hint {
    border-width: 2px;
    border-color: var(--fury-glow);
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin: 0 1px;
}

/* The songbook, bottom left. Quiet: no panel and partly see-through, but its notes stay readable. */
.songbook {
    position: absolute;
    left: 12px;
    bottom: 10px;
    opacity: 0.75;
}

.songbook-title {
    color: var(--caption);
    font-size: 11px;
    padding: 0;
    margin-bottom: 2px;
}

.songbook-chips {
    width: 196px;
}

.chip {
    flex-direction: row;
    align-items: center;
    height: 22px;
    margin-bottom: 2px;
    padding: 0 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    background-color: rgba(255, 255, 255, 0.04);
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: 0.25s, 0.05s;
}

.chip-mark,
.chip-title,
.chip-pips {
    display: none;
}

.chip--known {
    border-color: rgba(255, 255, 255, 0.22);
    background-color: var(--panel);
}

.chip--known .chip-mark,
.chip--known .chip-title,
.chip--known .chip-pips {
    display: flex;
}

.chip--known.chip--resting {
    opacity: 0.7;
}

/* The songbook's own opacity caps brightness, so the flash lifts the backing and the border. */
.chip--bright {
    border-color: var(--text);
    background-color: rgba(255, 255, 255, 0.30);
}

.chip--nudge {
    translate: 3px 0;
    border-color: var(--text);
}

/* Category marks, so colour is never the only cue: diamond attack, circle defense, square power. */
.chip-mark {
    width: 8px;
    height: 8px;
    margin-right: 6px;
}

.chip-mark--attack {
    rotate: 45deg;
    width: 7px;
    height: 7px;
}

.chip-mark--defense {
    border-radius: 4px;
}

.chip-mark--power {
    border-radius: 1px;
}

.chip-title {
    flex-grow: 1;
    font-size: 12px;
    padding: 0;
}

.chip-pips {
    flex-direction: row;
}

.pip {
    width: 15px;
    height: 15px;
    margin-left: 2px;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--key-text);
    -unity-text-align: middle-center;
    padding: 0;
}

.chip-cooldown {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
}

/* The six holes, in the order of the flute */
.hole-0 { background-color: rgb(240, 120, 110); }
.hole-1 { background-color: rgb(240, 170, 90); }
.hole-2 { background-color: rgb(240, 220, 100); }
.hole-3 { background-color: rgb(130, 210, 120); }
.hole-4 { background-color: rgb(110, 180, 240); }
.hole-5 { background-color: rgb(190, 140, 240); }

/* Arrows to hives under attack, off screen */
.offscreen-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hive-arrow {
    position: absolute;
    width: 40px;
    height: 40px;
    translate: -50% -50%;
    background-color: var(--alarm);
    border-radius: 20px;
    color: white;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    display: none;
}

.hive-arrow--shown {
    display: flex;
}

/* End screen */
.end-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--overlay);
    align-items: center;
    justify-content: center;
    display: none;
}

.end-screen--shown {
    display: flex;
}

.end-card {
    align-items: center;
    padding: 24px 40px;
    background-color: var(--panel);
    border-radius: 12px;
    border-width: 3px;
    border-color: var(--gold);
}

.end-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--gold);
    padding: 0;
}

.end-screen--lost .end-card {
    border-color: var(--danger);
}

.end-screen--lost .end-title {
    color: var(--danger);
}

.end-hint {
    font-size: 16px;
    color: var(--caption);
    margin-top: 12px;
    padding: 0;
}
