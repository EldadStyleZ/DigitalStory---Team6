<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/F010/HiveDefenseHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="top-left" class="top-left" picking-mode="Ignore">
            <ui:VisualElement name="wasp-panel" class="panel" picking-mode="Ignore">
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="Wasps" class="panel-title" />
                    <ui:Label name="wasp-count" text="0 / 0" class="wasp-count" />
                    <ui:Label name="level-label" text="Lv 1" class="level-label" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="bar-track" picking-mode="Ignore">
                    <ui:VisualElement name="wasp-fill" class="bar-fill wasp-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="fury-panel" class="panel fury-panel" picking-mode="Ignore">
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="Fury" class="panel-title" />
                    <ui:Label name="fury-keys" text="" class="fury-keys" />
                </ui:VisualElement>
                <ui:VisualElement class="bar-track" picking-mode="Ignore">
                    <ui:VisualElement name="fury-fill" class="bar-fill fury-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="nest-count" text="Nests 0/0" class="nest-count" picking-mode="Ignore" />
            <ui:VisualElement name="hives" class="hives" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="top-center" class="top-center" picking-mode="Ignore">
            <ui:Label name="phase-label" text="" class="phase-label" picking-mode="Ignore" />
            <ui:Label name="phase-hint" text="" class="phase-hint line" picking-mode="Ignore" />
            <ui:Label name="banner-line" text="" class="banner-line line" picking-mode="Ignore" />
            <ui:Label name="granted-line" text="" class="granted-line line" picking-mode="Ignore" />
            <ui:Label name="swarm-line" text="" class="swarm-line line" picking-mode="Ignore" />
            <ui:Label name="dome-line" text="" class="dome-line line" picking-mode="Ignore" />
            <ui:Label name="level-line" text="" class="level-line line" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom" class="bottom" picking-mode="Ignore">
            <ui:Label name="hum-line" text="" class="line hum-line" picking-mode="Ignore" />
            <ui:VisualElement name="collect-box" class="collect-box" picking-mode="Ignore">
                <ui:Label text="Collecting" class="collect-label" picking-mode="Ignore" />
                <ui:VisualElement class="bar-track collect-track" picking-mode="Ignore">
                    <ui:VisualElement name="collect-fill" class="bar-fill collect-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="message-line" text="" class="line message-line" picking-mode="Ignore" />
            <ui:Label name="prompt-line" text="" class="line prompt-line" picking-mode="Ignore" />
            <ui:VisualElement name="notes" class="notes" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="giant-hint" class="giant-hint" picking-mode="Ignore">
            <ui:Label name="giant-moves-line" text="" class="giant-line" picking-mode="Ignore" />
            <ui:Label name="giant-hands-line" text="" class="giant-line giant-line--hands" picking-mode="Ignore" />
            <ui:Label name="giant-phrases-line" text="" class="giant-line giant-line--small" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="giant-strip" class="giant-strip" picking-mode="Ignore">
            <ui:VisualElement name="giant-ring" class="giant-ring" picking-mode="Ignore">
                <ui:Label name="giant-seconds" text="0" class="giant-seconds" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="giant-marks" picking-mode="Ignore">
                <ui:VisualElement class="giant-mark-row" picking-mode="Ignore">
                    <ui:Label text="L slam" class="giant-mark-label" picking-mode="Ignore" />
                    <ui:VisualElement class="giant-mark" picking-mode="Ignore">
                        <ui:VisualElement name="giant-slam-fill" class="giant-mark-fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="giant-mark-row" picking-mode="Ignore">
                    <ui:Label text="H roar" class="giant-mark-label" picking-mode="Ignore" />
                    <ui:VisualElement class="giant-mark" picking-mode="Ignore">
                        <ui:VisualElement name="giant-roar-fill" class="giant-mark-fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="giant-mark-row" picking-mode="Ignore">
                    <ui:Label name="giant-left-label" text="LMB fist" class="giant-mark-label" picking-mode="Ignore" />
                    <ui:VisualElement class="giant-mark" picking-mode="Ignore">
                        <ui:VisualElement name="giant-left-fill" class="giant-mark-fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="giant-mark-row" picking-mode="Ignore">
                    <ui:Label name="giant-right-label" text="RMB fist" class="giant-mark-label" picking-mode="Ignore" />
                    <ui:VisualElement class="giant-mark" picking-mode="Ignore">
                        <ui:VisualElement name="giant-right-fill" class="giant-mark-fill" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="songbook" class="songbook" picking-mode="Ignore">
            <ui:Label name="songbook-title" text="Songs 0/0" class="songbook-title" picking-mode="Ignore" />
            <ui:VisualElement name="songbook-chips" class="songbook-chips" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="offscreen-layer" class="offscreen-layer" picking-mode="Ignore" />
        <ui:VisualElement name="end-screen" class="end-screen" picking-mode="Ignore">
            <ui:VisualElement class="end-card" picking-mode="Ignore">
                <ui:Label name="end-title" text="" class="end-title" />
                <ui:Label name="end-hint" text="" class="end-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
