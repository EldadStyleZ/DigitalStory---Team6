// Moves every wasp of the swarm, one thread per wasp. Spec: docs/specs/F-010-wasp-swarm.md, sections 9.2 to 9.4.
// SwarmGpuView sets every uniform and buffer below by name, so keep the names and layouts in step with it.
// The CPU never reads this data back. Gameplay only feeds in counts, the form and a few positions.

#pragma kernel Simulate
#pragma kernel ResetWasps

// Matches SwarmGpuView.ThreadsPerGroup.
#define THREAD_GROUP_SIZE 64

// 48 bytes, the same layout as SwarmGpuView.WaspStatic and the struct in WaspInstanced.shader. Written once by the CPU.
struct WaspStatic
{
    float seed;          // 0..1: picks the stingers and phases the wings
    float lane;          // 0..1: place along the river (0 at the Piper) and order in a form wave
    float ringAngle;     // radians: place around the river's cross-section
    float ringRadius;    // 0..1: share of the river radius
    float3 boneOffset;   // the wasp's point on the Colossus, in its bone's space
    float boneIndex;     // the Colossus bone, as a whole number
    float height01;      // 0 at the Colossus's feet, 1 at its head: order of the Colossus wave
    float level01;       // 0..1: height in the tornado and latitude on the sting orbit
    float phase01;       // 0..1: spreads timings and directions
    float unused;        // pads the struct to 48 bytes
};

// 48 bytes, the same layout as the struct in WaspInstanced.shader. Only this shader writes it.
struct WaspDynamic
{
    float3 position;
    float state;         // StateAlive, StateDying or StateDead
    float3 velocity;
    float stateTime;     // seconds in the current state
    float4 tint;         // rgb colour, a glow
};

StructuredBuffer<WaspStatic> _Static;
RWStructuredBuffer<WaspDynamic> _Dynamic;
StructuredBuffer<float4> _Trail;          // newest first: xyz position, w metres from the newest point
StructuredBuffer<float4x4> _Bones;        // the Colossus's bones, local to world

int _MaxWasps;
int _ActiveCount;
int _TrailCount;
int _BoneCount;                           // 0 until the Colossus has bones and samples
int _Form;                                // DigitalStory.Logic.SwarmForm
int _PreviousForm;

float _SimTime;
float _DeltaTime;                         // already capped at SwarmConfig.MaxDeltaTime
float _FormStartTime;
float _PreviousFormStartTime;

float4 _PiperPosition;
float4 _PiperForward;                     // flat and unit length
float _StandingShare;                     // 0 while the Piper walks, easing to 1 once they have stood still a moment
float4 _Sting;                            // xyz target, w share of the swarm that stings
float4 _HiveA;                            // xyz position, w 1 while it stands
float4 _HiveB;
float4 _LastHit;
float4 _Meteor;                           // xyz impact point, w share of the swarm that flies the meteor
float _MeteorRiseSeconds;                 // from the cast to the top of the climb
float _MeteorDiveSeconds;                 // from the top of the climb to the impact
float _MeteorHeight;                      // metres above the Piper the meteor climbs to
float4 _FormColors[9];                    // rgb per form id

// From SwarmConfig.
float _RiverSpring;
float _RiverDamping;
float _ShapeSpring;
float _ShapeDamping;
float _WobbleDamping;
float _WobbleSeconds;
float _FormWaveSeconds;
float _FlowSpeed;
float _RiverLength;
float _RiverRadius;
float _MeanderAmplitude;
float _StandingTrailMeters;
float _TorusRadius;
float _DyingSeconds;

// From the song assets, or 0 to use the defaults below.
float _DomeRadius;
float _TornadoRadius;

static const float FullTurn = 6.28318530718;
static const float HalfTurn = 3.14159265359;
static const float GoldenAngle = 2.39996322973;
static const float3 Up = float3(0.0, 1.0, 0.0);
static const float3 Still = float3(0.0, 0.0, 0.0);
static const float Tiny = 0.0001;

// Wasp states, stored as floats in WaspDynamic.state.
static const int StateAlive = 0;
static const int StateDying = 1;
static const int StateDead = 2;

// Form ids, the same numbers as DigitalStory.Logic.SwarmForm.
static const int FormRiver = 0;
static const int FormDome = 1;
static const int FormSting = 2;
static const int FormTornado = 3;
static const int FormGust = 4;
static const int FormHiveCall = 5;
static const int FormColossus = 6;
static const int FormCollapsed = 7;
static const int FormMeteor = 8;

// Enough halving steps for a trail of 4,096 points.
static const int TrailSearchSteps = 12;

// The look of each form, from spec 9.3. SwarmConfig does not hold these yet; move one there if it needs tuning.
static const float FlyHeight = 1.0;              // metres above the ground the river flows
static const float RiverSwirl = 0.6;             // radians per second the river's cross-section turns
static const float MeanderWaveNumber = 1.4;      // radians per metre along the river, a wave about 4.5 m long
static const float MeanderSpeed = 0.9;           // radians per second
static const float DefaultDomeRadius = 2.2;
static const float DomeSpin = 0.25;              // radians per second
static const float StingFlightSeconds = 0.6;
static const float StingStaggerSeconds = 0.35;
static const float StingArcHeight = 1.2;         // metres the arc rises, plus StingArcRise per metre of distance
static const float StingArcRise = 0.25;
static const float StingTargetHeight = 1.0;      // metres above the target's feet
static const float StingOrbitRadius = 0.8;
static const float StingOrbitSpin = 5.0;         // radians per second
static const float RiverHeadGap = 1.0;           // metres behind the Piper where the river starts, so it never hides them
static const float TornadoInnerRadius = 1.5;
static const float DefaultTornadoRadius = 5.0;
static const float TornadoFunnelBottom = 0.8;    // the column's radius at the bottom and top, as a share
static const float TornadoFunnelTop = 1.25;
static const float TornadoWallShare = 0.75;      // share of the wasps in the column's wall; the rest are flung out
static const float TornadoWallThickness = 0.5;   // metres
static const float TornadoBaseHeight = 0.2;
static const float TornadoHeight = 3.0;
static const float TornadoSpin = 6.0;            // radians per second
static const float TornadoTwist = 3.0;           // radians the spiral turns from bottom to top
static const float GustSeconds = 0.8;
static const float GustStartRadius = 0.6;
static const float GustRadius = 6.0;
static const float HaloRadius = 0.7;
static const float HaloHeight = 2.1;
static const float HaloThickness = 0.15;
static const float HaloSpin = 2.5;               // radians per second
static const float MeteorClimbStagger = 0.3;     // share of the rise over which the climbers set off, lowest seed first
static const float MeteorClimbShare = 0.55;      // share of the rise one wasp's climb takes; the rest is the hang
static const float MeteorGatherShare = 0.5;      // share of its climb a wasp takes to leave the river for the column
static const float MeteorSpreadShare = 0.7;      // from this share of its climb the column opens into the ball
static const float MeteorColumnRadius = 0.35;
static const float MeteorColumnSpin = 4.0;       // radians per second
static const float MeteorBallRadius = 1.6;
static const float MeteorBallSpin = 1.5;         // radians per second
static const float MeteorDiveStagger = 0.15;     // seconds from the first diver to the last, so the dive draws streaks
static const float MeteorDiveEase = 0.5;         // the dive's starting speed as a share of its mean; it ends at 2 minus this
static const float MeteorLandingScatter = 0.8;   // metres from the impact point a wasp lands, at most
static const float MeteorFloorHeight = 0.15;     // metres above the impact point a landed wasp skims
static const float MeteorSkidKeep = 0.35;        // share of its ground speed a wasp keeps when it hits the floor
static const float MeteorRingRadius = 3.0;       // the burst's ring, MeteorSong.Radius by default
static const float MeteorRingInner = 0.7;        // the ring's inner edge, as a share of its radius
static const float MeteorRingHeight = 0.4;
static const float MeteorBurstSeconds = 0.35;    // seconds a wasp flies out to the ring before it heads back to the river
static const float MeteorSpring = 400.0;         // stiff, so a climbing or diving wasp keeps to its path; stable to dt 1/30
static const float MeteorDamping = 0.8;
static const float MeteorMaxSpeed = 70.0;        // metres per second, enough for an 18 m dive from 12 m up in 0.5 s
static const float MaxSpeed = 25.0;              // metres per second, so a far target never fires a wasp across the map.
                                                 // WaspInstanced.shader draws a wasp faster than this as a streak.
static const float SpawnHeight = 1.2;            // metres above a hive's base
static const float SpawnScatter = 0.4;
static const float SpawnLift = 4.0;              // upward metres per second at birth, so newcomers arc in
static const float ResetScatter = 1.5;
static const float BurstSpeed = 4.0;             // metres per second a lost wasp flies from the hit
static const float BurstLift = 0.6;
static const float BurstSpreadMin = 0.6;
static const float BurstSpreadRange = 0.8;
static const float Gravity = 9.81;
static const float FallDrag = 1.5;               // share of speed lost per second while falling
static const float TintSharpness = 6.0;          // how fast a wasp takes on its form's colour, per second
static const float MeteorTintSharpness = 14.0;   // faster, so the meteor's heat follows its short dive
static const float RiverGlow = 0.1;
static const float DomeGlow = 0.35;
static const float StingGlow = 0.9;
static const float TornadoGlow = 0.3;
static const float GustGlow = 0.3;
static const float HiveCallGlow = 0.8;
static const float ColossusGlow = 0.2;
static const float MeteorGlow = 0.55;            // while it waits, climbs and hangs
static const float MeteorDiveGlow = 1.0;         // hottest in the dive
static const float MeteorBurstGlow = 0.75;

int StateOf(WaspDynamic body)
{
    return (int)(body.state + 0.5);
}

// One exit with the result set first, so the compiler sees it initialised on every path.
float GlowOf(int look)
{
    float glow = RiverGlow;
    if (look == FormDome)
    {
        glow = DomeGlow;
    }
    else if (look == FormSting)
    {
        glow = StingGlow;
    }
    else if (look == FormTornado)
    {
        glow = TornadoGlow;
    }
    else if (look == FormGust)
    {
        glow = GustGlow;
    }
    else if (look == FormHiveCall)
    {
        glow = HiveCallGlow;
    }
    else if (look == FormColossus)
    {
        glow = ColossusGlow;
    }
    else if (look == FormMeteor)
    {
        glow = MeteorGlow;
    }

    return glow;
}

float4 TintOf(int look)
{
    return float4(_FormColors[look].rgb, GlowOf(look));
}

float3 RingOffset(float angle, float radius)
{
    return float3(cos(angle) * radius, 0.0, sin(angle) * radius);
}

// The point `distance` metres back along the Piper's trail, and the way the trail runs there (toward the Piper).
// Safe with no trail points (the Piper) and with one (that point).
void SampleTrail(float distance, out float3 position, out float3 direction)
{
    position = _PiperPosition.xyz;
    direction = _PiperForward.xyz;

    if (_TrailCount <= 0)
    {
        return;
    }

    if (_TrailCount == 1)
    {
        position = _Trail[0].xyz;
        return;
    }

    int low = 0;
    int high = _TrailCount - 1;
    float clamped = clamp(distance, 0.0, _Trail[high].w);

    [loop]
    for (int step = 0; step < TrailSearchSteps; step++)
    {
        if (high - low > 1)
        {
            int middle = (low + high) >> 1;
            if (_Trail[middle].w <= clamped)
            {
                low = middle;
            }
            else
            {
                high = middle;
            }
        }
    }

    float4 newer = _Trail[low];
    float4 older = _Trail[high];
    float span = older.w - newer.w;
    float blend = span > Tiny ? saturate((clamped - newer.w) / span) : 0.0;
    position = lerp(newer.xyz, older.xyz, blend);

    float3 along = newer.xyz - older.xyz;
    along.y = 0.0;
    float alongLength = length(along);
    if (alongLength > Tiny)
    {
        direction = along / alongLength;
    }
}

float TrailLength()
{
    return _TrailCount > 0 ? _Trail[_TrailCount - 1].w : 0.0;
}

// While the Piper stands, the river curls into a lazy ring around them.
float3 TorusTarget(WaspStatic wasp, float flowLane)
{
    float around = flowLane * FullTurn;
    float angle = wasp.ringAngle + _SimTime * RiverSwirl;
    float radius = wasp.ringRadius * _RiverRadius;
    float reach = _TorusRadius + cos(angle) * radius;
    float3 lift = Up * (FlyHeight + sin(angle) * radius);
    return _PiperPosition.xyz + RingOffset(around, reach) + lift;
}

float3 RiverTarget(WaspStatic wasp)
{
    float flowLane = frac(wasp.lane + _SimTime * _FlowSpeed);
    float trailLength = TrailLength();
    float along = lerp(RiverHeadGap, max(min(_RiverLength, trailLength), RiverHeadGap), flowLane);

    float3 center;
    float3 direction;
    SampleTrail(along, center, direction);
    float3 side = cross(Up, direction);

    float angle = wasp.ringAngle + _SimTime * RiverSwirl;
    float radius = wasp.ringRadius * _RiverRadius;
    float meander = _MeanderAmplitude * sin(along * MeanderWaveNumber - _SimTime * MeanderSpeed);
    float3 river = center + Up * (FlyHeight + sin(angle) * radius) + side * (cos(angle) * radius + meander);

    // The torus shows while the trail is still too short to hold a river (the start of a run) and while the Piper
    // stands. The trail alone cannot say the second: it keeps its full length after the Piper stops.
    float trailShare = saturate(trailLength / max(_StandingTrailMeters, Tiny));
    float riverShare = trailShare * (1.0 - saturate(_StandingShare));
    return lerp(TorusTarget(wasp, flowLane), river, riverShare);
}

// A Fibonacci hemisphere: every active wasp gets its own evenly spread point.
float3 DomeTarget(uint index)
{
    float count = max((float)_ActiveCount, 1.0);
    float slot = (float)index + 0.5;
    float height = 1.0 - saturate(slot / count);
    float spread = sqrt(saturate(1.0 - height * height));
    float around = slot * GoldenAngle + _SimTime * DomeSpin;
    float radius = _DomeRadius > 0.0 ? _DomeRadius : DefaultDomeRadius;
    return _PiperPosition.xyz + (RingOffset(around, spread) + Up * height) * radius;
}

bool IsStinger(WaspStatic wasp)
{
    return wasp.seed < _Sting.w;
}

float3 Bezier(float3 start, float3 control, float3 end, float progress)
{
    float rest = 1.0 - progress;
    return rest * rest * start + 2.0 * rest * progress * control + progress * progress * end;
}

// Along an arc from the Piper to the target, then round a sphere about it.
float3 StingTarget(WaspStatic wasp, float formSeconds)
{
    float3 start = _PiperPosition.xyz + Up * FlyHeight;
    float3 end = _Sting.xyz + Up * StingTargetHeight;
    float3 control = (start + end) * 0.5 + Up * (StingArcHeight + StingArcRise * distance(start, end));
    float progress = saturate((formSeconds - wasp.phase01 * StingStaggerSeconds) / StingFlightSeconds);
    float3 arc = Bezier(start, control, end, progress);

    float latitude = 1.0 - 2.0 * wasp.level01;
    float spread = sqrt(saturate(1.0 - latitude * latitude));
    float spin = wasp.phase01 < 0.5 ? StingOrbitSpin : -StingOrbitSpin;
    float around = wasp.phase01 * FullTurn + _SimTime * spin;
    float3 orbit = end + (RingOffset(around, spread) + Up * latitude) * StingOrbitRadius;
    return lerp(arc, orbit, smoothstep(0.75, 1.0, progress));
}

// A spinning spiral column, a little wider at the top. Most wasps make its wall at the inner radius, so it reads as a
// column from the game camera; the rest are flung out to the outer radius, the reach of the song's knockback.
float3 TornadoTarget(WaspStatic wasp)
{
    float outer = _TornadoRadius > 0.0 ? _TornadoRadius : DefaultTornadoRadius;
    float funnel = lerp(TornadoFunnelBottom, TornadoFunnelTop, wasp.level01);
    float wall = (TornadoInnerRadius + (wasp.ringRadius - 0.5) * TornadoWallThickness) * funnel;
    float flung = lerp(TornadoInnerRadius, outer, wasp.ringRadius);
    float radius = wasp.phase01 < TornadoWallShare ? wall : flung;
    float around = wasp.ringAngle + wasp.level01 * TornadoTwist + _SimTime * TornadoSpin;
    float height = TornadoBaseHeight + wasp.level01 * TornadoHeight;
    return _PiperPosition.xyz + RingOffset(around, radius) + Up * height;
}

// A ring that bursts out and comes back over GustSeconds.
float3 GustTarget(WaspStatic wasp, float formSeconds)
{
    float burst = saturate(formSeconds / GustSeconds);
    float radius = lerp(GustStartRadius, GustRadius, sin(burst * HalfTurn));
    float lift = FlyHeight + sin(wasp.ringAngle) * wasp.ringRadius * _RiverRadius;
    return _PiperPosition.xyz + RingOffset(wasp.seed * FullTurn, radius) + Up * lift;
}

// A tight halo over the Piper's head.
float3 HaloTarget(WaspStatic wasp)
{
    float around = wasp.seed * FullTurn + _SimTime * HaloSpin;
    float wobble = wasp.ringRadius * HaloThickness;
    float reach = HaloRadius + cos(wasp.ringAngle) * wobble;
    float lift = HaloHeight + sin(wasp.ringAngle) * wobble;
    return _PiperPosition.xyz + RingOffset(around, reach) + Up * lift;
}

int BoneOf(WaspStatic wasp)
{
    return (int)(wasp.boneIndex + 0.5);
}

bool HasColossusPlace(WaspStatic wasp)
{
    int bone = BoneOf(wasp);
    return bone >= 0 && bone < _BoneCount;
}

float3 ColossusTarget(WaspStatic wasp)
{
    return mul(_Bones[BoneOf(wasp)], float4(wasp.boneOffset, 1.0)).xyz;
}

bool IsMeteor(WaspStatic wasp)
{
    return wasp.seed < _Meteor.w;
}

// 0 for the first meteor wasp to climb and to dive, 1 for the last: its seed spread over the share that flies.
float MeteorOrderOf(WaspStatic wasp)
{
    return saturate(wasp.seed / max(_Meteor.w, Tiny));
}

// The meteor's times, in seconds from the cast. Each climb ends by MeteorClimbStagger + MeteorClimbShare of the rise,
// so every wasp hangs a moment in the ball. The first diver lands at the rise plus the dive, with the damage.
float MeteorClimbStart(WaspStatic wasp)
{
    return MeteorOrderOf(wasp) * MeteorClimbStagger * _MeteorRiseSeconds;
}

float MeteorDiveStart(WaspStatic wasp)
{
    return _MeteorRiseSeconds + MeteorOrderOf(wasp) * MeteorDiveStagger;
}

float MeteorLandTime(WaspStatic wasp)
{
    return MeteorDiveStart(wasp) + _MeteorDiveSeconds;
}

float MeteorReturnTime(WaspStatic wasp)
{
    return MeteorLandTime(wasp) + MeteorBurstSeconds;
}

// How far the meteor spring lags a goal moving at one metre per second. Setting the goal that far ahead along a fast
// path lets the wasp keep to the path instead of trailing it.
float MeteorLeadSeconds()
{
    return 2.0 * MeteorDamping / sqrt(MeteorSpring);
}

// A loose ball at the top of the climb, turning slowly.
float3 MeteorBallPoint(WaspStatic wasp)
{
    float latitude = 1.0 - 2.0 * wasp.level01;
    float spread = sqrt(saturate(1.0 - latitude * latitude));
    float around = wasp.phase01 * FullTurn + _SimTime * MeteorBallSpin;
    float3 offset = (RingOffset(around, spread) + Up * latitude) * (wasp.ringRadius * MeteorBallRadius);
    return _PiperPosition.xyz + Up * _MeteorHeight + offset;
}

// Out of the river into a tight column over the Piper, up it, and out into the ball at the top.
float3 MeteorClimbTarget(WaspStatic wasp, float formSeconds)
{
    float climbSeconds = max(MeteorClimbShare * _MeteorRiseSeconds, Tiny);
    float progress = saturate((formSeconds - MeteorClimbStart(wasp)) / climbSeconds);
    float climb = smoothstep(0.0, 1.0, progress);
    float climbRate = 6.0 * progress * (1.0 - progress) / climbSeconds;
    float lead = (_MeteorHeight - FlyHeight) * climbRate * MeteorLeadSeconds();

    float around = wasp.ringAngle + _SimTime * MeteorColumnSpin;
    float height = lerp(FlyHeight, _MeteorHeight, climb) + lead;
    float3 column = _PiperPosition.xyz + RingOffset(around, wasp.ringRadius * MeteorColumnRadius) + Up * height;
    float3 lifted = lerp(RiverTarget(wasp), column, smoothstep(0.0, MeteorGatherShare, progress));
    return lerp(lifted, MeteorBallPoint(wasp), smoothstep(MeteorSpreadShare, 1.0, progress));
}

// Where a meteor wasp lands, within MeteorLandingScatter of the impact point.
float3 MeteorLandingPoint(WaspStatic wasp)
{
    float reach = sqrt(wasp.level01) * MeteorLandingScatter;
    return _Meteor.xyz + RingOffset(wasp.phase01 * FullTurn, reach) + Up * MeteorFloorHeight;
}

// A steep line from the ball to the wasp's landing point, faster as it falls. The divers set off one after another,
// so the ball stretches into streaks.
float3 MeteorDiveTarget(WaspStatic wasp, float formSeconds)
{
    float diveSeconds = max(_MeteorDiveSeconds, Tiny);
    float progress = saturate((formSeconds - MeteorDiveStart(wasp)) / diveSeconds);
    float travelled = progress * (MeteorDiveEase + (1.0 - MeteorDiveEase) * progress);
    float rate = (MeteorDiveEase + 2.0 * (1.0 - MeteorDiveEase) * progress) / diveSeconds;

    float3 start = MeteorBallPoint(wasp);
    float3 path = MeteorLandingPoint(wasp) - start;
    return start + path * (travelled + rate * MeteorLeadSeconds());
}

// After it lands, each wasp bursts straight out from its landing point to a ring around the impact, low over the ground.
float3 MeteorBurstTarget(WaspStatic wasp)
{
    float reach = lerp(MeteorRingInner, 1.0, wasp.ringRadius) * MeteorRingRadius;
    return _Meteor.xyz + RingOffset(wasp.phase01 * FullTurn, reach) + Up * MeteorRingHeight;
}

// Waits in the river for its turn, climbs, hangs in the ball, dives and bursts out. The river spring holds it while it
// waits; the stiff meteor spring flies the climb, the hang and the dive (isFast); the shape spring flies the burst.
float3 MeteorTarget(WaspStatic wasp, float formSeconds, out bool isShape, out bool isFast)
{
    isShape = formSeconds >= MeteorClimbStart(wasp);
    isFast = isShape && formSeconds < MeteorLandTime(wasp);
    float3 goal = MeteorBurstTarget(wasp);

    if (!isShape)
    {
        goal = RiverTarget(wasp);
    }
    else if (formSeconds < MeteorDiveStart(wasp))
    {
        goal = MeteorClimbTarget(wasp, formSeconds);
    }
    else if (formSeconds < MeteorLandTime(wasp))
    {
        goal = MeteorDiveTarget(wasp, formSeconds);
    }

    return goal;
}

// Warm while it waits, climbs and hangs, hottest in the dive, cooler as it bursts out.
float MeteorGlowOf(WaspStatic wasp, float formSeconds)
{
    float glow = MeteorGlow;
    if (formSeconds >= MeteorLandTime(wasp))
    {
        glow = MeteorBurstGlow;
    }
    else if (formSeconds >= MeteorDiveStart(wasp))
    {
        glow = MeteorDiveGlow;
    }

    return glow;
}

// Where a wasp wants to be in a form, which colour it shows, whether the stiff shape spring holds it and whether it
// flies a fast meteor path (isFast). Every case that does not apply (the non-stingers, a finished gust, a Colossus
// without bones, Collapsed, a meteor wasp back from its burst and the wasps that stay out of it) is the river.
float3 GoalOf(int form, float formSeconds, uint index, WaspStatic wasp, out int look, out bool isShape, out bool isFast)
{
    look = form;
    isShape = true;
    isFast = false;
    float3 goal = _PiperPosition.xyz;

    if (form == FormDome)
    {
        goal = DomeTarget(index);
    }
    else if (form == FormSting && IsStinger(wasp))
    {
        goal = StingTarget(wasp, formSeconds);
    }
    else if (form == FormTornado)
    {
        goal = TornadoTarget(wasp);
    }
    else if (form == FormGust && formSeconds < GustSeconds)
    {
        goal = GustTarget(wasp, formSeconds);
    }
    else if (form == FormHiveCall)
    {
        goal = HaloTarget(wasp);
    }
    else if (form == FormColossus && HasColossusPlace(wasp))
    {
        goal = ColossusTarget(wasp);
    }
    else if (form == FormMeteor && IsMeteor(wasp) && formSeconds < MeteorReturnTime(wasp))
    {
        goal = MeteorTarget(wasp, formSeconds, isShape, isFast);
    }
    else
    {
        look = FormRiver;
        isShape = false;
        goal = RiverTarget(wasp);
    }

    return goal;
}

// True in the one frame a wasp's river lane wraps from the tail (1) back to the Piper (0).
bool HasLaneWrapped(WaspStatic wasp)
{
    float now = wasp.lane + _SimTime * _FlowSpeed;
    float before = now - _DeltaTime * _FlowSpeed;
    return floor(now) != floor(before);
}

// The Colossus builds from the feet up. The meteor starts in every wasp at once, so its timing runs from the cast and
// its first diver lands with the damage; the meteor wasps stagger themselves. Every other form sweeps along the river.
float WaveOrderOf(int form, WaspStatic wasp)
{
    float order = wasp.lane;
    if (form == FormColossus)
    {
        order = wasp.height01;
    }
    else if (form == FormMeteor)
    {
        order = 0.0;
    }

    return order;
}

float3 LimitSpeed(float3 velocity, float maxSpeed)
{
    float speed = length(velocity);
    return speed > maxSpeed ? velocity * (maxSpeed / speed) : velocity;
}

// A diving meteor wasp that reaches the ground skims along it instead of going through, and loses most of its speed.
void Skim(inout WaspDynamic body)
{
    float ground = _Meteor.y + MeteorFloorHeight;
    if (body.position.y < ground)
    {
        body.position.y = ground;
        body.velocity.y = max(body.velocity.y, 0.0);
        body.velocity.xz *= MeteorSkidKeep;
    }
}

// The spring of spec 9.4, stepped with semi-implicit Euler. Each wasp takes up a new form at
// formStartTime + order x FormWaveSeconds, so a change sweeps along the river (or up the Colossus).
void Fly(uint index, WaspStatic wasp, inout WaspDynamic body)
{
    float switchTime = _FormStartTime + WaveOrderOf(_Form, wasp) * _FormWaveSeconds;
    bool hasSwitched = _SimTime >= switchTime;
    float previousSwitchTime = _PreviousFormStartTime + WaveOrderOf(_PreviousForm, wasp) * _FormWaveSeconds;
    int form = hasSwitched ? _Form : _PreviousForm;
    float formSeconds = max(_SimTime - (hasSwitched ? switchTime : previousSwitchTime), 0.0);

    int look;
    bool isShape;
    bool isFast;
    float3 goal = GoalOf(form, formSeconds, index, wasp, look, isShape, isFast);

    // A wasp that leaves the river's tail starts again at its head. Flying there would draw a straight, sparse
    // second river across every curve of the path, so it jumps instead; in the crowd at the head nobody sees it.
    if (!isShape && HasLaneWrapped(wasp))
    {
        body.position = goal;
        body.velocity = Still;
    }

    float stiffness = isShape ? _ShapeSpring : _RiverSpring;
    float damping = isShape ? _ShapeDamping : _RiverDamping;
    float maxSpeed = MaxSpeed;
    if (hasSwitched && formSeconds < _WobbleSeconds)
    {
        damping = _WobbleDamping;
    }

    // On the usual springs and speed cap a climbing or diving meteor would trail metres behind its path and land late.
    if (isFast)
    {
        stiffness = MeteorSpring;
        damping = MeteorDamping;
        maxSpeed = MeteorMaxSpeed;
    }

    float3 acceleration = stiffness * (goal - body.position) - 2.0 * damping * sqrt(stiffness) * body.velocity;
    body.velocity = LimitSpeed(body.velocity + acceleration * _DeltaTime, maxSpeed);
    body.position += body.velocity * _DeltaTime;
    if (look == FormMeteor && formSeconds >= MeteorDiveStart(wasp))
    {
        Skim(body);
    }

    body.stateTime += _DeltaTime;

    float4 tint = TintOf(look);
    float tintSharpness = TintSharpness;
    if (look == FormMeteor)
    {
        tint.a = MeteorGlowOf(wasp, formSeconds);
        tintSharpness = MeteorTintSharpness;
    }

    body.tint = lerp(body.tint, tint, saturate(_DeltaTime * tintSharpness));
}

float DistanceOnGround(float3 from, float3 to)
{
    float2 offset = from.xz - to.xz;
    return length(offset);
}

// Where a revived wasp appears: the nearest standing hive to the Piper, or the Piper when none stands.
// During Hive Call with both hives standing, half come from each, so streams fly in from every hive.
float3 SpawnPoint(WaspStatic wasp)
{
    bool firstStands = _HiveA.w > 0.5;
    bool secondStands = _HiveB.w > 0.5;
    float3 spawn = _PiperPosition.xyz + Up * FlyHeight;

    if (firstStands || secondStands)
    {
        float3 hive = firstStands ? _HiveA.xyz : _HiveB.xyz;
        if (firstStands && secondStands)
        {
            bool isFirstNearer = DistanceOnGround(_HiveA.xyz, _PiperPosition.xyz) <= DistanceOnGround(_HiveB.xyz, _PiperPosition.xyz);
            bool takesFirst = _Form == FormHiveCall ? wasp.seed < 0.5 : isFirstNearer;
            hive = takesFirst ? _HiveA.xyz : _HiveB.xyz;
        }

        spawn = hive + Up * SpawnHeight;
    }

    return spawn;
}

float3 Scatter(WaspStatic wasp, float size)
{
    return (float3(wasp.phase01, wasp.level01, wasp.seed) - 0.5) * (2.0 * size);
}

void Revive(WaspStatic wasp, inout WaspDynamic body)
{
    body.position = SpawnPoint(wasp) + Scatter(wasp, SpawnScatter);
    body.velocity = Up * SpawnLift;
    body.state = (float)StateAlive;
    body.stateTime = 0.0;
}

// A lost wasp bursts away from the last hit, then falls.
void StartDying(WaspStatic wasp, inout WaspDynamic body)
{
    float3 away = body.position - _LastHit.xyz;
    float awayLength = length(away);
    float3 direction = awayLength > Tiny ? away / awayLength : RingOffset(wasp.phase01 * FullTurn, 1.0);
    direction = normalize(direction + Up * BurstLift);
    body.velocity = direction * (BurstSpeed * (BurstSpreadMin + BurstSpreadRange * wasp.level01));
    body.state = (float)StateDying;
    body.stateTime = 0.0;
}

void Fall(inout WaspDynamic body)
{
    body.velocity.y -= Gravity * _DeltaTime;
    body.velocity *= saturate(1.0 - FallDrag * _DeltaTime);
    body.position += body.velocity * _DeltaTime;

    float ground = _PiperPosition.y;
    if (body.position.y < ground)
    {
        body.position.y = ground;
        body.velocity = Still;
    }

    body.stateTime += _DeltaTime;
    if (body.stateTime >= _DyingSeconds)
    {
        body.state = (float)StateDead;
        body.stateTime = 0.0;
        body.velocity = Still;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_MaxWasps)
    {
        return;
    }

    WaspStatic wasp = _Static[index];
    WaspDynamic body = _Dynamic[index];
    bool isActive = index < (uint)max(_ActiveCount, 0);
    int state = StateOf(body);

    if (state == StateDead && isActive)
    {
        Revive(wasp, body);
        state = StateAlive;
    }
    else if (state == StateAlive && !isActive)
    {
        StartDying(wasp, body);
        state = StateDying;
    }

    if (state == StateAlive)
    {
        Fly(index, wasp, body);
    }
    else if (state == StateDying)
    {
        Fall(body);
    }

    _Dynamic[index] = body;
}

// Fills the dynamic buffer the first time: the active wasps in a loose cloud about the Piper, the rest dead.
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResetWasps(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_MaxWasps)
    {
        return;
    }

    WaspStatic wasp = _Static[index];
    bool isActive = index < (uint)max(_ActiveCount, 0);

    WaspDynamic body;
    body.position = _PiperPosition.xyz + Up * FlyHeight + Scatter(wasp, ResetScatter);
    body.state = isActive ? (float)StateAlive : (float)StateDead;
    body.velocity = Still;
    body.stateTime = 0.0;
    body.tint = TintOf(FormRiver);
    _Dynamic[index] = body;
}
