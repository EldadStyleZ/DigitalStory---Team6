// Moves every wasp of the swarm, one thread per wasp. Spec: docs/specs/F-010-wasp-swarm.md, sections 9.2 to 9.4, and
// docs/specs/F-010-songs-v2.md, sections B and C (the song slots).
// SwarmGpuView sets every uniform and buffer below by name, so keep the names and layouts in step with it.
// The CPU never reads this data back. Gameplay only feeds in counts, the forms, the slots and a few positions.
//
// Two layers decide where a wasp flies:
// - The whole-swarm form (_Form): River, Hive Call, Colossus or Collapsed. It sweeps through the swarm as a wave.
// - Three song slots (Post, Guard, Strike). A live slot's squad, the wasps whose squad value lies in its [low, high),
//   flies that slot's song; every other wasp flies the whole-swarm form. A Gust pulse is then added on top of both.
// Adding a song: a form id below, one target function that returns a Steer from a SlotContext, and one case in
// SlotSteer. Nothing else in this file or in SwarmGpuView changes.

#pragma kernel Simulate
#pragma kernel ResetWasps

// Matches SwarmGpuView.ThreadsPerGroup.
#define THREAD_GROUP_SIZE 64

// Matches SwarmGpuView.SlotCount (one per DigitalStory.Logic.SongSlot: Post 0, Guard 1, Strike 2) and
// SwarmGpuView.VectorsPerSlot.
#define SLOT_COUNT 3
#define SLOT_VECTORS 3

// 48 bytes, the same layout as SwarmGpuView.WaspStatic and the struct in WaspInstanced.shader. Written once by the CPU.
struct WaspStatic
{
    float seed;          // 0..1: phases the wings and spreads the halo
    float lane;          // 0..1: place along the river (0 at the Piper) and order in a form wave
    float ringAngle;     // radians: place around the river's cross-section
    float ringRadius;    // 0..1: share of the river radius
    float3 boneOffset;   // the wasp's point on the Colossus, in its bone's space
    float boneIndex;     // the Colossus bone, as a whole number
    float height01;      // 0 at the Colossus's feet, 1 at its head: order of the Colossus wave
    float level01;       // 0..1: height in the tornado and latitude on spheres
    float phase01;       // 0..1: spreads timings and directions
    float squad;         // 0..1: frac(0.5 + index x 0.7548777). Which slot's squad the wasp joins, and its rank there
};

// 48 bytes, the same layout as the struct in WaspInstanced.shader. Only this shader writes it.
struct WaspDynamic
{
    float3 position;
    float state;         // StateAlive, StateDying or StateDead
    float3 velocity;
    float stateTime;     // seconds in the current state
    float4 tint;         // rgb colour, a heat: how hot the wasp glows in WaspInstanced.shader and WaspGlow.shader
};

StructuredBuffer<WaspStatic> _Static;
RWStructuredBuffer<WaspDynamic> _Dynamic;
StructuredBuffer<float4> _Trail;          // newest first: xyz position, w metres from the newest point
StructuredBuffer<float4x4> _Bones;        // the Colossus's bones, local to world

int _MaxWasps;
int _ActiveCount;
int _TrailCount;
int _BoneCount;                           // 0 until the Colossus has bones and samples
int _Form;                                // the whole-swarm DigitalStory.Logic.SwarmForm: River, HiveCall, Colossus or Collapsed
int _PreviousForm;

float _SimTime;
float _DeltaTime;                         // already capped at SwarmConfig.MaxDeltaTime
float _FormStartTime;
float _PreviousFormStartTime;

float4 _PiperPosition;
float4 _PiperForward;                     // flat and unit length
float _StandingShare;                     // 0 while the Piper walks, easing to 1 once they have stood still a moment
float4 _HiveA;                            // xyz position, w 1 while it stands
float4 _HiveB;
float4 _LastHit;

// The song slots, SLOT_VECTORS float4s per slot, in the order of DigitalStory.Logic.SongSlot:
//   [0] header: x the SwarmForm id, or -1 while the slot is empty; y the cast, in _SimTime; z low; w high (the squad range)
//   [1] p0: SlotState.ParamA, the song's own numbers (see each target function)
//   [2] p1: SlotState.ParamB, except w: the release, in _SimTime, or -1 while the song runs
float4 _Slots[SLOT_COUNT * SLOT_VECTORS];

// Each slot's colour, in the colour space the draw expects: the category colour of the song it holds.
float4 _SlotColors[SLOT_COUNT];

// The Gust pulse: xy the centre on the ground (world x and z), z its start in _SimTime, w its radius (0: no gust yet).
float4 _Pulse;

// Colours, already in the colour space the draw expects. A wasp in the river (or the collapsed swarm) shows the river's
// colour; in Hive Call or the Colossus it shows the cast colour. A form change sweeps through the swarm as a wave, so a
// wasp the wave has not reached yet still shows the colour of the form before.
float4 _RiverColor;
float4 _CastColor;
float4 _PreviousCastColor;

// From SwarmConfig.
float _RiverSpring;
float _RiverDamping;
float _ShapeSpring;
float _ShapeDamping;
float _WobbleDamping;
float _WobbleSeconds;
float _FormWaveSeconds;
float _FlowSpeed;
float _RiverLength;
float _RiverRadius;
float _MeanderAmplitude;
float _StandingTrailMeters;
float _TorusRadius;
float _DyingSeconds;

static const float FullTurn = 6.28318530718;
static const float HalfTurn = 3.14159265359;
static const float3 Up = float3(0.0, 1.0, 0.0);
static const float3 Still = float3(0.0, 0.0, 0.0);
static const float Tiny = 0.0001;

// Wasp states, stored as floats in WaspDynamic.state.
static const int StateAlive = 0;
static const int StateDying = 1;
static const int StateDead = 2;

// Form ids, the same numbers as DigitalStory.Logic.SwarmForm. River, HiveCall, Colossus and Collapsed are whole-swarm
// forms; the rest run in a slot.
static const int FormRiver = 0;
static const int FormDome = 1;
static const int FormSting = 2;
static const int FormTornado = 3;
static const int FormGust = 4;
static const int FormHiveCall = 5;
static const int FormColossus = 6;
static const int FormCollapsed = 7;
static const int FormMeteor = 8;

static const int NoSlot = -1;
static const float NoFloor = -100000.0;  // a Steer's floor when the wasp may fly as low as it likes

// Enough halving steps for a trail of 4,096 points.
static const int TrailSearchSteps = 12;

// The look of each form, from spec 9.3 and songs-v2 section B. SwarmConfig does not hold these; move one there if it
// needs tuning. The shapes are sized for at most 4,000 wasps of 0.24 m: wide and thick enough that the wasps keep apart.
static const float FlyHeight = 1.0;              // metres above the ground the river flows
static const float CrossSectionHeight = 0.45;    // the river's and the ring's height as a share of their width. Flat, so
                                                 // the wasps spread out where the camera above sees them one by one
                                                 // instead of stacking into one glowing band
static const float RiverSwirl = 0.6;             // radians per second the river's cross-section turns
static const float MeanderWaveNumber = 1.4;      // radians per metre along the river, a wave about 4.5 m long
static const float MeanderSpeed = 0.9;           // radians per second
static const float RiverHeadGap = 1.2;           // metres behind the Piper where the river starts, so it never hides them
static const float HaloRadius = 0.9;
static const float HaloHeight = 2.2;             // over the Piper's head, clear of it by more than HaloThickness
static const float HaloThickness = 0.25;
static const float HaloSpin = 2.5;               // radians per second

// Every slot song launches and returns with the same two blends (songs-v2 B). Peel: a wasp leaves the base form over
// PeelSeconds, starting PeelStagger later the further back along the river it was at the cast, so the river's head
// leaves first and a launch is a ribbon, never a pop. A song that hits sooner than the ribbon ends squeezes it with
// PeelBy, so its whole squad is in the shape on the hit's frame. Home: after the release it eases back over
// HomeSeconds, starting HomeStagger later the higher its order. The plan's Home is 0.5 s plus 0.25 s; it is shortened
// so the last wasp is home when the slot's 0.6 s return beat ends and the slot empties, instead of springing the last
// fifth of the way.
static const float PeelSeconds = 0.3;
static const float PeelStagger = 0.25;
static const float HomeSeconds = 0.4;
static const float HomeStagger = 0.2;

// Strikes fly on a stiff spring so a fast wasp keeps to its path; held shapes use SwarmConfig's shape spring.
static const float StrikeSpring = 400.0;         // stable to dt 1/30
static const float StrikeDamping = 0.8;
static const float StrikeMaxSpeed = 70.0;        // metres per second, enough for an 18 m dive from 12 m up in 0.5 s
static const float MaxSpeed = 25.0;              // metres per second, so a far target never fires a wasp across the map.
                                                 // WaspInstanced.shader draws a wasp faster than this as a streak.

// The heat curve of a strike (songs-v2 B): from WindUpStartHeat to WindUpHeat through the wind-up, ImpactHeat for
// ImpactSeconds from the impact, then HoldHeat. ImpactHeat is the only heat that turns a wasp white in the draw.
static const float WindUpStartHeat = 0.4;
static const float WindUpHeat = 0.8;
static const float ImpactHeat = 1.0;
static const float ImpactSeconds = 0.15;
static const float HoldHeat = 0.5;

// The heat of the whole-swarm forms and the held shapes, 0 to 1: how much brighter than the calm river the wasps and
// their glow burn, and how much their eyes light up.
static const float RiverGlow = 0.1;
static const float RiverQuietGlow = 0.05;        // while any slot holds a song, so the squads stand out
static const float DomeGlow = 0.4;
static const float GustGlow = 0.4;
static const float HiveCallGlow = 0.6;
static const float ColossusGlow = 0.4;

// Sting (Strike slot). p0.xyz: the target's feet, live. p0.w: the seconds the head takes to arrive, when the damage
// starts (StingSong.ArriveSeconds). p1.xyz: a second target, read by the Twin Sting duet later.
static const float StingFlightSeconds = 0.6;     // the arrival while p0.w is 0
static const float StingArcHeight = 1.2;         // metres the arc rises, plus StingArcRise per metre of distance
static const float StingArcRise = 0.25;
static const float StingChestHeight = 1.0;       // metres above the target's feet
static const float StingHeadWidth = 0.08;        // metres the comet's head spreads; the tail adds up to StingTailWidth
static const float StingTailWidth = 0.6;
static const float StingWrapStart = 0.75;        // share of its flight after which a wasp turns from the arc onto its ring
// The plan's 0.8 m rings (squeezing to 0.55 m) read as one blob once 600 to 740 wasps of WaspLength sit on them, so
// they are drawn wider and thinner here, in the same proportions.
static const float StingRingRadius = 1.1;
static const float StingSqueezeRadius = 0.75;
static const float StingTickSeconds = 0.25;      // the rings squeeze and flare once per tick from the head's arrival
static const float StingSqueezeSeconds = 0.2;    // seconds a squeeze takes to ease back out
static const float StingTickHeat = 0.9;
static const float StingRingTilt = 0.959931;     // 55 degrees up from the ground (35 from upright), so the rings cross like a gyroscope's
static const float StingRingSpin = 5.0;          // radians per second, the two rings turning against each other
static const float StingRingTube = 0.12;         // metres each ring's band is thick, so the wasps keep apart
static const float StingPopRadius = 1.6;
static const float StingPopSeconds = 0.15;
static const float StingHomeSeconds = 0.3;       // the flight home along the reversed arc, after the pop
static const float StingHomeStagger = 0.15;

// Tornado (Strike slot). p0: (outer radius, height, spin, hit seconds). p1.x: the wall radius (Eye of the Storm moves it).
static const float DefaultTornadoRadius = 5.0;
static const float TornadoInnerRadius = 1.5;
static const float TornadoHeight = 3.0;
static const float TornadoSpin = 6.0;            // radians per second until the hit
static const float TornadoHitSeconds = 0.3;
static const float TornadoSpinUp = 1.5;          // the spin after the hit, as a share of the spin before: 6 to 9 rad/s
static const float TornadoSpinUpSeconds = 0.3;
static const float TornadoFunnelBottom = 0.8;    // the column's radius at the bottom and top, as a share
static const float TornadoFunnelTop = 1.25;
static const float TornadoWallShare = 0.75;      // share of the wasps in the column's wall; the rest, the river's head
                                                 // at the cast, are flung out, since they reach the Piper first
static const float TornadoWallThickness = 0.7;   // metres
static const float TornadoBaseHeight = 0.2;
static const float TornadoTwist = 3.0;           // radians the spiral turns from bottom to top
static const float TornadoSkirtRadius = 1.5;     // the skirt the wasps wait in until the growing top passes them
static const float TornadoSkirtHeight = 0.3;
static const float TornadoClimbBand = 0.6;       // metres below its place the top is when a wasp starts up the column
static const float TornadoShockSeconds = 0.12;   // the flung share's goal takes this long to reach the outer radius
static const float TornadoShockLead = 0.22;      // seconds before the hit it sets off, so with the strike spring's lag
                                                 // the ring reaches the beekeepers on the hit's frame (stepped at 60 fps)
static const float TornadoShockInner = 0.85;     // the shock ring's inner edge, as a share of the outer radius
static const float TornadoShockHeight = 0.5;     // knee high
static const float TornadoShockSpin = 1.0;       // radians per second the shock ring turns. At the column's spin its 5 m
                                                 // ring would need 45 m/s, past MaxSpeed, and the wasps would cut inside it.
static const float TornadoUnwind = 1.0;          // the radius grows by this share as the column unwinds into the river

// Meteor (Strike slot). p0: (impact point xyz, live until the dive; height). p1.xyz: (rise, dive, radius) in seconds,
// seconds and metres. The first diver lands at rise + dive, with the damage.
static const float DefaultMeteorRadius = 3.0;    // the reach when p1.z is 0, MeteorSong.Radius's default
static const float MeteorMarkerShare = 0.9;      // the wasps ranked from here up draw the target ring instead of diving
static const float MeteorMarkDropSeconds = 0.3;  // they drop from the ball to the ring when their climb ends
static const float MeteorMarkSpin = 1.2;         // radians per second the target ring turns
static const float MeteorClimbStagger = 0.3;     // share of the rise over which the climbers set off, lowest rank first
static const float MeteorClimbShare = 0.55;      // share of the rise one wasp's climb takes; the rest is the hang
static const float MeteorGatherShare = 0.5;      // share of its climb a wasp takes to leave the river for the column
static const float MeteorSpreadShare = 0.7;      // from this share of its climb the column opens into the ball
static const float MeteorColumnRadius = 0.45;
static const float MeteorColumnSpin = 4.0;       // radians per second
static const float MeteorBallRadius = 1.6;
static const float MeteorHeartRadius = 1.0;      // the ball tightens to this in the heartbeat before the dive
static const float MeteorHeartbeatSeconds = 0.2;
static const float MeteorBallSpin = 1.5;         // radians per second
static const float MeteorDiveStagger = 0.15;     // seconds from the first diver to the last, so the dive draws streaks
static const float MeteorDiveEase = 0.5;         // the dive's starting speed as a share of its mean; it ends at 2 minus this
static const float MeteorLandingScatter = 1.0;   // metres from the impact point a wasp lands, at most
static const float MeteorFloorHeight = 0.15;     // metres above the impact point a landed wasp skims
static const float MeteorSkidKeep = 0.35;        // share of its ground speed a wasp keeps when it hits the floor
static const float MeteorRingInner = 0.7;        // the burst ring's inner edge, as a share of its radius
static const float MeteorRingHeight = 0.4;
// The rules let go as the meteor lands, so the burst and the flight home share the slot's 0.6 s return beat
// (SquadConfig.ReturnSeconds): MeteorBurstSeconds + MeteorHomeSeconds + MeteorHomeStagger must not pass it.
static const float MeteorBurstSeconds = 0.2;     // seconds after the release before the first wasp heads home
static const float MeteorHomeSeconds = 0.3;
static const float MeteorHomeStagger = 0.1;      // seconds from the first rank heading home to the last

// Dome (Guard slot). p0.x: the radius. p0.yzw (hit direction and time) feed the ripple of a later milestone.
static const float DefaultDomeRadius = 2.2;
static const float DomeSpin = 0.25;              // radians per second
static const float DomeShellThickness = 0.3;     // metres the shell spreads across its radius, so it reads as a swarm
static const float DomeWeaveStagger = 0.35;      // seconds from the ground ring leaving to the crown leaving
static const float DomeWeaveSeconds = 0.25;      // seconds one wasp's spiral into its place takes
static const float DomeWeaveTurn = 1.5;          // radians a wasp turns about the Piper as it spirals in

// Gust: a pulse added to every wasp within the radius, whatever it is doing. An inhale toward the centre, then a ring
// whose front pushes the wasps out and up as it passes, slowing as it grows; then the swarm glides back.
static const float GustInhaleSeconds = 0.12;
static const float GustInhaleMeters = 0.5;
static const float GustStartRadius = 0.6;
static const float GustRingSeconds = 0.5;        // from the end of the inhale to the ring at its full radius
static const float GustPushMeters = 1.2;
static const float GustLiftMeters = 0.4;
static const float GustPushRise = 0.4;           // metres the front travels past a wasp while it is pushed out
static const float GustPushFall = 2.0;           // metres more while the push eases off
static const float GustFadeStart = 0.55;
static const float GustPulseSeconds = 0.8;       // GustSong.Seconds: the pulse is over by then

static const float SpawnHeight = 1.2;            // metres above a hive's base
static const float SpawnScatter = 0.5;
static const float SpawnLift = 4.0;              // upward metres per second at birth, so newcomers arc in
static const float ResetScatter = 1.5;
static const float BurstSpeed = 4.0;             // metres per second a lost wasp flies from the hit
static const float BurstLift = 0.6;
static const float BurstSpreadMin = 0.6;
static const float BurstSpreadRange = 0.8;
static const float Gravity = 9.81;
static const float FallDrag = 1.5;               // share of speed lost per second while falling
static const float TintSharpness = 6.0;          // how fast a wasp takes on its form's colour, per second
static const float SlotTintSharpness = 14.0;     // faster, so a song's colour and cooling follow its short beats

// What one slot hands its target function for one wasp.
struct SlotContext
{
    uint index;
    WaspStatic wasp;
    float3 baseGoal;     // where the whole-swarm form wants the wasp: every launch peels from it, every return goes to it
    float u;             // 0..1: the wasp's rank in its squad, evenly spread
    float lane;          // 0..1: its place along the river at the cast, 0 at the head
    float seconds;       // since the cast
    float released;      // seconds since the release, or -1 while the song runs
    float4 p0;           // SlotState.ParamA
    float4 p1;           // SlotState.ParamB; w is the release time, already turned into `released`
};

// What a target function decides for one wasp.
struct Steer
{
    float3 goal;
    float share;         // 0: flies, glows and is coloured like the base form; 1: like the song
    float heat;          // the song's heat
    float floorY;        // a wasp below this skims along it, or NoFloor
    bool isFast;         // on the strike spring and the strike speed cap
};

int StateOf(WaspDynamic body)
{
    return (int)(body.state + 0.5);
}

// The header of a slot: x form or -1, y cast time, z low, w high.
float4 SlotHeader(int slot)
{
    return _Slots[slot * SLOT_VECTORS];
}

bool IsSlotLive(float4 header)
{
    return header.x >= 0.0;
}

bool IsAnySlotLive()
{
    bool isLive = false;

    [unroll]
    for (int slot = 0; slot < SLOT_COUNT; slot++)
    {
        if (IsSlotLive(SlotHeader(slot)))
        {
            isLive = true;
        }
    }

    return isLive;
}

// The slot whose squad holds this wasp, or NoSlot. The bands never overlap, so at most one matches.
int SlotOf(WaspStatic wasp)
{
    int found = NoSlot;

    [unroll]
    for (int slot = 0; slot < SLOT_COUNT; slot++)
    {
        float4 header = SlotHeader(slot);
        if (IsSlotLive(header) && wasp.squad >= header.z && wasp.squad < header.w)
        {
            found = slot;
        }
    }

    return found;
}

// One exit with the result set first, so the compiler sees it initialised on every path.
float GlowOf(int look)
{
    float glow = IsAnySlotLive() ? RiverQuietGlow : RiverGlow;
    if (look == FormHiveCall)
    {
        glow = HiveCallGlow;
    }
    else if (look == FormColossus)
    {
        glow = ColossusGlow;
    }

    return glow;
}

// The colour and heat a wasp of the whole-swarm form heads for. hasSwitched says whether the form's wave has reached the
// wasp, the same test that picks its form, so the colour flows through the swarm with the motion.
float4 TintOf(int look, bool hasSwitched)
{
    float3 color = hasSwitched ? _CastColor.rgb : _PreviousCastColor.rgb;
    if (look == FormRiver || look == FormCollapsed)
    {
        color = _RiverColor.rgb;
    }

    return float4(color, GlowOf(look));
}

float3 RingOffset(float angle, float radius)
{
    return float3(cos(angle) * radius, 0.0, sin(angle) * radius);
}

// A point on the unit sphere, spread by two of the wasp's random numbers.
float3 SphereDirection(WaspStatic wasp)
{
    float latitude = 1.0 - 2.0 * wasp.level01;
    float spread = sqrt(saturate(1.0 - latitude * latitude));
    return RingOffset(wasp.phase01 * FullTurn, spread) + Up * latitude;
}

// The flat, unit direction from one point to another, or the Piper's facing when they stand on the same spot.
float3 FlatDirection(float3 from, float3 to)
{
    float3 along = to - from;
    along.y = 0.0;
    float alongLength = length(along);
    return alongLength > Tiny ? along / alongLength : _PiperForward.xyz;
}

float3 Bezier(float3 start, float3 control, float3 end, float progress)
{
    float rest = 1.0 - progress;
    return rest * rest * start + 2.0 * rest * progress * control + progress * progress * end;
}

// The Bezier's rate of change per unit of progress.
float3 BezierSlope(float3 start, float3 control, float3 end, float progress)
{
    return 2.0 * (1.0 - progress) * (control - start) + 2.0 * progress * (end - control);
}

// How far the strike spring lags a goal moving at one metre per second. Setting the goal that far ahead along a fast
// path lets the wasp keep to the path instead of trailing it, so it lands on time.
float StrikeLeadSeconds()
{
    return 2.0 * StrikeDamping / sqrt(StrikeSpring);
}

// The point `distance` metres back along the Piper's trail, and the way the trail runs there (toward the Piper).
// Safe with no trail points (the Piper) and with one (that point).
void SampleTrail(float distance, out float3 position, out float3 direction)
{
    position = _PiperPosition.xyz;
    direction = _PiperForward.xyz;

    if (_TrailCount <= 0)
    {
        return;
    }

    if (_TrailCount == 1)
    {
        position = _Trail[0].xyz;
        return;
    }

    int low = 0;
    int high = _TrailCount - 1;
    float clamped = clamp(distance, 0.0, _Trail[high].w);

    [loop]
    for (int step = 0; step < TrailSearchSteps; step++)
    {
        if (high - low > 1)
        {
            int middle = (low + high) >> 1;
            if (_Trail[middle].w <= clamped)
            {
                low = middle;
            }
            else
            {
                high = middle;
            }
        }
    }

    float4 newer = _Trail[low];
    float4 older = _Trail[high];
    float span = older.w - newer.w;
    float blend = span > Tiny ? saturate((clamped - newer.w) / span) : 0.0;
    position = lerp(newer.xyz, older.xyz, blend);

    float3 along = newer.xyz - older.xyz;
    along.y = 0.0;
    float alongLength = length(along);
    if (alongLength > Tiny)
    {
        direction = along / alongLength;
    }
}

float TrailLength()
{
    return _TrailCount > 0 ? _Trail[_TrailCount - 1].w : 0.0;
}

// The wasp's place along the river at a moment: 0 at the head, by the Piper, 1 at the tail.
float FlowLaneAt(WaspStatic wasp, float time)
{
    return frac(wasp.lane + time * _FlowSpeed);
}

// While the Piper stands, the river curls into a lazy ring around them.
float3 TorusTarget(WaspStatic wasp, float flowLane)
{
    float around = flowLane * FullTurn;
    float angle = wasp.ringAngle + _SimTime * RiverSwirl;
    float radius = wasp.ringRadius * _RiverRadius;
    float reach = _TorusRadius + cos(angle) * radius;
    float3 lift = Up * (FlyHeight + sin(angle) * radius * CrossSectionHeight);
    return _PiperPosition.xyz + RingOffset(around, reach) + lift;
}

float3 RiverTarget(WaspStatic wasp)
{
    float flowLane = FlowLaneAt(wasp, _SimTime);
    float trailLength = TrailLength();
    float along = lerp(RiverHeadGap, max(min(_RiverLength, trailLength), RiverHeadGap), flowLane);

    float3 center;
    float3 direction;
    SampleTrail(along, center, direction);
    float3 side = cross(Up, direction);

    float angle = wasp.ringAngle + _SimTime * RiverSwirl;
    float radius = wasp.ringRadius * _RiverRadius;
    float meander = _MeanderAmplitude * sin(along * MeanderWaveNumber - _SimTime * MeanderSpeed);
    float3 river = center + Up * (FlyHeight + sin(angle) * radius * CrossSectionHeight) + side * (cos(angle) * radius + meander);

    // The torus shows while the trail is still too short to hold a river (the start of a run) and while the Piper
    // stands. The trail alone cannot say the second: it keeps its full length after the Piper stops.
    float trailShare = saturate(trailLength / max(_StandingTrailMeters, Tiny));
    float riverShare = trailShare * (1.0 - saturate(_StandingShare));
    return lerp(TorusTarget(wasp, flowLane), river, riverShare);
}

// A tight halo over the Piper's head.
float3 HaloTarget(WaspStatic wasp)
{
    float around = wasp.seed * FullTurn + _SimTime * HaloSpin;
    float wobble = wasp.ringRadius * HaloThickness;
    float reach = HaloRadius + cos(wasp.ringAngle) * wobble;
    float lift = HaloHeight + sin(wasp.ringAngle) * wobble;
    return _PiperPosition.xyz + RingOffset(around, reach) + Up * lift;
}

int BoneOf(WaspStatic wasp)
{
    return (int)(wasp.boneIndex + 0.5);
}

bool HasColossusPlace(WaspStatic wasp)
{
    int bone = BoneOf(wasp);
    return bone >= 0 && bone < _BoneCount;
}

float3 ColossusTarget(WaspStatic wasp)
{
    return mul(_Bones[BoneOf(wasp)], float4(wasp.boneOffset, 1.0)).xyz;
}

// Where a wasp wants to be in a whole-swarm form, which look it shows and whether the stiff shape spring holds it.
// A Colossus without bones, Collapsed and the River itself are the river.
float3 GoalOf(int form, WaspStatic wasp, out int look, out bool isShape)
{
    look = form;
    isShape = true;
    float3 goal = _PiperPosition.xyz;

    if (form == FormHiveCall)
    {
        goal = HaloTarget(wasp);
    }
    else if (form == FormColossus && HasColossusPlace(wasp))
    {
        goal = ColossusTarget(wasp);
    }
    else
    {
        look = FormRiver;
        isShape = false;
        goal = RiverTarget(wasp);
    }

    return goal;
}

// ---------------------------------------------------------------------------------------------------------------------
// The helpers every slot song shares (songs-v2 B).

Steer SteerOf(float3 goal, float share, float heat)
{
    Steer steer;
    steer.goal = goal;
    steer.share = saturate(share);
    steer.heat = heat;
    steer.floorY = NoFloor;
    steer.isFast = false;
    return steer;
}

// 0 while the wasp still flies the base form, easing to 1 as it leaves it for the song. The river's head leaves first.
float Peel(float seconds, float lane)
{
    return smoothstep(0.0, PeelSeconds, seconds - lane * PeelStagger);
}

// Peel squeezed in time, the same ribbon, so even the river's tail has left the base form by `end` seconds. For a song
// that hits at `end`, so every wasp in its shape is there, and flashes, on the hit's frame. Never slower than Peel.
float PeelBy(float seconds, float lane, float end)
{
    float squeeze = min(end / (PeelSeconds + PeelStagger), 1.0);
    return smoothstep(0.0, PeelSeconds * squeeze, seconds - lane * PeelStagger * squeeze);
}

// 0 while the song holds the wasp, easing to 1 once it is back in the base form. Order 0 leaves first.
float Home(float released, float order)
{
    return released < 0.0 ? 0.0 : smoothstep(0.0, HomeSeconds, released - order * HomeStagger);
}

// The heat of a strike: the wind-up while windUp goes from 0 to 1, then the impact flash and the hold once
// sinceImpact is 0 or more.
float StrikeHeat(float windUp, float sinceImpact)
{
    float heat = lerp(WindUpStartHeat, WindUpHeat, saturate(windUp));
    if (sinceImpact >= 0.0)
    {
        heat = sinceImpact < ImpactSeconds ? ImpactHeat : HoldHeat;
    }

    return heat;
}

// ---------------------------------------------------------------------------------------------------------------------
// Sting: a comet along an arc to the target, two gyroscope rings that wrap it, then a pop and the arc home.

// A point on one of the two rings round the target's chest. The first half of the squad makes one ring, level along the
// line to the target and tilted up across it, turning one way; the second half the other ring, level across the line and
// tilted along it, turning the other way. Seen from any side the two cross like a gyroscope's. Each ring is a band
// StingRingTube thick, so the wasps keep apart.
float3 StingRingPoint(SlotContext context, float3 center, float3 toward, float radius)
{
    bool isFirstRing = context.u < 0.5;
    float spin = isFirstRing ? StingRingSpin : -StingRingSpin;
    float3 side = cross(Up, toward);
    float3 level = isFirstRing ? toward : side;
    float3 flat = isFirstRing ? side : toward;

    float tiltSin;
    float tiltCos;
    sincos(isFirstRing ? StingRingTilt : -StingRingTilt, tiltSin, tiltCos);
    float3 lifted = flat * tiltCos + Up * tiltSin;
    float3 normal = cross(level, lifted);

    float aroundSin;
    float aroundCos;
    sincos(frac(context.u * 2.0) * FullTurn + context.seconds * spin, aroundSin, aroundCos);
    float3 radial = level * aroundCos + lifted * aroundSin;

    float tubeSin;
    float tubeCos;
    sincos(context.wasp.lane * FullTurn, tubeSin, tubeCos);
    float tube = context.wasp.ringRadius * StingRingTube;
    return center + radial * (radius + tubeCos * tube) + normal * (tubeSin * tube);
}

Steer StingSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float3 start = _PiperPosition.xyz + Up * FlyHeight;
    float3 center = context.p0.xyz + Up * StingChestHeight;
    float3 control = (start + center) * 0.5 + Up * (StingArcHeight + StingArcRise * distance(start, center));
    float3 toward = FlatDirection(_PiperPosition.xyz, context.p0.xyz);

    // Launch: the comet. Its rank is the wasp's place in the river at the cast, so the river's head is the comet's tight,
    // bright head and the tail widens behind it. The goal leads the arc by the strike spring's lag, so the head lands
    // on the arc's end at the rules' arrival, when the damage starts.
    float flight = context.p0.w > 0.0 ? context.p0.w : StingFlightSeconds;
    float leave = context.lane * PeelStagger;
    float progress = saturate((context.seconds - leave) / flight);
    float rate = progress > 0.0 && progress < 1.0 ? 1.0 / flight : 0.0;
    float3 slope = BezierSlope(start, control, center, progress);
    float3 across = cross(Up, toward) * cos(wasp.ringAngle) + Up * sin(wasp.ringAngle);
    float width = (StingHeadWidth + context.lane * StingTailWidth) * wasp.ringRadius;
    float3 comet = Bezier(start, control, center, progress) + slope * (rate * StrikeLeadSeconds()) + across * width;

    // Peak: the rings, squeezing and flaring once a tick from the head's arrival.
    float sinceHead = context.seconds - flight;
    float tick = frac(max(sinceHead, 0.0) / StingTickSeconds) * StingTickSeconds;
    float squeeze = sinceHead >= 0.0 ? 1.0 - smoothstep(0.0, StingSqueezeSeconds, tick) : 0.0;
    float3 ring = StingRingPoint(context, center, toward, lerp(StingRingRadius, StingSqueezeRadius, squeeze));
    float3 shape = lerp(comet, ring, smoothstep(StingWrapStart, 1.0, progress));

    float sinceArrival = context.seconds - leave - flight;
    float heat = StrikeHeat(progress, sinceArrival);
    if (sinceArrival >= ImpactSeconds)
    {
        heat = lerp(HoldHeat, StingTickHeat, squeeze);
    }

    // Peel's ribbon, but never slower than the flight, so a wasp has fully left the river, and flashes, as it arrives.
    float peel = smoothstep(0.0, min(PeelSeconds, flight), context.seconds - leave);
    float3 goal = lerp(context.baseGoal, shape, peel);
    float share = peel;
    bool isFast = rate > 0.0;

    // Return: the cocoon pops to a sphere, then streams home on the reversed arc and into the base form.
    if (context.released >= 0.0)
    {
        float pop = smoothstep(0.0, StingPopSeconds, context.released);
        float3 burst = lerp(goal, center + SphereDirection(wasp) * StingPopRadius, pop);
        float back = smoothstep(0.0, StingHomeSeconds, context.released - StingPopSeconds - context.u * StingHomeStagger);
        float home = smoothstep(0.5, 1.0, back);
        goal = lerp(Bezier(burst, control, start, back), context.baseGoal, home);
        share = peel * (1.0 - home);
        heat = context.released < StingPopSeconds ? ImpactHeat : HoldHeat;
        isFast = back > 0.0 && back < 1.0;
    }

    Steer steer = SteerOf(goal, share, heat);
    steer.isFast = isFast;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Tornado: it grows from the ground up, the flung share bursts out into a knee-high shock ring at the hit, and it
// collapses from the top down, unwinding outward into the river.

// Radians turned since the cast: spin per second, easing up to TornadoSpinUp times it over TornadoSpinUpSeconds after
// the hit. Worked out whole each frame, so it needs nothing from the frame before.
float TornadoTurn(float seconds, float spin, float hit)
{
    float ramp = clamp(seconds - hit, 0.0, TornadoSpinUpSeconds);
    float beyond = max(seconds - hit - TornadoSpinUpSeconds, 0.0);
    float extra = (TornadoSpinUp - 1.0) * spin * (ramp * ramp / (2.0 * TornadoSpinUpSeconds) + beyond);
    return spin * seconds + extra;
}

Steer TornadoSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float outer = context.p0.x > 0.0 ? context.p0.x : DefaultTornadoRadius;
    float height = context.p0.y > 0.0 ? context.p0.y : TornadoHeight;
    float spin = context.p0.z > 0.0 ? context.p0.z : TornadoSpin;
    float hit = context.p0.w > 0.0 ? context.p0.w : TornadoHitSeconds;
    float wall = context.p1.x > 0.0 ? context.p1.x : TornadoInnerRadius;
    float seconds = context.seconds;

    // Launch: the top climbs from the ground to full height by the hit. A wasp waits in the skirt until the top
    // reaches its place, then spirals up to it.
    float place = TornadoBaseHeight + wasp.level01 * height;
    float top = TornadoBaseHeight + height * smoothstep(0.0, hit, seconds);
    float climbed = smoothstep(place - TornadoClimbBand, place, top);
    float funnel = lerp(TornadoFunnelBottom, TornadoFunnelTop, wasp.level01);
    float wallRadius = (wall + (wasp.ringRadius - 0.5) * TornadoWallThickness) * funnel;
    float skirtRadius = TornadoSkirtRadius + (wasp.ringRadius - 0.5) * TornadoWallThickness;
    float radius = lerp(skirtRadius, wallRadius, climbed);
    float lift = lerp(TornadoSkirtHeight, place, climbed);

    // Peak: the flung share shoots out flat to the reach, a knee-high ring that lands on the beekeepers at the hit.
    float sinceHit = seconds - hit;
    float sinceShock = sinceHit + TornadoShockLead;
    bool isFlung = context.lane < 1.0 - TornadoWallShare;
    float shock = isFlung ? smoothstep(0.0, TornadoShockSeconds, sinceShock) : 0.0;
    radius = lerp(radius, lerp(TornadoShockInner, 1.0, wasp.ringRadius) * outer, shock);
    lift = lerp(lift, TornadoShockHeight, shock);

    // Return: the top leaves first, swinging outward and down as it pours into the base form.
    float home = Home(context.released, 1.0 - wasp.level01);
    radius *= 1.0 + home * TornadoUnwind;
    lift *= 1.0 - home;

    // The flung share leaves the column's spin as it is flung, and the shock ring turns slowly.
    float turn = TornadoTurn(seconds, spin, hit);
    if (isFlung)
    {
        float shockStart = hit - TornadoShockLead;
        float flungTurn = TornadoTurn(min(seconds, shockStart), spin, hit) + max(seconds - shockStart, 0.0) * TornadoShockSpin;
        turn = lerp(turn, flungTurn, shock);
    }

    float around = wasp.ringAngle + wasp.level01 * TornadoTwist + turn;
    float3 shape = _PiperPosition.xyz + RingOffset(around, radius) + Up * lift;
    float peel = PeelBy(seconds, context.lane, hit);
    float3 goal = lerp(lerp(context.baseGoal, shape, peel), context.baseGoal, home);

    Steer steer = SteerOf(goal, peel * (1.0 - home), StrikeHeat(seconds / hit, sinceHit));
    steer.isFast = isFlung && sinceShock >= 0.0 && sinceShock < 2.0 * TornadoShockSeconds && home <= 0.0;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Meteor: a spiral climb into a ball high over the Piper while the top tenth drops early to draw the target ring; a
// heartbeat; a streaked dive; the ring burst; then home.

// A loose ball at the top of the climb, turning slowly.
float3 MeteorBallPoint(WaspStatic wasp, float seconds, float height, float radius)
{
    float latitude = 1.0 - 2.0 * wasp.level01;
    float spread = sqrt(saturate(1.0 - latitude * latitude));
    float around = wasp.phase01 * FullTurn + seconds * MeteorBallSpin;
    float3 offset = (RingOffset(around, spread) + Up * latitude) * (wasp.ringRadius * radius);
    return _PiperPosition.xyz + Up * height + offset;
}

// Out of the base form into a tight column over the Piper, up it, and out into the ball at the top.
float3 MeteorClimbPoint(SlotContext context, float progress, float climbSeconds, float height, float3 ball)
{
    WaspStatic wasp = context.wasp;
    float climb = smoothstep(0.0, 1.0, progress);
    float climbRate = 6.0 * progress * (1.0 - progress) / climbSeconds;
    float lead = (height - FlyHeight) * climbRate * StrikeLeadSeconds();

    float around = wasp.ringAngle + context.seconds * MeteorColumnSpin;
    float lift = lerp(FlyHeight, height, climb) + lead;
    float3 column = _PiperPosition.xyz + RingOffset(around, wasp.ringRadius * MeteorColumnRadius) + Up * lift;
    float3 lifted = lerp(context.baseGoal, column, smoothstep(0.0, MeteorGatherShare, progress));
    return lerp(lifted, ball, smoothstep(MeteorSpreadShare, 1.0, progress));
}

// A steep line from the ball to the wasp's landing point, faster as it falls. The divers set off one after another,
// so the ball stretches into streaks. The line runs to p0 as it is now, so the dive goes where the rules land it.
float3 MeteorDivePoint(WaspStatic wasp, float progress, float dive, float3 ball, float3 impact)
{
    float travelled = progress * (MeteorDiveEase + (1.0 - MeteorDiveEase) * progress);
    float rate = (MeteorDiveEase + 2.0 * (1.0 - MeteorDiveEase) * progress) / dive;
    float reach = sqrt(wasp.level01) * MeteorLandingScatter;
    float3 landing = impact + RingOffset(wasp.phase01 * FullTurn, reach) + Up * MeteorFloorHeight;
    return ball + (landing - ball) * (travelled + rate * StrikeLeadSeconds());
}

Steer MeteorSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float3 impact = context.p0.xyz;
    float height = context.p0.w;
    float rise = context.p1.x;
    float dive = max(context.p1.y, Tiny);
    float radius = context.p1.z > 0.0 ? context.p1.z : DefaultMeteorRadius;
    float seconds = context.seconds;

    bool isMarker = context.u >= MeteorMarkerShare;
    float order = saturate(context.u / MeteorMarkerShare);
    float climbStart = order * MeteorClimbStagger * rise;
    float climbSeconds = max(MeteorClimbShare * rise, Tiny);
    float climbEnd = climbStart + climbSeconds;
    float diveStart = rise + order * MeteorDiveStagger;
    float landTime = diveStart + context.p1.y;
    float impactTime = rise + context.p1.y;

    float heartbeat = smoothstep(rise - MeteorHeartbeatSeconds, rise, seconds);
    float3 ball = MeteorBallPoint(wasp, seconds, height, lerp(MeteorBallRadius, MeteorHeartRadius, heartbeat));
    float climbProgress = saturate((seconds - climbStart) / climbSeconds);
    float3 climb = MeteorClimbPoint(context, climbProgress, climbSeconds, height, ball);
    float share = smoothstep(0.0, MeteorGatherShare, climbProgress);
    float floorY = NoFloor;
    bool isFast = seconds >= climbStart && seconds < landTime;
    float3 shape = climb;
    float heat = StrikeHeat(heartbeat, seconds - landTime);

    if (isMarker)
    {
        // The top tenth leaves the ball as its climb ends and drops to the target ring, turning, ahead of the dive.
        float drop = saturate((seconds - climbEnd) / MeteorMarkDropSeconds);
        float around = frac((context.u - MeteorMarkerShare) / (1.0 - MeteorMarkerShare)) * FullTurn + seconds * MeteorMarkSpin;
        float3 mark = impact + RingOffset(around, radius) + Up * MeteorFloorHeight;
        shape = lerp(climb, mark, drop * drop);
        isFast = seconds >= climbStart && seconds < climbEnd + MeteorMarkDropSeconds;
        floorY = seconds >= climbEnd ? impact.y + MeteorFloorHeight : NoFloor;
        heat = StrikeHeat(drop, seconds - impactTime);
    }
    else if (seconds >= landTime)
    {
        // Each wasp bursts straight out from its landing point to a ring whose outer edge is the reach.
        float reach = lerp(MeteorRingInner, 1.0, wasp.ringRadius) * radius;
        shape = impact + RingOffset(wasp.phase01 * FullTurn, reach) + Up * MeteorRingHeight;
        floorY = impact.y + MeteorFloorHeight;
    }
    else if (seconds >= diveStart)
    {
        float diveProgress = saturate((seconds - diveStart) / dive);
        shape = MeteorDivePoint(wasp, diveProgress, dive, ball, impact);
        floorY = impact.y + MeteorFloorHeight;
        heat = WindUpHeat;
    }

    // Home after the burst, which starts at the release: the rules let go on the impact frame.
    float home = context.released < 0.0
        ? 0.0
        : smoothstep(0.0, MeteorHomeSeconds, context.released - MeteorBurstSeconds - context.u * MeteorHomeStagger);
    Steer steer = SteerOf(lerp(shape, context.baseGoal, home), share * (1.0 - home), heat);
    steer.floorY = home < 1.0 ? floorY : NoFloor;
    steer.isFast = isFast;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Dome: woven ring by ring from the ground, a turning shell, then it unzips from the top down.

// The squad's rank u is the height on the shell and the wasp's lane its angle. The two are spread evenly and
// independently, so the shell is evenly covered at any squad size.
Steer DomeSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float radius = context.p0.x > 0.0 ? context.p0.x : DefaultDomeRadius;
    float height = 1.0 - context.u;
    float spread = sqrt(saturate(1.0 - height * height));
    float woven = smoothstep(0.0, DomeWeaveSeconds, context.seconds - height * DomeWeaveStagger);
    float around = wasp.lane * FullTurn + context.seconds * DomeSpin - (1.0 - woven) * DomeWeaveTurn;
    float shell = radius + (wasp.ringRadius - 0.5) * DomeShellThickness;
    float3 seat = _PiperPosition.xyz + (RingOffset(around, spread) + Up * height) * shell;

    // The crown has rank 0, so it leaves first.
    float home = Home(context.released, context.u);
    float3 goal = lerp(lerp(context.baseGoal, seat, woven), context.baseGoal, home);
    return SteerOf(goal, woven * (1.0 - home), DomeGlow);
}

// ---------------------------------------------------------------------------------------------------------------------
// The slot dispatch.

SlotContext ContextOf(int slot, uint index, WaspStatic wasp, float3 baseGoal)
{
    float4 header = SlotHeader(slot);
    float4 p1 = _Slots[slot * SLOT_VECTORS + 2];

    SlotContext context;
    context.index = index;
    context.wasp = wasp;
    context.baseGoal = baseGoal;
    context.u = saturate((wasp.squad - header.z) / max(header.w - header.z, Tiny));
    context.lane = FlowLaneAt(wasp, header.y);
    context.seconds = max(_SimTime - header.y, 0.0);
    context.released = p1.w >= 0.0 ? max(_SimTime - p1.w, 0.0) : -1.0;
    context.p0 = _Slots[slot * SLOT_VECTORS + 1];
    context.p1 = p1;
    return context;
}

// One case per slot song. A form this file does not know yet leaves its squad in the base form.
Steer SlotSteer(int form, SlotContext context)
{
    Steer steer = SteerOf(context.baseGoal, 0.0, RiverGlow);
    if (form == FormSting)
    {
        steer = StingSteer(context);
    }
    else if (form == FormTornado)
    {
        steer = TornadoSteer(context);
    }
    else if (form == FormMeteor)
    {
        steer = MeteorSteer(context);
    }
    else if (form == FormDome)
    {
        steer = DomeSteer(context);
    }

    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// The Gust pulse, added on top of whatever a wasp is doing. Its time test reads uniforms only, so every thread takes the
// same branch.

float3 GustPush(float3 goal, WaspStatic wasp, out float heat)
{
    heat = 0.0;
    float3 push = Still;
    float age = _SimTime - _Pulse.z;
    float radius = _Pulse.w;

    if (radius > 0.0 && age >= 0.0 && age < GustPulseSeconds)
    {
        float2 away = goal.xz - _Pulse.xy;
        float reach = length(away);
        float2 direction = float2(cos(wasp.seed * FullTurn), sin(wasp.seed * FullTurn));
        if (reach > Tiny)
        {
            direction = away / reach;
        }

        float inside = reach <= radius ? 1.0 : 0.0;
        float inhale = smoothstep(0.0, GustInhaleSeconds, age) * (1.0 - smoothstep(GustInhaleSeconds, 2.0 * GustInhaleSeconds, age));
        float grown = saturate((age - GustInhaleSeconds) / GustRingSeconds);
        float front = lerp(GustStartRadius, radius, 1.0 - (1.0 - grown) * (1.0 - grown));
        float passed = age >= GustInhaleSeconds ? front - reach : -1.0;
        float wave = saturate(passed / GustPushRise) * (1.0 - saturate((passed - GustPushRise) / GustPushFall));
        wave *= (1.0 - smoothstep(GustFadeStart, GustPulseSeconds, age)) * inside;

        float outward = wave * GustPushMeters - inhale * inside * GustInhaleMeters;
        push = float3(direction.x, 0.0, direction.y) * outward + Up * (wave * GustLiftMeters);
        heat = wave * GustGlow;
    }

    return push;
}

// ---------------------------------------------------------------------------------------------------------------------

// True in the one frame a wasp's river lane wraps from the tail (1) back to the Piper (0).
bool HasLaneWrapped(WaspStatic wasp)
{
    float now = wasp.lane + _SimTime * _FlowSpeed;
    float before = now - _DeltaTime * _FlowSpeed;
    return floor(now) != floor(before);
}

// The Colossus builds from the feet up. Every other whole-swarm form sweeps along the river.
float WaveOrderOf(int form, WaspStatic wasp)
{
    return form == FormColossus ? wasp.height01 : wasp.lane;
}

float3 LimitSpeed(float3 velocity, float maxSpeed)
{
    float speed = length(velocity);
    return speed > maxSpeed ? velocity * (maxSpeed / speed) : velocity;
}

// A wasp that reaches its floor skims along it instead of going through, and loses most of its speed.
void Skim(float floorY, inout WaspDynamic body)
{
    if (body.position.y < floorY)
    {
        body.position.y = floorY;
        body.velocity.y = max(body.velocity.y, 0.0);
        body.velocity.xz *= MeteorSkidKeep;
    }
}

// The spring of spec 9.4, stepped with semi-implicit Euler. Each wasp takes up a new whole-swarm form at
// formStartTime + order x FormWaveSeconds, so a change sweeps along the river (or up the Colossus). A wasp in a live
// slot's squad flies that slot's song instead, starting from and returning to where the whole-swarm form wants it.
void Fly(uint index, WaspStatic wasp, inout WaspDynamic body)
{
    float switchTime = _FormStartTime + WaveOrderOf(_Form, wasp) * _FormWaveSeconds;
    bool hasSwitched = _SimTime >= switchTime;
    float previousSwitchTime = _PreviousFormStartTime + WaveOrderOf(_PreviousForm, wasp) * _FormWaveSeconds;
    int form = hasSwitched ? _Form : _PreviousForm;
    float formSeconds = max(_SimTime - (hasSwitched ? switchTime : previousSwitchTime), 0.0);

    int look;
    bool isShape;
    float3 goal = GoalOf(form, wasp, look, isShape);
    float4 tint = TintOf(look, hasSwitched);
    float stiffness = isShape ? _ShapeSpring : _RiverSpring;
    float damping = isShape ? _ShapeDamping : _RiverDamping;
    bool isWobbling = hasSwitched && formSeconds < _WobbleSeconds;
    bool isFlowing = !isShape;
    float maxSpeed = MaxSpeed;
    float floorY = NoFloor;
    float tintSharpness = TintSharpness;

    int slot = SlotOf(wasp);
    if (slot != NoSlot)
    {
        SlotContext context = ContextOf(slot, index, wasp, goal);
        Steer steer = SlotSteer((int)(SlotHeader(slot).x + 0.5), context);
        goal = steer.goal;
        tint = lerp(tint, float4(_SlotColors[slot].rgb, steer.heat), steer.share);
        stiffness = lerp(stiffness, _ShapeSpring, steer.share);
        damping = lerp(damping, _ShapeDamping, steer.share);
        isWobbling = steer.share > 0.0 && context.seconds < _WobbleSeconds;
        isFlowing = isFlowing && steer.share <= 0.0;
        floorY = steer.floorY;
        tintSharpness = SlotTintSharpness;

        // On the usual springs and speed cap a fast strike would trail metres behind its path and land late.
        if (steer.isFast)
        {
            stiffness = StrikeSpring;
            damping = StrikeDamping;
            maxSpeed = StrikeMaxSpeed;
            isWobbling = false;
        }
    }

    float gustHeat;
    goal += GustPush(goal, wasp, gustHeat);
    tint.a = max(tint.a, gustHeat);

    // A wasp that leaves the river's tail starts again at its head. Flying there would draw a straight, sparse
    // second river across every curve of the path, so it jumps instead; in the crowd at the head nobody sees it.
    if (isFlowing && HasLaneWrapped(wasp))
    {
        body.position = goal;
        body.velocity = Still;
    }

    if (isWobbling)
    {
        damping = _WobbleDamping;
    }

    float3 acceleration = stiffness * (goal - body.position) - 2.0 * damping * sqrt(stiffness) * body.velocity;
    body.velocity = LimitSpeed(body.velocity + acceleration * _DeltaTime, maxSpeed);
    body.position += body.velocity * _DeltaTime;
    Skim(floorY, body);

    body.stateTime += _DeltaTime;

    // A song's heat rises at once and cools at the tint's pace, so an impact flashes on the frame it lands.
    float4 blended = lerp(body.tint, tint, saturate(_DeltaTime * tintSharpness));
    if (slot != NoSlot)
    {
        blended.a = max(blended.a, tint.a);
    }

    body.tint = blended;
}

float DistanceOnGround(float3 from, float3 to)
{
    float2 offset = from.xz - to.xz;
    return length(offset);
}

// Where a revived wasp appears: the nearest standing hive to the Piper, or the Piper when none stands.
// During Hive Call with both hives standing, half come from each, so streams fly in from every hive.
float3 SpawnPoint(WaspStatic wasp)
{
    bool firstStands = _HiveA.w > 0.5;
    bool secondStands = _HiveB.w > 0.5;
    float3 spawn = _PiperPosition.xyz + Up * FlyHeight;

    if (firstStands || secondStands)
    {
        float3 hive = firstStands ? _HiveA.xyz : _HiveB.xyz;
        if (firstStands && secondStands)
        {
            bool isFirstNearer = DistanceOnGround(_HiveA.xyz, _PiperPosition.xyz) <= DistanceOnGround(_HiveB.xyz, _PiperPosition.xyz);
            bool takesFirst = _Form == FormHiveCall ? wasp.seed < 0.5 : isFirstNearer;
            hive = takesFirst ? _HiveA.xyz : _HiveB.xyz;
        }

        spawn = hive + Up * SpawnHeight;
    }

    return spawn;
}

float3 Scatter(WaspStatic wasp, float size)
{
    return (float3(wasp.phase01, wasp.level01, wasp.seed) - 0.5) * (2.0 * size);
}

void Revive(WaspStatic wasp, inout WaspDynamic body)
{
    body.position = SpawnPoint(wasp) + Scatter(wasp, SpawnScatter);
    body.velocity = Up * SpawnLift;
    body.state = (float)StateAlive;
    body.stateTime = 0.0;
}

// A lost wasp bursts away from the last hit, then falls.
void StartDying(WaspStatic wasp, inout WaspDynamic body)
{
    float3 away = body.position - _LastHit.xyz;
    float awayLength = length(away);
    float3 direction = awayLength > Tiny ? away / awayLength : RingOffset(wasp.phase01 * FullTurn, 1.0);
    direction = normalize(direction + Up * BurstLift);
    body.velocity = direction * (BurstSpeed * (BurstSpreadMin + BurstSpreadRange * wasp.level01));
    body.state = (float)StateDying;
    body.stateTime = 0.0;
}

void Fall(inout WaspDynamic body)
{
    body.velocity.y -= Gravity * _DeltaTime;
    body.velocity *= saturate(1.0 - FallDrag * _DeltaTime);
    body.position += body.velocity * _DeltaTime;

    float ground = _PiperPosition.y;
    if (body.position.y < ground)
    {
        body.position.y = ground;
        body.velocity = Still;
    }

    body.stateTime += _DeltaTime;
    if (body.stateTime >= _DyingSeconds)
    {
        body.state = (float)StateDead;
        body.stateTime = 0.0;
        body.velocity = Still;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_MaxWasps)
    {
        return;
    }

    WaspStatic wasp = _Static[index];
    WaspDynamic body = _Dynamic[index];
    bool isActive = index < (uint)max(_ActiveCount, 0);
    int state = StateOf(body);

    if (state == StateDead && isActive)
    {
        Revive(wasp, body);
        state = StateAlive;
    }
    else if (state == StateAlive && !isActive)
    {
        StartDying(wasp, body);
        state = StateDying;
    }

    if (state == StateAlive)
    {
        Fly(index, wasp, body);
    }
    else if (state == StateDying)
    {
        Fall(body);
    }

    _Dynamic[index] = body;
}

// Fills the dynamic buffer the first time: the active wasps in a loose cloud about the Piper, the rest dead.
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResetWasps(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_MaxWasps)
    {
        return;
    }

    WaspStatic wasp = _Static[index];
    bool isActive = index < (uint)max(_ActiveCount, 0);

    WaspDynamic body;
    body.position = _PiperPosition.xyz + Up * FlyHeight + Scatter(wasp, ResetScatter);
    body.state = isActive ? (float)StateAlive : (float)StateDead;
    body.velocity = Still;
    body.stateTime = 0.0;
    body.tint = TintOf(FormRiver, true);
    _Dynamic[index] = body;
}
