// Moves every wasp of the swarm, one thread per wasp. Spec: docs/specs/F-010-wasp-swarm.md, sections 9.2 to 9.4, and
// docs/specs/F-010-songs-v2.md, sections B and C (the song slots).
// SwarmGpuView sets every uniform and buffer below by name, so keep the names and layouts in step with it.
// The CPU never reads this data back. Gameplay only feeds in counts, the forms, the slots and a few positions.
//
// Two layers decide where a wasp flies:
// - The whole-swarm form (_Form): River, Hive Call, Colossus or Collapsed. It sweeps through the swarm as a wave, each
//   wasp easing from the old form into the new as the wave reaches it. The River follows the walking core along its
//   recent path and winds into a figure-eight round the standing one; each of its wasps reads the core's past (_History)
//   with its own delay, so a start, a stop or a turn reaches the head at once and runs down to the tail (songs-v2 Q).
// - Three song slots (Post, Guard, Strike). A live slot's squad, the wasps whose squad value lies in its [low, high),
//   flies that slot's song; every other wasp flies the whole-swarm form. A Gust pulse is then added on top of both.
// Adding a song: a form id below, one target function that returns a Steer from a SlotContext, and one case in
// SlotSteer. Nothing else in this file or in SwarmGpuView changes.

#pragma kernel Simulate
#pragma kernel ResetWasps

// Matches SwarmGpuView.ThreadsPerGroup.
#define THREAD_GROUP_SIZE 64

// Matches SwarmGpuView.SlotCount (one per DigitalStory.Logic.SongSlot: Post 0, Guard 1, Strike 2) and
// SwarmGpuView.VectorsPerSlot.
#define SLOT_COUNT 3
#define SLOT_VECTORS 3

// Matches SwarmGpuView.MostStings: the most stings one Sting cast sends.
#define STING_MOST 10

// Matches SwarmGpuView.HistorySamples: the core's past, one sample every _HistoryStep seconds, newest first.
#define HISTORY_SIZE 128

// A frame is cut into at most this many spring steps (SpringSteps); at the longest frame, 1/30 s, a 1/240 s step needs 8.
#define MOST_SPRING_STEPS 16

// Matches SwarmGpuView.FistCount and SwarmGpuView.VectorsPerFist: the giant's two hands, right then left.
#define FIST_COUNT 2
#define FIST_VECTORS 3

// Matches SwarmGpuView.ThrowCount and SwarmGpuView.VectorsPerThrow: the giant's thrown wasps, the latest four throws.
#define THROW_COUNT 4
#define THROW_VECTORS 4

// Matches SwarmGpuView.MostBones / 4: each bone's limb bits, four bones to a float4.
#define BONE_LIMB_VECTORS 16

// Matches DigitalStory.Logic.SwarmObstacles.MostObstacles: the tall props, nest trees and hives the free swarm flies round.
#define OBSTACLE_MOST 96

// 48 bytes, the same layout as SwarmGpuView.WaspStatic and the struct in WaspInstanced.shader. Written once by the CPU.
struct WaspStatic
{
    float seed;          // 0..1: phases the wings and spreads the halo
    float lane;          // 0..1: place along the river (0 at the core) and order in a form wave
    float ringAngle;     // radians: place around the river's cross-section
    float ringRadius;    // 0..1: share of the river radius
    float3 boneOffset;   // the wasp's point on the Colossus, in its bone's space
    float boneIndex;     // the Colossus bone, as a whole number
    float height01;      // 0 at the Colossus's feet, 1 at its head: order of the Colossus wave
    float level01;       // 0..1: height in the tornado and latitude on spheres
    float phase01;       // 0..1: spreads timings and directions
    float squad;         // 0..1: frac(0.5 + index x 0.7548777). Which slot's squad the wasp joins, and its rank there
};

// 48 bytes, the same layout as the struct in WaspInstanced.shader. Only this shader writes it.
struct WaspDynamic
{
    float3 position;
    float state;         // StateAlive, StateDying or StateDead
    float3 velocity;
    float stateTime;     // seconds in the current state
    float4 tint;         // rgb colour, a heat: how hot the wasp glows in WaspInstanced.shader and WaspGlow.shader
};

StructuredBuffer<WaspStatic> _Static;
RWStructuredBuffer<WaspDynamic> _Dynamic;
StructuredBuffer<float4> _Trail;          // newest first: xyz position, w metres from the newest point
StructuredBuffer<float4x4> _Bones;        // the Colossus's bones, local to world

int _MaxWasps;
int _ActiveCount;
int _TrailCount;
int _BoneCount;                           // 0 until the Colossus has bones and samples
int _Form;                                // the whole-swarm DigitalStory.Logic.SwarmForm: River, HiveCall, Colossus or Collapsed
int _PreviousForm;
int _EarlierForm;                         // the form before _PreviousForm, for a change that comes before the last one's wave is through

float _SimTime;                           // holds still while SwarmGpuView.Freeze holds the swarm
float _DeltaTime;                         // already capped at SwarmConfig.MaxDeltaTime; 0 while the swarm is frozen
float _FormStartTime;
float _PreviousFormStartTime;

float4 _CorePosition;
float4 _CoreForward;                     // flat and unit length
float4 _HiveA;                            // xyz position, w 1 while it stands
float4 _HiveB;
float4 _LastHit;

// The song slots, SLOT_VECTORS float4s per slot, in the order of DigitalStory.Logic.SongSlot:
//   [0] header: x the SwarmForm id, or -1 while the slot is empty; y the cast, in _SimTime; z low; w high (the squad range)
//   [1] p0: SlotState.ParamA, the song's own numbers (see each target function)
//   [2] p1: SlotState.ParamB, except w: the release, in _SimTime, or -1 while the song runs
float4 _Slots[SLOT_COUNT * SLOT_VECTORS];

// Each slot's colour, in the colour space the draw expects: the category colour of the song it holds.
float4 _SlotColors[SLOT_COUNT];

// The cast flash (SwarmGpuView.FlashSlot): x Post, y Guard, z Strike, 1 on the frames the slot's squad flashes, else 0.
float4 _SlotFlash;

// The running Sting's targets, one per sting (SwarmGpuView.SetStingTargets): xyz the target's feet, live; w -1 while the
// target lives, or the moment it fell, in _SimTime. Only the first _StingTargetCount are set.
float4 _StingTargets[STING_MOST];
int _StingTargetCount;

// The giant's hand launches (SwarmGpuView.SetFist, songs-v2 R), FIST_VECTORS float4s a hand, every time in _SimTime:
//   [0] xyz where the fist left the arm (the hand as it launched), w the launch, or -1 while no fist is out
//   [1] xyz the target on the ground, live, w the hit
//   [2] x the end of the regrow, y the moment the giant ended with the fist still flying (-1 while it did not),
//       z the hit's radius
float4 _Fists[FIST_COUNT * FIST_VECTORS];

// The Colossus bones each hand's fist is made of, its forearm, hand and fingers: x to y the right's, z to w the left's;
// -1 for none.
float4 _FistBones;

// The giant's thrown wasps (SwarmGpuView.Throw, songs-v2 W), THROW_VECTORS float4s a throw, a ring of the latest:
//   [0] xyz the move's centre on the ground (the giant's feet at the hit, or the leap's landing), w the hit in _SimTime,
//       or -1 for none
//   [1] xyz the giant's facing, flat and unit, w the shape (DigitalStory.Logic.ColossusThrowShape)
//   [2] x the limbs thrown (DigitalStory.Logic.ColossusLimb bits), y the share of their wasps that leave, z where this
//       throw's band of wasps starts (0..1, moved on at each throw so quick blows throw fresh wasps), w seconds until back
//   [3] x the spread in radians, y metres the wasps fly out, z seconds they fly out, w the shape's own number (the
//       spiral's spin in radians a second, or the crater's second ring share)
float4 _Throws[THROW_COUNT * THROW_VECTORS];

// Each Colossus bone's limb bits (DigitalStory.Logic.ColossusLimb), bone b at _BoneLimbs[b / 4][b % 4].
float4 _BoneLimbs[BONE_LIMB_VECTORS];

// The colour a thrown wasp or a flying fist burns, in the colour space the draw expects, and the seconds it takes to turn
// to it as it leaves the body.
float4 _ThrowColor;
float _ThrowRedSeconds;

// The Gust pulse: xy the centre on the ground (world x and z), z its start in _SimTime, w its radius (0: no gust yet).
float4 _Pulse;

// Colours, already in the colour space the draw expects. A wasp in the river (or the collapsed swarm) shows the river's
// colour; in Hive Call or the Colossus it shows the cast colour. A form change sweeps through the swarm as a wave, so a
// wasp the wave has not reached yet still shows the colour of the form before.
float4 _RiverColor;
float4 _CastColor;
float4 _PreviousCastColor;

// From SwarmConfig.
float _RiverSpring;
float _RiverDamping;
float _ShapeSpring;
float _ShapeDamping;
float _WobbleDamping;
float _WobbleSeconds;
float _FormWaveSeconds;
float _FlowSpeed;
float _RiverLength;
float _RiverRadius;
float _MeanderAmplitude;
float _DyingSeconds;

// The figure-eight the free swarm flies while the core stands. The sizes are SwarmConfig's, already times the level's
// size scale; SwarmGpuView keeps the rest.
float _EightShare;                        // 0 while the swarm is a river, 1 once it is wound into the eight
float _EightRadius;                       // metres from the crossing to each lobe's tip, on the ground
float _EightHeight;                       // metres above the core the crossing flies
float _EightTilt;                         // radians the eight's plane tilts, so one lobe rises as the other dips
float _EightThickness;                    // metres the ribbon spreads to each side of its line
float _EightLapSeconds;                   // seconds a wasp takes round the whole loop
float _EightYaw;                          // radians on the ground (as RingOffset) the first lobe points, turning slowly
float _EightSeconds;                      // seconds the eight has shown since the swarm was last a river

// The core's past for the free swarm (songs-v2 Q), from CoreHistory: sample j is the moment j x _HistoryStep seconds ago,
// x the metres the core has travelled since then, y how far the swarm was wound into the eight then (_EightShare), and
// z how far the eight had swung then, less its swing now (radians, added to _EightYaw).
float4 _History[HISTORY_SIZE];
float _HistoryStep;
float _TrailLead;                         // metres along the path from the newest trail point to the core
float _RiverReach;                        // metres the core has walked since the swarm was last wound into the eight
float _FollowDelay;                       // seconds the river's tail lags behind its head (SwarmConfig.FollowDelaySeconds)
float _FollowDelayPower;                  // how the delay grows from the head to the tail
float _WaveJitter;                        // share of a wasp's place in a wave taken from its seed
float _TailWidth;                         // the river's width at its tail, as a share of its head's
float _FormBlendSeconds;                  // seconds one wasp eases from the old whole-swarm form into the new
float _SpringStep;                        // the longest spring step, in seconds

// Plan section X: what the free swarm flies round. Set once a match (SwarmGpuView.SetObstacles), never per frame.
float4 _Obstacles[OBSTACLE_MOST];         // x and z of the middle on the ground, radius, height of the top
int _ObstacleCount;
float _ObstacleMargin;                    // metres outside the radius the goals keep (SwarmConfig.ObstacleMargin)
float _ObstacleLead;                      // metres before the edge where the stream starts to part
float _ObstacleClose;                     // metres past the edge by which it has closed again
float _ObstacleStrength;                  // how much of the bend the wasps fly, 0 to 1
float _ObstacleSpeedUp;                   // how much faster a wasp flies on its way round, as a share

static const float FullTurn = 6.28318530718;
static const float HalfTurn = 3.14159265359;
static const float QuarterTurn = 1.57079632679;
static const float GoldenAngle = 2.39996322973;  // radians between neighbours on a Fibonacci spiral
static const float GoldenShare = 0.61803398875;
static const float Sqrt3 = 1.73205080757;
static const float HalfSqrt3 = 0.86602540378;
static const float3 Up = float3(0.0, 1.0, 0.0);
static const float3 Still = float3(0.0, 0.0, 0.0);
static const float Tiny = 0.0001;

// Wasp states, stored as floats in WaspDynamic.state.
static const int StateAlive = 0;
static const int StateDying = 1;
static const int StateDead = 2;

// Form ids, the same numbers as DigitalStory.Logic.SwarmForm. River, HiveCall, Colossus and Collapsed are whole-swarm
// forms; the rest run in a slot.
static const int FormRiver = 0;
static const int FormDome = 1;
static const int FormSting = 2;
static const int FormTornado = 3;
static const int FormGust = 4;
static const int FormHiveCall = 5;
static const int FormColossus = 6;
static const int FormCollapsed = 7;
static const int FormMeteor = 8;
static const int FormHydra = 9;
static const int FormScythe = 10;
static const int FormLance = 11;
static const int FormNest = 12;
static const int FormHoneycomb = 13;

static const int NoSlot = -1;
static const float NoFloor = -100000.0;  // a Steer's floor when the wasp may fly as low as it likes

// Enough halving steps for a trail of 4,096 points.
static const int TrailSearchSteps = 12;

// The look of each form, from spec 9.3 and songs-v2 section B. SwarmConfig does not hold these; move one there if it
// needs tuning. The shapes are sized for at most 4,000 wasps of 0.24 m: wide and thick enough that the wasps keep apart.
static const float FlyHeight = 1.0;              // metres above the ground the river flows
static const float CrossSectionHeight = 0.45;    // the river's height as a share of its width (the eight's is EightSectionHeight). Flat, so
                                                 // the wasps spread out where the camera above sees them one by one
                                                 // instead of stacking into one glowing band
static const float RiverSwirl = 0.6;             // radians per second the river's and the eight's cross-section turns
static const float MeanderWaveNumber = 1.4;      // radians per metre along the river, a wave about 4.5 m long
static const float MeanderSpeed = 0.9;           // radians per second
// Raz: the river is an organic body, thin at the head, a thick swirling belly, thin again at the tail, and a big swarm
// bunches up into a cloud instead of stretching into a snake.
static const float RiverHeadWidth = 0.2;         // share of the river radius at the head, by the core
static const float RiverTailWidth = 0.15;        // share at the tail
static const float RiverBellyWidth = 1.15;       // share at the thickest part
static const float RiverBellyAt = 0.35;          // where along the river (0 head, 1 tail) it is thickest
static const float RiverBulge = 0.2;             // how much the rolling bulges swell and pinch the body
static const float RiverBulgeWaves = 2.5;        // bulges along the whole river
static const float RiverBulgeSpeed = 3.0;        // radians per second the bulges roll toward the tail
static const float RiverBellySwirl = 1.8;        // extra swirl in the thickest part, as a share of RiverSwirl
static const float RiverBreath = 0.18;           // how much each wasp drifts in and out of the body on its own
static const float RiverBellyPack = 0.9;         // how much the belly's wasps crowd toward its middle line, so it reads dense
static const float RiverBellyCrowd = 0.7;        // 0 spreads the wasps evenly along the river; up to 1 gathers them into the
                                                 // belly, so it is the densest part and the head and tail thin out
// A big swarm reads as a snake if it only gets longer, so as it grows it gets shorter, much fatter and looser instead:
// a rounded cloud of wasps with a short tail, each wasp drifting round its place on its own.
static const float CrowdFrom = 0.0;             // wasps at which the swarm starts to bunch up
static const float CrowdFull = 700.0;            // wasps at which it is fully a cloud
static const float CrowdLength = 0.4;            // share of the river's length left at full crowd
static const float CrowdRadius = 3.0;            // times the river's radius at full crowd
static const float CrowdEnds = 0.85;             // how far the thin head and tail fill out toward the belly at full crowd
static const float CrowdScatter = 1.6;           // metres each wasp wanders round its place at full crowd
static const float CrowdLift = 1.4;             // metres the fat cloud rises, so its lower half stays above the grass
static const float CrowdScatterSpeed = 0.9;      // how fast that wander turns
static const float RiverHeadGap = 0.5;           // metres behind the core where the river starts, so its head shows where
                                                 // the core leads it
static const float HaloRadius = 0.9;
static const float HaloHeight = 2.2;             // metres over the core
static const float HaloThickness = 0.25;
static const float HaloSpin = 2.5;               // radians per second

// The figure-eight (EightTarget). The river winds into it head first: each wasp reads the swarm's wound share its own
// delay late (_History), so a stop draws the eight from the crossing instead of pulling the whole river across the core
// at once. The lowest wasp of the low lobe keeps EightLowest metres over the ground.
static const float EightLowest = 0.35;

// The wasps linger where the eight crosses itself and hurry round the lobes' tips: their place round the loop runs
// 1 - EightCrossingDwell as fast over the crossing as on average, and 1 + EightCrossingDwell as fast at the tips. So the
// crossing over the core, the one thing the player reads the core by, is the densest part of the ribbon, and a big
// swarm's lobes stay airy instead of a solid band. Below 1, so the wasps never stop or turn back.
static const float EightCrossingDwell = 0.35;

// The wasps passing over the core glow a little warmer, up to EightCrossingGlow more than the river's RiverGlow within
// EightCrossingGlowRadius metres of it on the ground, fading out from there, so the knot where the eight crosses itself
// catches the eye like the brightest part of the ribbon. Half that while a slot holds a song, as the river quiets.
static const float EightCrossingGlow = 0.3;

// The eight's ribbon is taller than the river's flat band, a rope in the air, so a big swarm's wasps spread through its
// depth instead of packing into one sheet, and the loop reads as a shape in 3D. Still wider than tall, so a young swarm's
// wasps keep apart where the camera above sees them.
static const float EightSectionHeight = 0.7;
static const float EightCrossingGlowRadius = 0.9;

// Every slot song launches and returns with the same two blends (songs-v2 B). Peel: a wasp leaves the base form over
// PeelSeconds, starting PeelStagger later the further back along the river it was at the cast, so the river's head
// leaves first and a launch is a ribbon, never a pop. A song that hits sooner than the ribbon ends squeezes it with
// PeelBy, so its whole squad is in the shape on the hit's frame. Home: after the release it eases back over
// HomeSeconds, starting HomeStagger later the higher its order. The plan's Home is 0.5 s plus 0.25 s; it is shortened
// so the last wasp is home when the slot's 0.6 s return beat ends and the slot empties, instead of springing the last
// fifth of the way. The owner felt the songs answer late, so the launch is half the plan's: the head leaves the river
// in 0.15 s, and the tail 0.15 s after it.
static const float PeelSeconds = 0.15;
static const float PeelStagger = 0.15;
static const float HomeSeconds = 0.4;
static const float HomeStagger = 0.2;

// Seconds a song's clock here runs ahead of the rules' clock. The view sends the cast as a time on its own clock, and
// taking it back off that clock, many seconds into a run, loses a few microseconds to float rounding: a beat the rules
// reached on this frame (the Hydra's bite at 0.7 s, say) could then fall just short of it here, and its flash would
// come a frame after its damage. A millisecond is far too short to see.
static const float BeatSlack = 0.001;

// Strikes fly on a stiff spring so a fast wasp keeps to its path; held shapes use SwarmConfig's shape spring.
static const float StrikeSpring = 400.0;         // stable to dt 1/30
static const float StrikeDamping = 0.8;
static const float StrikeMaxSpeed = 70.0;        // metres per second, enough for an 18 m dive from 12 m up in 0.5 s
static const float MaxSpeed = 25.0;              // metres per second, so a far target never fires a wasp across the map.
                                                 // WaspInstanced.shader draws a wasp faster than this as a streak.
// A strike that crosses its whole reach in a blink (the Lance's shot, the Hydra's snap, the Scythe's sweep, the Nest's
// burst) is pinned to its path (Steer.pin) instead: even the strike spring lags metres behind a path that fast and
// lands late, and cuts inside a fast sweep. The pin eases in over this long before the blink starts, while the shape
// still holds, so a wasp a little off its path catches up instead of jumping. While it eases in, Fly holds the step to
// StrikeMaxSpeed, so a wasp still far off its path flies there as a streak instead of jumping across in three frames.
static const float PinEaseSeconds = 0.05;

// The heat curve of a strike (songs-v2 B): from WindUpStartHeat to WindUpHeat through the wind-up, ImpactHeat for
// ImpactSeconds from the impact, then HoldHeat. ImpactHeat is the only heat that turns a wasp white in the draw.
static const float WindUpStartHeat = 0.4;
static const float WindUpHeat = 0.8;
static const float ImpactHeat = 1.0;
static const float ImpactSeconds = 0.15;
static const float HoldHeat = 0.5;

// The heat of the whole-swarm forms and the held shapes, 0 to 1: how much brighter than the calm river the wasps and
// their glow burn, and how much their eyes light up.
static const float RiverGlow = 0.1;
static const float RiverQuietGlow = 0.05;        // while any slot holds a song, so the squads stand out
static const float DomeGlow = 0.4;
static const float GustGlow = 0.4;
static const float HiveCallGlow = 0.6;
static const float ColossusGlow = 0.4;

// Sting (Strike slot). See StingSteer for what it reads.
static const float StingFlightSeconds = 0.35;    // StingSong.ArriveSeconds's default, the arrival while p0.w is 0
static const float StingFanMeters = 1.2;         // metres the arcs of several stings bow apart sideways at their top, so
                                                 // two stings on one beekeeper read as two
static const float StingArcHeight = 1.2;         // metres the arc rises, plus StingArcRise per metre of distance
static const float StingArcRise = 0.25;
static const float StingChestHeight = 1.0;       // metres above the target's feet
static const float StingHeadWidth = 0.08;        // metres the comet's head spreads; the tail adds up to StingTailWidth
static const float StingTailWidth = 0.6;
static const float StingWrapStart = 0.75;        // share of its flight after which a wasp turns from the arc onto its ring
// The plan's 0.8 m rings (squeezing to 0.55 m) read as one blob once 600 to 740 wasps of WaspLength sit on them, so
// they are drawn wider and thinner here, in the same proportions.
static const float StingRingRadius = 1.1;
static const float StingSqueezeRadius = 0.75;
static const float StingTickSeconds = 0.25;      // the rings squeeze and flare once per tick from the head's arrival
static const float StingSqueezeSeconds = 0.2;    // seconds a squeeze takes to ease back out
static const float StingTickHeat = 0.9;
static const float StingRingTilt = 0.959931;     // 55 degrees up from the ground (35 from upright), so the rings cross like a gyroscope's
static const float StingRingSpin = 5.0;          // radians per second, the two rings turning against each other
static const float StingRingTube = 0.12;         // metres each ring's band is thick, so the wasps keep apart
static const float StingPopRadius = 1.6;
static const float StingPopSeconds = 0.15;
static const float StingHomeSeconds = 0.3;       // the flight home along the reversed arc, after the pop
static const float StingHomeStagger = 0.15;

// Tornado (Strike slot). p0: (outer radius, height, spin, hit seconds). p1.x: the wall radius (Eye of the Storm moves it).
static const float DefaultTornadoRadius = 5.0;
static const float TornadoInnerRadius = 1.5;
static const float TornadoHeight = 3.0;
static const float TornadoSpin = 6.0;            // radians per second until the hit
static const float TornadoHitSeconds = 0.3;
static const float TornadoSpinUp = 1.5;          // the spin after the hit, as a share of the spin before: 6 to 9 rad/s
static const float TornadoSpinUpSeconds = 0.3;
static const float TornadoFunnelBottom = 0.8;    // the column's radius at the bottom and top, as a share
static const float TornadoFunnelTop = 1.25;
static const float TornadoWallShare = 0.75;      // share of the wasps in the column's wall; the rest, the river's head
                                                 // at the cast, are flung out, since they reach the core first
static const float TornadoWallThickness = 0.7;   // metres
static const float TornadoBaseHeight = 0.2;
static const float TornadoTwist = 3.0;           // radians the spiral turns from bottom to top
static const float TornadoSkirtRadius = 1.5;     // the skirt the wasps wait in until the growing top passes them
static const float TornadoSkirtHeight = 0.3;
static const float TornadoClimbBand = 0.6;       // metres below its place the top is when a wasp starts up the column
static const float TornadoShockSeconds = 0.12;   // the flung share's goal takes this long to reach the outer radius
static const float TornadoShockLead = 0.22;      // seconds before the hit it sets off, so with the strike spring's lag
                                                 // the ring reaches the beekeepers on the hit's frame (stepped at 60 fps)
static const float TornadoShockInner = 0.85;     // the shock ring's inner edge, as a share of the outer radius
static const float TornadoShockHeight = 0.5;     // knee high
static const float TornadoShockSpin = 1.0;       // radians per second the shock ring turns. At the column's spin its 5 m
                                                 // ring would need 45 m/s, past MaxSpeed, and the wasps would cut inside it.
static const float TornadoUnwind = 1.0;          // the radius grows by this share as the column unwinds into the river

// Meteor (Strike slot). p0: (impact point xyz, live until the dive; height). p1.xyz: (rise, dive, radius) in seconds,
// seconds and metres. The first diver lands at rise + dive, with the damage.
static const float DefaultMeteorRadius = 3.0;    // the reach when p1.z is 0, MeteorSong.Radius's default
static const float MeteorMarkerShare = 0.9;      // the wasps ranked from here up draw the target ring instead of diving
static const float MeteorMarkDropSeconds = 0.3;  // they drop from the ball to the ring when their climb ends
static const float MeteorMarkSpin = 1.2;         // radians per second the target ring turns
static const float MeteorClimbStagger = 0.3;     // share of the rise over which the climbers set off, lowest rank first
static const float MeteorClimbShare = 0.55;      // share of the rise one wasp's climb takes; the rest is the hang
static const float MeteorGatherShare = 0.5;      // share of its climb a wasp takes to leave the river for the column
static const float MeteorSpreadShare = 0.7;      // from this share of its climb the column opens into the ball
static const float MeteorColumnRadius = 0.45;
static const float MeteorColumnSpin = 4.0;       // radians per second
static const float MeteorBallRadius = 1.6;
static const float MeteorHeartRadius = 1.0;      // the ball tightens to this in the heartbeat before the dive
static const float MeteorHeartbeatSeconds = 0.2;
static const float MeteorBallSpin = 1.5;         // radians per second
static const float MeteorDiveStagger = 0.15;     // seconds from the first diver to the last, so the dive draws streaks
static const float MeteorDiveEase = 0.5;         // the dive's starting speed as a share of its mean; it ends at 2 minus this
