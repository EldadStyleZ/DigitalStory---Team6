// What one slot hands its target function for one wasp.
struct SlotContext
{
    uint index;
    WaspStatic wasp;
    float3 baseGoal;     // where the whole-swarm form wants the wasp: every launch peels from it, every return goes to it
    float u;             // 0..1: the wasp's rank in its squad, evenly spread
    float lane;          // 0..1: its place along the river at the cast, 0 at the head
    float seconds;       // since the cast
    float released;      // seconds since the release, or -1 while the song runs
    float4 p0;           // SlotState.ParamA
    float4 p1;           // SlotState.ParamB; w is the release time, already turned into `released`
};

// What a target function decides for one wasp.
struct Steer
{
    float3 goal;
    float share;         // 0: flies, glows and is coloured like the base form; 1: like the song
    float heat;          // the song's heat
    float floorY;        // a wasp below this skims along it, or NoFloor
    bool isFast;         // on the strike spring and the strike speed cap
    float pin;           // 0: the springs fly the wasp; 1: it is placed on its goal each frame, so a blink strike lands on
                         // its frame; between, eased that far from the spring's place toward the goal
};

int StateOf(WaspDynamic body)
{
    return (int)(body.state + 0.5);
}

// The header of a slot: x form or -1, y cast time, z low, w high.
float4 SlotHeader(int slot)
{
    return _Slots[slot * SLOT_VECTORS];
}

bool IsSlotLive(float4 header)
{
    return header.x >= 0.0;
}

bool IsAnySlotLive()
{
    bool isLive = false;

    [unroll]
    for (int slot = 0; slot < SLOT_COUNT; slot++)
    {
        if (IsSlotLive(SlotHeader(slot)))
        {
            isLive = true;
        }
    }

    return isLive;
}

// The slot whose squad holds this wasp, or NoSlot. The bands never overlap, so at most one matches.
int SlotOf(WaspStatic wasp)
{
    int found = NoSlot;

    [unroll]
    for (int slot = 0; slot < SLOT_COUNT; slot++)
    {
        float4 header = SlotHeader(slot);
        if (IsSlotLive(header) && wasp.squad >= header.z && wasp.squad < header.w)
        {
            found = slot;
        }
    }

    return found;
}

// 1 on the frames the slot's squad flashes for its cast, else 0.
float SlotFlashOf(int slot)
{
    float flash = _SlotFlash.z;
    if (slot == 0)
    {
        flash = _SlotFlash.x;
    }
    else if (slot == 1)
    {
        flash = _SlotFlash.y;
    }

    return flash;
}

// One exit with the result set first, so the compiler sees it initialised on every path.
float GlowOf(int look)
{
    float glow = IsAnySlotLive() ? RiverQuietGlow : RiverGlow;
    if (look == FormHiveCall)
    {
        glow = HiveCallGlow;
    }
    else if (look == FormColossus)
    {
        glow = ColossusGlow;
    }

    return glow;
}

// The colour and heat a wasp of the whole-swarm form heads for. hasSwitched says whether the form's wave has reached the
// wasp, the same test that picks its form, so the colour flows through the swarm with the motion.
float4 TintOf(int look, bool hasSwitched)
{
    float3 color = hasSwitched ? _CastColor.rgb : _PreviousCastColor.rgb;
    if (look == FormRiver || look == FormCollapsed)
    {
        color = _RiverColor.rgb;
    }

    return float4(color, GlowOf(look));
}

float3 RingOffset(float angle, float radius)
{
    return float3(cos(angle) * radius, 0.0, sin(angle) * radius);
}

// A point on the unit sphere, spread by two of the wasp's random numbers.
float3 SphereDirection(WaspStatic wasp)
{
    float latitude = 1.0 - 2.0 * wasp.level01;
    float spread = sqrt(saturate(1.0 - latitude * latitude));
    return RingOffset(wasp.phase01 * FullTurn, spread) + Up * latitude;
}

// The flat, unit direction from one point to another, or the core's facing when the two are on the same spot.
float3 FlatDirection(float3 from, float3 to)
{
    float3 along = to - from;
    along.y = 0.0;
    float alongLength = length(along);
    return alongLength > Tiny ? along / alongLength : _CoreForward.xyz;
}

float3 Bezier(float3 start, float3 control, float3 end, float progress)
{
    float rest = 1.0 - progress;
    return rest * rest * start + 2.0 * rest * progress * control + progress * progress * end;
}

// The Bezier's rate of change per unit of progress.
float3 BezierSlope(float3 start, float3 control, float3 end, float progress)
{
    return 2.0 * (1.0 - progress) * (control - start) + 2.0 * progress * (end - control);
}

// How far the strike spring lags a goal moving at one metre per second. Setting the goal that far ahead along a fast
// path lets the wasp keep to the path instead of trailing it, so it lands on time.
float StrikeLeadSeconds()
{
    return 2.0 * StrikeDamping / sqrt(StrikeSpring);
}

// The point `distance` metres back along the core's trail, and the way the trail runs there (toward the core).
// Safe with no trail points (the core) and with one (that point).
void SampleTrail(float distance, out float3 position, out float3 direction)
{
    position = _CorePosition.xyz;
    direction = _CoreForward.xyz;

    if (_TrailCount <= 0)
    {
        return;
    }

    if (_TrailCount == 1)
    {
        position = _Trail[0].xyz;
        return;
    }

    int low = 0;
    int high = _TrailCount - 1;
    float clamped = clamp(distance, 0.0, _Trail[high].w);

    [loop]
    for (int step = 0; step < TrailSearchSteps; step++)
    {
        if (high - low > 1)
        {
            int middle = (low + high) >> 1;
            if (_Trail[middle].w <= clamped)
            {
                low = middle;
            }
            else
            {
                high = middle;
            }
        }
    }

    float4 newer = _Trail[low];
    float4 older = _Trail[high];
    float span = older.w - newer.w;
    float blend = span > Tiny ? saturate((clamped - newer.w) / span) : 0.0;
    position = lerp(newer.xyz, older.xyz, blend);

    float3 along = newer.xyz - older.xyz;
    along.y = 0.0;
    float alongLength = length(along);
    if (alongLength > Tiny)
    {
        direction = along / alongLength;
    }
}

float TrailLength()
{
    return _TrailCount > 0 ? _Trail[_TrailCount - 1].w : 0.0;
}

// The point `distance` metres back along the core's path from the core itself. The core runs up to a trail spacing ahead
// of the newest trail point (_TrailLead), so the path starts with that stretch. Measured from the core, a place in the
// river glides along with it instead of jumping a spacing forward each time the trail stores a point.
void SamplePath(float distance, out float3 position, out float3 direction)
{
    SampleTrail(max(distance - _TrailLead, 0.0), position, direction);
    if (distance < _TrailLead)
    {
        position = lerp(_CorePosition.xyz, position, distance / max(_TrailLead, Tiny));
    }
}

// The wasp's place in a wave through the free swarm, 0 first and 1 last: its order (its place along the river, or up the
// Colossus), made a little ragged by its seed so a wave's front is a flock's, not a ruled line.
float WaveRank(float order, WaspStatic wasp)
{
    return saturate(order * (1.0 - _WaveJitter) + wasp.seed * _WaveJitter);
}

// Seconds this wasp follows the core late: none at the river's head, _FollowDelay at its tail, growing as a power so most
// of the head answers at once and the tail stretches.
float FollowDelayOf(float flowLane, WaspStatic wasp)
{
    return _FollowDelay * pow(WaveRank(flowLane, wasp), _FollowDelayPower);
}

// The core's past `delay` seconds ago, between the two samples about it.
float4 HistoryAt(float delay)
{
    float place = clamp(delay / max(_HistoryStep, Tiny), 0.0, HISTORY_SIZE - 1.0);
    int newer = min((int)place, HISTORY_SIZE - 2);
    return lerp(_History[newer], _History[newer + 1], place - newer);
}

// The wasp's place along the river at a moment: 0 at the head, by the core, 1 at the tail.
float FlowLaneAt(WaspStatic wasp, float time)
{
    return frac(wasp.lane + time * _FlowSpeed);
}

// Metres from the core to a point, on the ground.
float FlatReach(float3 position)
{
    return length(position.xz - _CorePosition.xz);
}

// Metres from one point to another, on the ground.
float FlatReachFrom(float3 center, float3 position)
{
    return length(position.xz - center.xz);
}

// The river and the eight blend in a straight line. SwarmGpuView lays the eight across the way the core last walked, so
// the river behind it winds out to the lobes at its sides; but the core may then walk off any way, and a straight line
// from a lobe ahead of it to the river behind it runs across the eight's middle. This keeps a blended goal at least
// leastReach from that middle, the nearer of its two ends, so it swings round it at that distance instead of piling
// through it. Both ends of the blend are unchanged, and a goal bound for the crossing, at the middle, still gets there.
float3 AroundPoint(float3 goal, float3 center, float leastReach)
{
    float2 away = goal.xz - center.xz;
    float reach = length(away);
    if (reach < leastReach && reach > Tiny)
    {
        goal.xz = center.xz + away * (leastReach / reach);
    }

    return goal;
}

// The wasp's place round the eight's loop: 0 and 0.5 at the crossing, 0.25 and 0.75 at the lobes' tips. Each time the
// river turns into the eight, the loop starts with the river's order, so the river's head is at the crossing, by the
// core; from then on the eight runs round once every _EightLapSeconds, faster than the river flows.
float EightLaneAt(float flowLane)
{
    float lapsPerSecond = 1.0 / max(_EightLapSeconds, Tiny);
    return frac(flowLane + _EightSeconds * (lapsPerSecond - _FlowSpeed));
}

// While the core stands, the free swarm flows round a figure-eight in the air: a lemniscate of Gerono on the ground
// (along = r sin t, across = r sin t cos t), whose plane tilts _EightTilt about the line across it, so one lobe rises
// as the other dips. It crosses itself _EightHeight over the core, so the core reads without any marker. Each wasp keeps
// its place in the ribbon's flat cross-section, as in the river, so the ribbon has thickness.
float3 EightTarget(WaspStatic wasp, float eightLane, float3 middle, float yaw, out float2 flow)
{
    // The loop crosses itself twice a lap, so the lingering repeats twice a lap.
    float loop = eightLane - EightCrossingDwell * sin(eightLane * 2.0 * FullTurn) / (2.0 * FullTurn);
    float loopSin;
    float loopCos;
    sincos(loop * FullTurn, loopSin, loopCos);
    float along = _EightRadius * loopSin;
    float across = _EightRadius * loopSin * loopCos;
    float alongSlope = _EightRadius * loopCos;
    float acrossSlope = _EightRadius * (loopCos * loopCos - loopSin * loopSin);

    float tiltSin;
    float tiltCos;
    sincos(_EightTilt, tiltSin, tiltCos);
    float3 axis = RingOffset(yaw, 1.0);
    float3 aside = cross(Up, axis);
    float3 center = middle + axis * (along * tiltCos) + aside * across + Up * (_EightHeight + along * tiltSin);
    float3 tangent = axis * (alongSlope * tiltCos) + aside * acrossSlope + Up * (alongSlope * tiltSin);
    float flatSlope = length(tangent.xz);
    flow = flatSlope > Tiny ? tangent.xz / flatSlope : float2(0.0, 0.0);

    // The ribbon's cross-section: wide across the loop and less tall (EightSectionHeight).
    float3 side = cross(Up, tangent);
    float sideLength = length(side);
    side = sideLength > Tiny ? side / sideLength : aside;
    float3 lift = cross(tangent, side);
    float liftLength = length(lift);
    lift = liftLength > Tiny ? lift / liftLength : Up;

    float angle = wasp.ringAngle + _SimTime * RiverSwirl;
    float radius = wasp.ringRadius * _EightThickness;
    float3 goal = center + side * (cos(angle) * radius) + lift * (sin(angle) * radius * EightSectionHeight);
    goal.y = max(goal.y, middle.y + EightLowest);
    return goal;
}

// The extra heat of a free wasp heading for a goal over the core while the swarm is wound into the eight (EightCrossingGlow).
float EightCrossingHeat(float3 goal)
{
    float nearness = 1.0 - smoothstep(0.0, EightCrossingGlowRadius, FlatReach(goal));
    float quiet = IsAnySlotLive() ? 0.5 : 1.0;
    return EightCrossingGlow * _EightShare * nearness * quiet;
}

// The wasp's place in the river behind the walking core: `back` metres further back along the path than its lane's place,
// for the metres the core has walked within this wasp's delay. The river is drawn out of the eight it was wound into, so
// it uses only the path walked since then (_RiverReach): its lanes squeeze into that much, and a walk off after a stand
// never lays it back along the way the core came. The ribbon thins toward its tail (_TailWidth).
float3 RiverPoint(WaspStatic wasp, float flowLane, float back, out float2 flow)
{
    // Even a small swarm is already partly a cloud, so it never reads as a snake.
    float crowd = max(smoothstep(CrowdFrom, CrowdFull, (float)_ActiveCount), 0.45);
    // The wasps still flow head to tail at one pace, but they slow through the belly, so more of them are in it at once.
    float bellyPhase = FullTurn * RiverBellyAt;
    flowLane = saturate(flowLane - RiverBellyCrowd * (sin(FullTurn * flowLane - bellyPhase) + sin(bellyPhase)) / FullTurn);
    float trailLength = TrailLength() + _TrailLead;
    float span = max(min(_RiverLength * lerp(1.0, CrowdLength, crowd), trailLength), RiverHeadGap) - RiverHeadGap;
    float lanePlace = RiverHeadGap + span * flowLane;
    float room = max(_RiverReach - back - RiverHeadGap, 0.0);
    float squeeze = span > Tiny ? saturate(room / span) : 1.0;

    float3 center;
    float3 direction;
    SamplePath(back + RiverHeadGap + span * flowLane * squeeze, center, direction);
    float3 side = cross(Up, direction);
    flow = direction.xz;

    // Thin, thick and wild, thin again: a smooth rise to the belly and a longer fall to the tail.
    float rise = smoothstep(0.0, RiverBellyAt, flowLane);
    float fall = 1.0 - smoothstep(RiverBellyAt, 1.0, flowLane);
    float belly = rise * fall;
    float width = lerp(lerp(RiverHeadWidth, RiverTailWidth, step(RiverBellyAt, flowLane)), RiverBellyWidth, belly);
    width = lerp(width, RiverBellyWidth, CrowdEnds * crowd * (1.0 - belly));
    float bulge = 1.0 + RiverBulge * belly * sin(flowLane * RiverBulgeWaves * FullTurn - _SimTime * RiverBulgeSpeed);
    float breath = 1.0 + RiverBreath * sin(_SimTime * (1.3 + wasp.seed * 1.7) + wasp.seed * FullTurn);

    float angle = wasp.ringAngle + _SimTime * RiverSwirl * (1.0 + RiverBellySwirl * belly);
    float packed = lerp(wasp.ringRadius, wasp.ringRadius * wasp.ringRadius, RiverBellyPack * belly);
    float radius = packed * _RiverRadius * lerp(1.0, CrowdRadius, crowd) * width * bulge * breath;
    // A cloud does not slither: the side-to-side sway fades as the swarm bunches up.
    float meander = _MeanderAmplitude * (1.0 - 0.85 * crowd) * sin(lanePlace * MeanderWaveNumber - _SimTime * MeanderSpeed);
    float3 river = center + Up * (FlyHeight + sin(angle) * radius * CrossSectionHeight) + side * (cos(angle) * radius + meander);
    float wander = _SimTime * CrowdScatterSpeed * (0.6 + wasp.phase01) + wasp.seed * 40.0;
    float3 scatter = float3(sin(wander), 0.5 * sin(wander * 1.37 + 2.0), cos(wander * 0.83 + wasp.squad * FullTurn));
    river += scatter * (CrowdScatter * crowd * (0.4 + wasp.ringRadius));
    river += Up * (CrowdLift * crowd);
    return river;
}

// The free swarm's goal (songs-v2 Q): the river behind the walking core, the eight round the standing one, or a blend
// while it winds from one into the other. Each wasp reads the core's past its own delay ago: the metres the core has
// walked since put its river place that much further back along the path; the eight it winds into stands where the core
// stood then, turned as the eight was then; and the swarm's wound share then says how far it is wound. So a start
// unwinds the eight from the river's head and draws the river out of it, a stop lets the tail flow on to the core and
// curl in last, and a turn bends down the river. `wound` says how far this wasp is wound into the eight.
// The eight also shows while the trail is still too short to hold a river, at the start of a run; SwarmGpuView works
// that into _EightShare.
float3 RiverTarget(WaspStatic wasp, out float wound, out float2 flow)
{
    float flowLane = FlowLaneAt(wasp, _SimTime);
    float4 past = HistoryAt(FollowDelayOf(flowLane, wasp));
    wound = smoothstep(0.0, 1.0, past.y);

    float3 middle = _CorePosition.xyz;
    if (past.x > Tiny)
    {
        float3 direction;
        SamplePath(past.x, middle, direction);
    }

    float3 river = middle;
    float2 riverFlow = float2(0.0, 0.0);
    if (wound < 1.0)
    {
        river = RiverPoint(wasp, flowLane, past.x, riverFlow);
    }

    float3 eight = middle;
    float2 eightFlow = float2(0.0, 0.0);
    if (wound > 0.0)
    {
        eight = EightTarget(wasp, EightLaneAt(flowLane), middle, _EightYaw + past.z, eightFlow);
    }

    // The way the stream runs at this wasp's place, for the flow round obstacles (songs-v2 X); its sign may be either.
    flow = lerp(riverFlow, eightFlow, wound);

    float3 goal = wound <= 0.0 ? river : eight;
    if (wound > 0.0 && wound < 1.0)
    {
        goal = AroundPoint(lerp(river, eight, wound), middle, min(FlatReachFrom(middle, eight), FlatReachFrom(middle, river)));
    }

    return goal;
}

// A tight halo over the core.
float3 HaloTarget(WaspStatic wasp)
{
    float around = wasp.seed * FullTurn + _SimTime * HaloSpin;
    float wobble = wasp.ringRadius * HaloThickness;
    float reach = HaloRadius + cos(wasp.ringAngle) * wobble;
    float lift = HaloHeight + sin(wasp.ringAngle) * wobble;
    return _CorePosition.xyz + RingOffset(around, reach) + Up * lift;
}

int BoneOf(WaspStatic wasp)
{
    return (int)(wasp.boneIndex + 0.5);
}

bool HasColossusPlace(WaspStatic wasp)
{
    int bone = BoneOf(wasp);
    return bone >= 0 && bone < _BoneCount;
}

float3 ColossusTarget(WaspStatic wasp)
{
    return mul(_Bones[BoneOf(wasp)], float4(wasp.boneOffset, 1.0)).xyz;
}

// Where a wasp wants to be in a whole-swarm form, which look it shows and whether the stiff shape spring holds it.
// A Colossus without bones, Collapsed and the River itself are the river, which winds into the eight while the core
// stands.
float3 GoalOf(int form, WaspStatic wasp, out int look, out bool isShape, out float wound, out float2 flow)
{
    look = form;
    isShape = true;
    wound = 1.0;
    flow = float2(0.0, 0.0);
    float3 goal = _CorePosition.xyz;

    if (form == FormHiveCall)
    {
        goal = HaloTarget(wasp);
    }
    else if (form == FormColossus && HasColossusPlace(wasp))
    {
        goal = ColossusTarget(wasp);
    }
    else
    {
        look = FormRiver;
        isShape = false;
        goal = RiverTarget(wasp, wound, flow);
    }

    return goal;
}

// ---------------------------------------------------------------------------------------------------------------------
// The helpers every slot song shares (songs-v2 B).

Steer SteerOf(float3 goal, float share, float heat)
{
    Steer steer;
    steer.goal = goal;
    steer.share = saturate(share);
    steer.heat = heat;
    steer.floorY = NoFloor;
    steer.isFast = false;
    steer.pin = 0.0;
    return steer;
}

// 0 while the wasp still flies the base form, easing to 1 as it leaves it for the song. The river's head leaves first.
float Peel(float seconds, float lane)
{
    return smoothstep(0.0, PeelSeconds, seconds - lane * PeelStagger);
}

// Peel squeezed in time, the same ribbon, so even the river's tail has left the base form by `end` seconds. For a song
// that hits at `end`, so every wasp in its shape is there, and flashes, on the hit's frame. Never slower than Peel.
float PeelBy(float seconds, float lane, float end)
{
    float squeeze = min(end / (PeelSeconds + PeelStagger), 1.0);
    return smoothstep(0.0, PeelSeconds * squeeze, seconds - lane * PeelStagger * squeeze);
}

// 0 while the song holds the wasp, easing to 1 once it is back in the base form. Order 0 leaves first.
float Home(float released, float order)
{
    return released < 0.0 ? 0.0 : smoothstep(0.0, HomeSeconds, released - order * HomeStagger);
}

// The heat of a strike: the wind-up while windUp goes from 0 to 1, then the impact flash and the hold once
// sinceImpact is 0 or more.
float StrikeHeat(float windUp, float sinceImpact)
{
    float heat = lerp(WindUpStartHeat, WindUpHeat, saturate(windUp));
    if (sinceImpact >= 0.0)
    {
        heat = sinceImpact < ImpactSeconds ? ImpactHeat : HoldHeat;
    }

    return heat;
}

// A flat direction turned `angle` radians about the up axis, the way RingOffset's angle turns (from +x toward +z).
float3 TurnFlat(float3 direction, float angle)
{
    float turnSin;
    float turnCos;
    sincos(angle, turnSin, turnCos);
    return float3(direction.x * turnCos - direction.z * turnSin, 0.0, direction.x * turnSin + direction.z * turnCos);
}

// 0 to 1, fastest at the start and settling at the end: three times the mean pace at first.
float EaseOutCubic(float progress)
{
    float rest = 1.0 - saturate(progress);
    return 1.0 - rest * rest * rest;
}

// The index-th of `count` unit directions turned GoldenAngle apart round the up axis, rising evenly from height `lowest`
// to `highest`, so any count of them spreads evenly. The spikes of a splash or a burst.
float3 FibonacciDirection(float index, float count, float lowest, float highest)
{
    float height = lerp(lowest, highest, (index + 0.5) / count);
    return RingOffset(index * GoldenAngle, sqrt(saturate(1.0 - height * height))) + Up * height;
}

// ---------------------------------------------------------------------------------------------------------------------
// Sting: one or more stings, each a comet along an arc to its target, two gyroscope rings that wrap it, then a pop and
// the arc home.

// A point on one of the two rings round the target's chest. The first half of the sting's wasps (rank below 0.5) makes
// one ring, level along the line to the target and tilted up across it, turning one way; the second half the other
// ring, level across the line and tilted along it, turning the other way. Seen from any side the two cross like a
// gyroscope's. Each ring is a band StingRingTube thick, so the wasps keep apart.
float3 StingRingPoint(SlotContext context, float rank, float3 center, float3 toward, float radius)
{
    bool isFirstRing = rank < 0.5;
    float spin = isFirstRing ? StingRingSpin : -StingRingSpin;
    float3 side = cross(Up, toward);
    float3 level = isFirstRing ? toward : side;
    float3 flat = isFirstRing ? side : toward;

    float tiltSin;
    float tiltCos;
    sincos(isFirstRing ? StingRingTilt : -StingRingTilt, tiltSin, tiltCos);
    float3 lifted = flat * tiltCos + Up * tiltSin;
    float3 normal = cross(level, lifted);

    float aroundSin;
    float aroundCos;
    sincos(frac(rank * 2.0) * FullTurn + context.seconds * spin, aroundSin, aroundCos);
    float3 radial = level * aroundCos + lifted * aroundSin;

    float tubeSin;
    float tubeCos;
    sincos(context.wasp.lane * FullTurn, tubeSin, tubeCos);
    float tube = context.wasp.ringRadius * StingRingTube;
    return center + radial * (radius + tubeCos * tube) + normal * (tubeSin * tube);
}

// How many stings the cast sent: p1.x, as StingRule sends it, or, while p1.x is 0, how many targets SwarmGpuView holds.
// 1 to STING_MOST.
int StingCountOf(SlotContext context)
{
    int count = context.p1.x >= 0.5 ? (int)(context.p1.x + 0.5) : _StingTargetCount;
    return clamp(count, 1, STING_MOST);
}

// One sting's target: xyz its feet and w when it fell (-1 while it lives), from _StingTargets, or p0's target, alive,
// for a sting SwarmGpuView holds no target for.
float4 StingTargetOf(SlotContext context, int sting)
{
    float4 target = float4(context.p0.xyz, -1.0);
    if (sting < _StingTargetCount)
    {
        target = _StingTargets[sting];
    }

    return target;
}

// Reads (StingRule's remarks): p0.xyz the first target's feet, live; p0.w the seconds the head takes to arrive, when the
// damage starts (StingSong.ArriveSeconds; 0 reads as 0.35); p1.x how many stings the cast sent (0 reads as one per
// target SwarmGpuView holds). Each sting's own target comes from _StingTargets. The squad is shared evenly between the
// stings: the rank picks the sting (floor(stings x u)) and the place in it (frac(stings x u)), as the Hydra's heads do.
// A sting whose target falls pops and flies home on its own; the slot's release sends every sting home.
Steer StingSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    int stings = StingCountOf(context);
    float ranked = context.u * stings;
    int sting = min((int)ranked, stings - 1);
    float rank = saturate(ranked - sting);
    float4 target = StingTargetOf(context, sting);

    // Several stings fan out: each arc bows sideways at its top by its place in the fan, and each pair of rings is
    // turned by its own angle, so two stings on one beekeeper arrive from two sides and wrap it in two cocoons.
    float fanShare = stings > 1 ? 2.0 * sting / (stings - 1) - 1.0 : 0.0;
    float3 start = _CorePosition.xyz + Up * FlyHeight;
    float3 center = target.xyz + Up * StingChestHeight;
    float3 toward = FlatDirection(_CorePosition.xyz, target.xyz);
    float3 bow = cross(Up, toward) * (fanShare * StingFanMeters);
    float3 control = (start + center) * 0.5 + Up * (StingArcHeight + StingArcRise * distance(start, center)) + bow;
    float3 ringToward = TurnFlat(toward, (float)sting * GoldenAngle);

    // Launch: the comet. Its rank is the wasp's place in the river at the cast, so the river's head is the comet's tight,
    // bright head and the tail widens behind it. The goal leads the arc by the strike spring's lag, so the head lands
    // on the arc's end at the rules' arrival, when the damage starts.
    float flight = context.p0.w > 0.0 ? context.p0.w : StingFlightSeconds;
    float leave = context.lane * PeelStagger;
    float progress = saturate((context.seconds - leave) / flight);
    float rate = progress > 0.0 && progress < 1.0 ? 1.0 / flight : 0.0;
    float3 slope = BezierSlope(start, control, center, progress);
    float3 across = cross(Up, toward) * cos(wasp.ringAngle) + Up * sin(wasp.ringAngle);
    float width = (StingHeadWidth + context.lane * StingTailWidth) * wasp.ringRadius;
    float3 comet = Bezier(start, control, center, progress) + slope * (rate * StrikeLeadSeconds()) + across * width;

    // Peak: the rings, squeezing and flaring once a tick from the head's arrival.
    float sinceHead = context.seconds - flight;
    float tick = frac(max(sinceHead, 0.0) / StingTickSeconds) * StingTickSeconds;
    float squeeze = sinceHead >= 0.0 ? 1.0 - smoothstep(0.0, StingSqueezeSeconds, tick) : 0.0;
    float3 ring = StingRingPoint(context, rank, center, ringToward, lerp(StingRingRadius, StingSqueezeRadius, squeeze));
    float3 shape = lerp(comet, ring, smoothstep(StingWrapStart, 1.0, progress));

    float sinceArrival = context.seconds - leave - flight;
    float heat = StrikeHeat(progress, sinceArrival);
    if (sinceArrival >= ImpactSeconds)
    {
        heat = lerp(HoldHeat, StingTickHeat, squeeze);
    }

    // Peel's ribbon, but never slower than the flight, so a wasp has fully left the river, and flashes, as it arrives.
    float peel = smoothstep(0.0, min(PeelSeconds, flight), context.seconds - leave);
    float3 goal = lerp(context.baseGoal, shape, peel);
    float share = peel;
    bool isFast = rate > 0.0;

    // Return: the cocoon pops to a sphere, then streams home on the reversed arc and into the base form. A sting whose
    // target fell goes from then, or from the slot's release if that came first.
    float released = context.released;
    if (target.w >= 0.0)
    {
        released = max(released, max(_SimTime - target.w, 0.0));
    }

    if (released >= 0.0)
    {
        float pop = smoothstep(0.0, StingPopSeconds, released);
        float3 burst = lerp(goal, center + SphereDirection(wasp) * StingPopRadius, pop);
        float back = smoothstep(0.0, StingHomeSeconds, released - StingPopSeconds - rank * StingHomeStagger);
        float home = smoothstep(0.5, 1.0, back);
        goal = lerp(Bezier(burst, control, start, back), context.baseGoal, home);
        share = peel * (1.0 - home);
        heat = released < StingPopSeconds ? ImpactHeat : HoldHeat;
        isFast = back > 0.0 && back < 1.0;
    }

    Steer steer = SteerOf(goal, share, heat);
    steer.isFast = isFast;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Tornado: it grows from the ground up, the flung share bursts out into a knee-high shock ring at the hit, and it
// collapses from the top down, unwinding outward into the river.

// Radians turned since the cast: spin per second, easing up to TornadoSpinUp times it over TornadoSpinUpSeconds after
// the hit. Worked out whole each frame, so it needs nothing from the frame before.
float TornadoTurn(float seconds, float spin, float hit)
{
    float ramp = clamp(seconds - hit, 0.0, TornadoSpinUpSeconds);
    float beyond = max(seconds - hit - TornadoSpinUpSeconds, 0.0);
    float extra = (TornadoSpinUp - 1.0) * spin * (ramp * ramp / (2.0 * TornadoSpinUpSeconds) + beyond);
    return spin * seconds + extra;
}

Steer TornadoSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float outer = context.p0.x > 0.0 ? context.p0.x : DefaultTornadoRadius;
    float height = context.p0.y > 0.0 ? context.p0.y : TornadoHeight;
    float spin = context.p0.z > 0.0 ? context.p0.z : TornadoSpin;
    float hit = context.p0.w > 0.0 ? context.p0.w : TornadoHitSeconds;
    float wall = context.p1.x > 0.0 ? context.p1.x : TornadoInnerRadius;
    float seconds = context.seconds;

    // Launch: the top climbs from the ground to full height by the hit. A wasp waits in the skirt until the top
    // reaches its place, then spirals up to it.
    float place = TornadoBaseHeight + wasp.level01 * height;
    float top = TornadoBaseHeight + height * smoothstep(0.0, hit, seconds);
    float climbed = smoothstep(place - TornadoClimbBand, place, top);
    float funnel = lerp(TornadoFunnelBottom, TornadoFunnelTop, wasp.level01);
    float wallRadius = (wall + (wasp.ringRadius - 0.5) * TornadoWallThickness) * funnel;
    float skirtRadius = TornadoSkirtRadius + (wasp.ringRadius - 0.5) * TornadoWallThickness;
    float radius = lerp(skirtRadius, wallRadius, climbed);
    float lift = lerp(TornadoSkirtHeight, place, climbed);

    // Peak: the flung share shoots out flat to the reach, a knee-high ring that lands on the beekeepers at the hit.
    float sinceHit = seconds - hit;
    float sinceShock = sinceHit + TornadoShockLead;
    bool isFlung = context.lane < 1.0 - TornadoWallShare;
    float shock = isFlung ? smoothstep(0.0, TornadoShockSeconds, sinceShock) : 0.0;
    radius = lerp(radius, lerp(TornadoShockInner, 1.0, wasp.ringRadius) * outer, shock);
    lift = lerp(lift, TornadoShockHeight, shock);

    // Return: the top leaves first, swinging outward and down as it pours into the base form.
    float home = Home(context.released, 1.0 - wasp.level01);
    radius *= 1.0 + home * TornadoUnwind;
    lift *= 1.0 - home;

    // The flung share leaves the column's spin as it is flung, and the shock ring turns slowly.
    float turn = TornadoTurn(seconds, spin, hit);
    if (isFlung)
    {
        float shockStart = hit - TornadoShockLead;
        float flungTurn = TornadoTurn(min(seconds, shockStart), spin, hit) + max(seconds - shockStart, 0.0) * TornadoShockSpin;
        turn = lerp(turn, flungTurn, shock);
    }

    float around = wasp.ringAngle + wasp.level01 * TornadoTwist + turn;
    float3 shape = _CorePosition.xyz + RingOffset(around, radius) + Up * lift;
    float peel = PeelBy(seconds, context.lane, hit);
    float3 goal = lerp(lerp(context.baseGoal, shape, peel), context.baseGoal, home);

    Steer steer = SteerOf(goal, peel * (1.0 - home), StrikeHeat(seconds / hit, sinceHit));
    steer.isFast = isFlung && sinceShock >= 0.0 && sinceShock < 2.0 * TornadoShockSeconds && home <= 0.0;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Meteor: a spiral climb into a ball high over the core while the top tenth drops early to draw the target ring; a
// heartbeat; a streaked dive; the ring burst; then home.

// A loose ball at the top of the climb, turning slowly.
float3 MeteorBallPoint(WaspStatic wasp, float seconds, float height, float radius)
{
    float latitude = 1.0 - 2.0 * wasp.level01;
    float spread = sqrt(saturate(1.0 - latitude * latitude));
    float around = wasp.phase01 * FullTurn + seconds * MeteorBallSpin;
    float3 offset = (RingOffset(around, spread) + Up * latitude) * (wasp.ringRadius * radius);
    return _CorePosition.xyz + Up * height + offset;
}

// Out of the base form into a tight column over the core, up it, and out into the ball at the top.
float3 MeteorClimbPoint(SlotContext context, float progress, float climbSeconds, float height, float3 ball)
{
    WaspStatic wasp = context.wasp;
    float climb = smoothstep(0.0, 1.0, progress);
    float climbRate = 6.0 * progress * (1.0 - progress) / climbSeconds;
    float lead = (height - FlyHeight) * climbRate * StrikeLeadSeconds();

    float around = wasp.ringAngle + context.seconds * MeteorColumnSpin;
    float lift = lerp(FlyHeight, height, climb) + lead;
    float3 column = _CorePosition.xyz + RingOffset(around, wasp.ringRadius * MeteorColumnRadius) + Up * lift;
    float3 lifted = lerp(context.baseGoal, column, smoothstep(0.0, MeteorGatherShare, progress));
    return lerp(lifted, ball, smoothstep(MeteorSpreadShare, 1.0, progress));
}

// A steep line from the ball to the wasp's landing point, faster as it falls. The divers set off one after another,
// so the ball stretches into streaks. The line runs to p0 as it is now, so the dive goes where the rules land it.
float3 MeteorDivePoint(WaspStatic wasp, float progress, float dive, float3 ball, float3 impact)
{
    float travelled = progress * (MeteorDiveEase + (1.0 - MeteorDiveEase) * progress);
    float rate = (MeteorDiveEase + 2.0 * (1.0 - MeteorDiveEase) * progress) / dive;
    float reach = sqrt(wasp.level01) * MeteorLandingScatter;
    float3 landing = impact + RingOffset(wasp.phase01 * FullTurn, reach) + Up * MeteorFloorHeight;
    return ball + (landing - ball) * (travelled + rate * StrikeLeadSeconds());
}

Steer MeteorSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float3 impact = context.p0.xyz;
    float height = context.p0.w;
    float rise = context.p1.x;
    float dive = max(context.p1.y, Tiny);
    float radius = context.p1.z > 0.0 ? context.p1.z : DefaultMeteorRadius;
    float seconds = context.seconds;

    bool isMarker = context.u >= MeteorMarkerShare;
    float order = saturate(context.u / MeteorMarkerShare);
    float climbStart = order * MeteorClimbStagger * rise;
    float climbSeconds = max(MeteorClimbShare * rise, Tiny);
    float climbEnd = climbStart + climbSeconds;
    float diveStart = rise + order * MeteorDiveStagger;
    float landTime = diveStart + context.p1.y;
    float impactTime = rise + context.p1.y;

    float heartbeat = smoothstep(rise - MeteorHeartbeatSeconds, rise, seconds);
    float3 ball = MeteorBallPoint(wasp, seconds, height, lerp(MeteorBallRadius, MeteorHeartRadius, heartbeat));
    float climbProgress = saturate((seconds - climbStart) / climbSeconds);
    float3 climb = MeteorClimbPoint(context, climbProgress, climbSeconds, height, ball);
    float share = smoothstep(0.0, MeteorGatherShare, climbProgress);
    float floorY = NoFloor;
    bool isFast = seconds >= climbStart && seconds < landTime;
    float3 shape = climb;
    float heat = StrikeHeat(heartbeat, seconds - landTime);

    if (isMarker)
    {
        // The top tenth leaves the ball as its climb ends and drops to the target ring, turning, ahead of the dive.
        float drop = saturate((seconds - climbEnd) / MeteorMarkDropSeconds);
        float around = frac((context.u - MeteorMarkerShare) / (1.0 - MeteorMarkerShare)) * FullTurn + seconds * MeteorMarkSpin;
        float3 mark = impact + RingOffset(around, radius) + Up * MeteorFloorHeight;
        shape = lerp(climb, mark, drop * drop);
        isFast = seconds >= climbStart && seconds < climbEnd + MeteorMarkDropSeconds;
        floorY = seconds >= climbEnd ? impact.y + MeteorFloorHeight : NoFloor;
        heat = StrikeHeat(drop, seconds - impactTime);
    }
    else if (seconds >= landTime)
    {
        // Each wasp bursts straight out from its landing point to a ring whose outer edge is the reach.
        float reach = lerp(MeteorRingInner, 1.0, wasp.ringRadius) * radius;
        shape = impact + RingOffset(wasp.phase01 * FullTurn, reach) + Up * MeteorRingHeight;
        floorY = impact.y + MeteorFloorHeight;
    }
    else if (seconds >= diveStart)
    {
        float diveProgress = saturate((seconds - diveStart) / dive);
        shape = MeteorDivePoint(wasp, diveProgress, dive, ball, impact);
        floorY = impact.y + MeteorFloorHeight;
        heat = WindUpHeat;
    }

    // Home after the burst, which starts at the release: the rules let go on the impact frame.
    float home = context.released < 0.0
        ? 0.0
        : smoothstep(0.0, MeteorHomeSeconds, context.released - MeteorBurstSeconds - context.u * MeteorHomeStagger);
    Steer steer = SteerOf(lerp(shape, context.baseGoal, home), share * (1.0 - home), heat);
    steer.floorY = home < 1.0 ? floorY : NoFloor;
    steer.isFast = isFast;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Dome: woven ring by ring from the ground, a turning shell, then it unzips from the top down.

// The squad's rank u is the height on the shell and the wasp's lane its angle. The two are spread evenly and
// independently, so the shell is evenly covered at any squad size.
Steer DomeSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float radius = context.p0.x > 0.0 ? context.p0.x : DefaultDomeRadius;
    float height = 1.0 - context.u;
    float spread = sqrt(saturate(1.0 - height * height));
    float woven = smoothstep(0.0, DomeWeaveSeconds, context.seconds - height * DomeWeaveStagger);
    float around = wasp.lane * FullTurn + context.seconds * DomeSpin - (1.0 - woven) * DomeWeaveTurn;
    float shell = radius + (wasp.ringRadius - 0.5) * DomeShellThickness;
    float3 seat = _CorePosition.xyz + (RingOffset(around, spread) + Up * height) * shell;

    // The crown has rank 0, so it leaves first.
    float home = Home(context.released, context.u);
    float3 goal = lerp(lerp(context.baseGoal, seat, woven), context.baseGoal, home);
    return SteerOf(goal, woven * (1.0 - home), DomeGlow);
}

// ---------------------------------------------------------------------------------------------------------------------
// Hydra: Bezier necks rise from the swarm's edge and rear their heads back over the core; the heads snap onto their
// targets, burst into spiky splashes and shake; then the necks recoil into the river, head first.

// One head's packed float: heads 1 to 4 are p0's x, y, z and w, head 5 is p1.x.
float HydraPackedOf(SlotContext context, int head)
{
    float packed = context.p1.x;
    if (head == 0)
    {
        packed = context.p0.x;
    }
    else if (head == 1)
    {
        packed = context.p0.y;
    }
    else if (head == 2)
    {
        packed = context.p0.z;
    }
    else if (head == 3)
    {
        packed = context.p0.w;
    }

    return packed;
}

// Where one head lands, unpacked as HydraRule packs it: at a beekeeper's chest when it bites one, or just over the
// ground for a spare head.
float3 HydraBiteOf(SlotContext context, int head, float ground)
{
    uint packed = (uint)max(HydraPackedOf(context, head) + 0.5, 0.0);
    bool bites = packed >= HydraBitesFlag;
    float x = (float)((packed >> HydraGridShift) & HydraGridMask) / HydraGridStepsPerMetre - HydraGridOrigin;
    float z = (float)(packed & HydraGridMask) / HydraGridStepsPerMetre - HydraGridOrigin;
    return float3(x, ground + (bites ? HydraBiteHeight : HydraStrikeHeight), z);
}

// How many heads the Hydra has: HydraRule never packs a head as 0 and leaves the places past its count at 0, so the
// places that are not 0. At least one.
int HydraHeadCount(SlotContext context)
{
    float present = step(0.5, context.p0.x) + step(0.5, context.p0.y) + step(0.5, context.p0.z) + step(0.5, context.p0.w)
        + step(0.5, context.p1.x);
    return clamp((int)(present + 0.5), 1, HydraMostHeads);
}

// Reads (HydraRule's remarks): p0.x, p0.y, p0.z, p0.w and p1.x heads 1 to 5, each packed into one float
// (HydraBiteOf), as many as HydraHeadCount counts; p1.y the bite's seconds after the cast, HydraSong.BiteSeconds, when
// the heads land with the damage (0 reads as 0.7); p1.z the level's size scale at the cast (0 reads as 1), which grows
// the necks, the rear and the splashes. The ground is at the core's height. A head follows its beekeeper until the
// bite. The heads rear back until HydraSnapSeconds before the bite, then snap.
// The squad's rank picks the head (floor(heads x u)) and the place on its neck (frac(heads x u) to HydraNeckPacking, 1 at
// the head), so every head gets an equal share and its wasps crowd into the head.
Steer HydraSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float seconds = context.seconds;
    int heads = HydraHeadCount(context);
    float biteAt = context.p1.y > 0.0 ? context.p1.y : HydraBiteSeconds;
    float rearAt = biteAt - min(HydraSnapSeconds, 0.5 * biteAt);
    float ranked = context.u * heads;
    int head = min((int)ranked, heads - 1);
    float neck = pow(saturate(ranked - head), HydraNeckPacking);
    bool isHead = neck >= HydraHeadStart;

    float ground = _CorePosition.y;
    float grown = context.p1.z > 0.0 ? context.p1.z : 1.0;
    float3 bite = HydraBiteOf(context, head, ground);
    float3 toward = FlatDirection(_CorePosition.xyz, bite);
    float3 side = cross(Up, toward);

    // Launch: each neck rises from the swarm's edge on its target's side, and its head rears back over the core, away from
    // its target and turned out on the heads' fan, swaying.
    float fanShare = heads > 1 ? 2.0 * head / (heads - 1) - 1.0 : 0.0;
    float3 behind = TurnFlat(-toward, fanShare * HydraFanRadians);
    float sway = sin(seconds * HydraSwaySpeed + head * HydraSwayPhase) * HydraSwayMeters * grown;
    float3 root = _CorePosition.xyz + toward * HydraRootOut + Up * FlyHeight;
    float3 rear = _CorePosition.xyz + (behind * HydraRearBack + Up * HydraRearHeight) * grown + cross(Up, behind) * sway;
    float3 risen = lerp(root, rear, smoothstep(0.0, rearAt, seconds));
    float3 arch = (root + risen) * 0.5 + toward * (HydraArchForward * grown);

    // Peak: the heads snap onto their targets on an ease-in cubic and the necks whip straight, pinned to the path, so the
    // heads land on the bite's frame.
    float strike = saturate((seconds - rearAt) / (biteAt - rearAt));
    float snap = strike * strike * strike;
    float3 headPoint = lerp(risen, bite, snap);
    float3 control = lerp(arch, (root + bite) * 0.5 + Up * (HydraStrikeArch * grown), snap);

    float3 spine = Bezier(root, control, headPoint, neck);
    float3 tangent = BezierSlope(root, control, headPoint, neck);
    float tangentLength = length(tangent);
    float3 along = tangentLength > Tiny ? tangent / tangentLength : Up;
    float3 across = cross(Up, along);
    float acrossLength = length(across);
    across = acrossLength > Tiny ? across / acrossLength : side;
    float3 normal = cross(along, across);
    float width = lerp(HydraNeckWidth, HydraHeadWidth, smoothstep(HydraHeadStart - 0.1, 1.0, neck)) * grown;
    float3 shape = spine + (across * cos(wasp.ringAngle) + normal * sin(wasp.ringAngle)) * (wasp.ringRadius * width);

    // The bite: each head bursts into a spiky splash on its target and the neck shakes it, hardest at the head.
    float sinceBite = seconds - biteAt;
    float splash = 0.0;
    float shake = 0.0;
    if (sinceBite >= 0.0)
    {
        float open = smoothstep(0.0, HydraSplashSeconds, sinceBite);
        splash = open * (1.0 - smoothstep(HydraShakeSeconds, HydraShakeSeconds + HydraSettleSeconds, sinceBite));
        shake = sin(sinceBite * HydraShakeSpeed + head) * HydraShakeMeters * grown * saturate(1.0 - sinceBite / HydraShakeSeconds);
    }

    if (isHead)
    {
        float spike = floor(wasp.phase01 * HydraSplashSpikes);
        float3 spikeDirection = FibonacciDirection(spike, HydraSplashSpikes, HydraSplashLowest, HydraSplashHighest);
        float reach = (neck - HydraHeadStart) / (1.0 - HydraHeadStart);
        shape = lerp(shape, bite + spikeDirection * (reach * HydraSplashRadius * grown), splash);
    }

    shape += side * (shake * neck * neck);

    // Return: the necks recoil into the river, head first.
    float peel = PeelBy(seconds, context.lane, rearAt);
    float home = Home(context.released, 1.0 - neck);
    float3 goal = lerp(lerp(context.baseGoal, shape, peel), context.baseGoal, home);

    // On the strike spring from the cast, as the Lance is, so even the river's tail keeps close to its neck while the
    // squeezed peel rushes it there and the pin has little left to close. Pinned from the snap through the shake; the
    // strike spring then folds the splash back into the head.
    bool isHeld = home <= 0.0;
    float pinned = sinceBite < HydraShakeSeconds && isHeld ? smoothstep(rearAt - PinEaseSeconds, rearAt, seconds) : 0.0;

    Steer steer = SteerOf(goal, peel * (1.0 - home), StrikeHeat(seconds / biteAt, sinceBite));
    steer.isFast = sinceBite < HydraShakeSeconds + HydraSettleSeconds && isHeld;
    steer.pin = pinned;
    steer.floorY = home < 1.0 ? ground + HydraFloorHeight : NoFloor;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Scythe: a crescent blade forms off the core and winds back, sweeps round it with a trailing smear, and crumbles into
// sinking embers that fly home.

// Reads (ScytheRule's remarks): p0.x the angle the sweep starts at (radians on the ground, from +x toward +z, as
// RingOffset), the aim less half the sweep; p0.y the signed sweep (radians; positive turns from +x toward +z; 0 reads as
// 200 degrees); p0.z the reach in metres, grown by the level (0 reads as 4.5); p0.w the wind-up, when the sweep starts
// (0 reads as 0.25); p1.x the cut's seconds after the cast (0 reads as 0.3); p1.y the sweep's seconds after the wind-up
// (0: timed so the edge crosses the aim on the cut's frame). The centre is the live core. p1.z is not read.
// The squad's rank is the place along the blade, 0 at its root and 1 at its tip.
Steer ScytheSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float seconds = context.seconds;
    float sweep = abs(context.p0.y) > Tiny ? context.p0.y : DefaultScytheSweep;
    float turn = sweep >= 0.0 ? 1.0 : -1.0;
    float reach = max(context.p0.z > 0.0 ? context.p0.z : DefaultScytheReach, ScytheInnerRadius);
    float sweepStart = context.p0.w > 0.0 ? context.p0.w : ScytheFormSeconds;
    float hit = context.p1.x > 0.0 ? context.p1.x : ScytheHitSeconds;
    float grown = reach / DefaultScytheReach;

    // Launch: the blade, widest in the middle, its tip curving back against the sweep.
    float along = context.u;
    float radius = lerp(ScytheInnerRadius, reach, along);
    float across = ScytheBladeWidth * grown * sin(HalfTurn * along) * (wasp.ringRadius - 0.5);

    // Peak: the edge winds back while the blade forms, then sweeps on an ease-out cubic, pinned. With no sweep time from
    // the rule, it takes as long as puts the edge on the aim, its middle, at the cut: the ease-out reaches a share s of
    // its arc at 1 - cbrt(1 - s) of its time. Each wasp follows the edge a moment later, the most by ScytheSmearRadians
    // at the sweep's fastest pace, so the fast start leaves a fan-shaped smear that catches up as the blade slows.
    float arc = abs(sweep) + ScytheCock;
    float atAim = 1.0 - pow(saturate(1.0 - (0.5 * abs(sweep) + ScytheCock) / arc), 1.0 / 3.0);
    float timedSeconds = clamp(max(hit - sweepStart, 0.0) / atAim, ScytheLeastSweepSeconds, ScytheMostSweepSeconds);
    float sweepSeconds = context.p1.y > 0.0 ? context.p1.y : timedSeconds;
    float smearSeconds = ScytheSmearRadians * sweepSeconds / (3.0 * arc);
    float wound = smoothstep(0.0, sweepStart, seconds) * ScytheCock;
    float swept = EaseOutCubic((seconds - sweepStart - wasp.phase01 * wasp.phase01 * smearSeconds) / sweepSeconds);
    float edge = context.p0.x - turn * wound + (sweep + turn * wound) * swept;
    float angle = edge - turn * ScytheCurve * along * along + across / radius;
    float lift = ScytheHeight + sin(wasp.ringAngle) * ScytheBladeDepth;
    float3 blade = _CorePosition.xyz + RingOffset(angle, radius) + Up * lift;

    // Then the blade crumbles into embers that scatter a little and sink.
    float sweepEnd = sweepStart + sweepSeconds + smearSeconds;
    float crumble = smoothstep(sweepEnd, sweepEnd + ScytheCrumbleSeconds, seconds);
    float3 scatter = RingOffset(angle, (wasp.seed - 0.5) * 2.0 * ScytheScatterMeters) - Up * (ScytheSinkMeters * (0.5 + 0.5 * wasp.level01));
    blade += scatter * crumble;

    float heat = lerp(StrikeHeat(seconds / hit, seconds - hit), ScytheEmberHeat, crumble);

    // Return: the embers fly home, root first.
    float peel = PeelBy(seconds, context.lane, sweepStart);
    float home = Home(context.released, along);
    float3 goal = lerp(lerp(context.baseGoal, blade, peel), context.baseGoal, home);

    // On the strike spring from the cast, as the Lance is, so even the river's tail keeps close to its place while the
    // squeezed peel rushes it round to the blade and the pin has little left to close. Pinned through the sweep; the
    // shape spring then holds the crumbling blade, which hardly moves by then.
    bool isSweeping = seconds < sweepEnd && home <= 0.0;
    Steer steer = SteerOf(goal, peel * (1.0 - home), heat);
    steer.isFast = isSweeping;
    steer.pin = isSweeping ? smoothstep(sweepStart - PinEaseSeconds, sweepStart, seconds) : 0.0;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Lance: the squad gathers into a spear behind the core and draws back, fires down the line in a blink, and fans into a
// crown at the far end over a thin wake of drifting sparks; then home.

// Reads (LanceRule's remarks): p0.xy the line's origin on the ground (world x, z), p0.zw its direction on the ground (x, z;
// normalised here, the core's facing if 0), both live through the draw and locked when it fires; p1.x the length
// in metres, grown by the level (0 reads as 14); p1.y the draw's seconds, when it fires (0 reads as 0.4); p1.z how many
// seconds later the spear's back fires than its tip (0 is allowed). The origin's height is the core's. The tip lands at
// the full length LanceFlightSeconds after the fire, which is LanceSong.FlightSeconds, so on LanceSong's hit for any draw.
// The squad's rank is the place along the spear, 0 at its tip and 1 at its back.
Steer LanceSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float seconds = context.seconds;
    float3 origin = float3(context.p0.x, _CorePosition.y, context.p0.y);
    float aimLength = length(context.p0.zw);
    float3 toward = aimLength > Tiny ? float3(context.p0.z, 0.0, context.p0.w) / aimLength : _CoreForward.xyz;
    float3 side = cross(Up, toward);
    float reach = context.p1.x > 0.0 ? context.p1.x : DefaultLanceLength;
    float draw = context.p1.y > 0.0 ? context.p1.y : LanceDrawSeconds;
    float tailLag = max(context.p1.z, 0.0);
    float grown = reach / DefaultLanceLength;
    float along = context.u;
    float3 around = side * cos(wasp.ringAngle) + Up * sin(wasp.ringAngle);

    // Launch: the draw. The squad gathers into a spear held high on the aim line behind the core and pulls back,
    // tightening and quivering harder as it goes. The quiver stops as it fires, so the flight starts from the drawn spear.
    float drawn = smoothstep(0.0, draw, seconds);
    float hasFired = seconds >= draw ? 1.0 : 0.0;
    float width = lerp(LanceLooseWidth, LanceTightWidth, drawn) * grown * lerp(LanceTipWidth, 1.0, smoothstep(0.0, LanceTipTaper, along));
    float quiver = sin(seconds * LanceQuiverSpeed - along * LanceQuiverWave) * LanceQuiverMeters * drawn * (1.0 - hasFired);
    float back = LanceSpearFront + (along * LanceSpearLength + drawn * LancePullMeters) * grown;
    float3 spear = origin - toward * back + Up * LanceHighHeight + around * (wasp.ringRadius * width) + side * quiver;

    // Peak: every wasp flies straight down the line on an ease-in, pinned, the back up to p1.z later, so the spear
    // stretches into a streak whose tip reaches the full length on the hit's frame. Thrown from high, the streak passes
    // over the core and drops to chest height LanceDropMeters past it. The back LanceWakeShare stop along the line as its
    // wake; the rest fly to its end and fan out into a crown.
    bool isWake = along >= 1.0 - LanceWakeShare;
    float fireAt = draw + along * tailLag;
    float arriveAt = fireAt + LanceFlightSeconds;
    float flight = saturate((seconds - fireAt) / LanceFlightSeconds);
    float station = isWake ? lerp(LanceWakeStart, reach, saturate((1.0 - along) / LanceWakeShare)) : reach;
    float height = lerp(LanceHighHeight, LanceHeight, smoothstep(0.0, LanceDropMeters, station));
    float3 shot = origin + toward * station + Up * height + around * (wasp.ringRadius * LanceTightWidth * grown);
    float3 shape = lerp(spear, shot, flight * flight);

    // The crown flares forward round the line's end; the wake's sparks drift sideways and sink.
    float settled = smoothstep(arriveAt, arriveAt + LanceCrownSeconds, seconds);
    float drift = smoothstep(arriveAt, arriveAt + LanceDriftSeconds, seconds);
    float3 crown = (toward * (LanceCrownDepth * wasp.level01) + around * (sqrt(wasp.ringRadius) * LanceCrownRadius)) * grown;
    float3 sparks = side * ((wasp.seed - 0.5) * 2.0 * LanceDriftMeters * grown) - Up * (LanceSinkMeters * wasp.level01);
    shape += isWake ? sparks * drift : crown * settled;

    // The tip burns white once half drawn; the whole line flashes on the hit's frame.
    float hitAt = draw + LanceFlightSeconds;
    float heat = StrikeHeat(drawn, seconds - hitAt);
    if (along < LanceTipShare && drawn >= 0.5 && seconds < hitAt)
    {
        heat = ImpactHeat;
    }

    if (isWake)
    {
        heat = lerp(heat, LanceSparkHeat, drift);
    }

    // Return: home, tip first.
    float peel = PeelBy(seconds, context.lane, draw);
    float home = Home(context.released, along);
    float3 goal = lerp(lerp(context.baseGoal, shape, peel), context.baseGoal, home);

    // The strike spring gathers the spear tight. The pin eases in at the end of the draw, so the spear quivers in full
    // just before it fires, and holds the shot, the crown and the wake on their paths until the squad heads home.
    bool isHeld = home <= 0.0;
    Steer steer = SteerOf(goal, peel * (1.0 - home), heat);
    steer.isFast = isHeld;
    steer.pin = isHeld ? smoothstep(draw - PinEaseSeconds, draw, seconds) : 0.0;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Nest: a comet lobbed onto the spot, a low turning disc that pulses while armed with a ring patrolling its trigger
// radius; set off, it crunches and erupts into an urchin of spikes to the blast radius, which droop; then home.

// Reads: p0.xyz where the nest lies (a ground point); p0.w the seconds after the cast at which a beekeeper set it off,
// or -1; p1.x the trigger radius and p1.y the blast radius in metres, grown by the level (0 reads as 2.5 and 3.5);
// p1.z the fuse's seconds from the set-off to the burst, NestSong.FuseSeconds (0 reads as 0.3). NestRule lets go at the
// burst, so once released the release is the burst; before that the burst is p0.w plus the fuse. A nest let go without
// a set-off (its time ran out) lifts and flies home.
// The squad's rank places a wasp in the disc, or on the patrol ring from NestPatrolShare up.
Steer NestSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float seconds = context.seconds;
    float3 nest = context.p0.xyz;
    float trigger = context.p1.x > 0.0 ? context.p1.x : DefaultNestTrigger;
    float blast = context.p1.y > 0.0 ? context.p1.y : DefaultNestBlast;
    bool isSetOff = context.p0.w >= 0.0;
    bool isReleased = context.released >= 0.0;
    float releasedAt = seconds - max(context.released, 0.0);
    float fuse = context.p1.z > 0.0 ? context.p1.z : NestFuseSeconds;
    float burstAt = isReleased ? releasedAt : context.p0.w + fuse;
    float lead = StrikeLeadSeconds();

    // Launch: a comet on a high arc, the river's head first, its tail narrowing to the landing.
    float leave = context.lane * NestLobStagger;
    float lobSeconds = NestLobSeconds - NestLobStagger;
    float progress = saturate((seconds - leave) / lobSeconds);
    float rate = progress > 0.0 && progress < 1.0 ? 1.0 / lobSeconds : 0.0;
    float3 start = _CorePosition.xyz + Up * (FlyHeight + NestLobLift);
    float3 land = nest + Up * NestDiscHeight;
    float3 control = (start + land) * 0.5 + Up * (NestArcHeight + NestArcRise * distance(start, land));
    float3 across = cross(Up, FlatDirection(start, land)) * cos(wasp.ringAngle) + Up * sin(wasp.ringAngle);
    float cometWidth = (NestHeadWidth + context.lane * NestTailWidth) * wasp.ringRadius * (1.0 - progress);
    float3 comet = Bezier(start, control, land, progress) + BezierSlope(start, control, land, progress) * (rate * lead) + across * cometWidth;

    // Peak, armed: a low two-armed spiral disc turning one way, a ring on the trigger radius turning the other, the
    // disc breathing and glowing in a slow pulse.
    float pulse = sin(seconds * NestPulseSpeed);
    float3 armed = nest;
    if (context.u >= NestPatrolShare)
    {
        float patrolAround = (context.u - NestPatrolShare) / (1.0 - NestPatrolShare) * FullTurn + seconds * NestRingSpin;
        armed = nest + RingOffset(patrolAround, trigger + (wasp.ringRadius - 0.5) * NestRingWidth) + Up * NestRingHeight;
    }
    else
    {
        float spread = sqrt(context.u / NestPatrolShare);
        float arm = wasp.lane < 0.5 ? 0.0 : HalfTurn;
        float discAround = arm + spread * NestSpiralTwist + (wasp.phase01 - 0.5) * NestArmWidth + seconds * NestDiscSpin;
        float discRadius = spread * trigger * NestDiscShare * (1.0 + NestPulseShare * pulse);
        armed = nest + RingOffset(discAround, discRadius) + Up * (NestDiscHeight + sin(wasp.ringAngle) * NestDiscDepth);
    }

    float settle = smoothstep(leave + lobSeconds, leave + lobSeconds + NestSplashSeconds, seconds);
    float3 shape = lerp(comet, armed, settle);
    float heat = lerp(StrikeHeat(progress, -1.0), NestArmedGlow + NestPulseGlow * (0.5 + 0.5 * pulse), settle);

    // Set off: it crunches into a tight ball over the fuse, hotter as it goes.
    float crunch = isSetOff ? smoothstep(context.p0.w, max(burstAt, context.p0.w + Tiny), seconds) : 0.0;
    float3 crunched = nest + Up * NestCrunchHeight + SphereDirection(wasp) * (wasp.ringRadius * NestCrunchRadius);
    shape = lerp(shape, crunched, crunch * crunch);
    heat = lerp(heat, WindUpHeat, crunch);

    // The burst: an urchin of spikes, each out and up from the ball to a tip over the blast radius, pinned; then the
    // spikes droop on the springs.
    float sinceBurst = seconds - burstAt;
    bool isBursting = isSetOff && sinceBurst >= 0.0;
    if (isBursting)
    {
        float spike = floor(wasp.phase01 * NestSpikes);
        float rise = lerp(NestSpikeLowest, NestSpikeHighest, frac(spike * GoldenShare)) * (blast / DefaultNestBlast);
        float3 heart = nest + Up * NestCrunchHeight;
        float3 tip = nest + RingOffset(spike * GoldenAngle, blast) + Up * rise;
        float reach = lerp(NestSpikeRoot, 1.0, wasp.ringRadius) * EaseOutCubic(sinceBurst / NestSpikeSeconds);
        float droop = smoothstep(NestSpikeSeconds, NestSpikeSeconds + NestDroopSeconds, sinceBurst);
        shape = lerp(heart, tip, reach) - Up * (droop * NestDroopMeters * reach * reach);
        heat = StrikeHeat(1.0, sinceBurst);
    }

    // Return: after the burst has shown, or at once if it never went off.
    float homeStart = isSetOff ? max(releasedAt, burstAt + NestBurstHoldSeconds) : releasedAt;
    float home = isReleased ? smoothstep(0.0, NestHomeSeconds, seconds - homeStart - context.u * NestHomeStagger) : 0.0;
    float peel = smoothstep(0.0, NestPeelSeconds, seconds - leave);
    float3 goal = lerp(lerp(context.baseGoal, shape, peel), context.baseGoal, home);

    Steer steer = SteerOf(goal, peel * (1.0 - home), heat);
    // The strike spring through the lob, its goal led along the arc so it lands on time; the pin eases in over the
    // crunch's last moment and holds through the spikes' eruption.
    bool isErupting = isSetOff && sinceBurst < NestSpikeSeconds && home <= 0.0;
    steer.isFast = home <= 0.0 && (rate > 0.0 || isErupting);
    steer.pin = isErupting ? smoothstep(burstAt - PinEaseSeconds, burstAt, seconds) : 0.0;
    steer.floorY = home < 1.0 && settle > 0.0 ? nest.y + NestFloorHeight : NoFloor;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Honeycomb: a stream arcs to the hive and winds up round it in a helix into a shell of hexagon cells, calm and slowly
// breathing; a stick's hit ripples across it from that side; released, the cells pop out and lift off, then fly home.

// |offset| in the hexagon's own measure: 1 on the edge of a hexagon of apothem 1 whose flat sides face 0, 60 and 120
// degrees.
float HexMeasure(float2 offset)
{
    float slanted = 0.5 * offset.x;
    float upright = HalfSqrt3 * offset.y;
    return max(abs(offset.x), max(abs(slanted + upright), abs(slanted - upright)));
}

// The centre of the hexagon cell that holds a point in the plane. The cells have flat sides facing 0, 60 and 120
// degrees, `apothem` from centre to side, so neighbouring centres lie 2 x apothem apart in those directions. The point
// in lattice steps along (2a, 0) and (a, a x sqrt 3), rounded to the nearest centre by the usual cube rounding.
float2 HexCenter(float2 position, float apothem)
{
    float rows = position.y / (apothem * Sqrt3);
    float columns = (position.x - rows * apothem) / (2.0 * apothem);
    float3 cube = float3(columns, rows, -columns - rows);
    float3 rounded = round(cube);
    float3 error = abs(rounded - cube);
    if (error.x > error.y && error.x > error.z)
    {
        rounded.x = -rounded.y - rounded.z;
    }
    else if (error.y > error.z)
    {
        rounded.y = -rounded.x - rounded.z;
    }

    return float2((2.0 * rounded.x + rounded.y) * apothem, rounded.y * apothem * Sqrt3);
}

// The point on its cell's edge that a point in the plane snaps to: out from the cell's centre, through the point, to the
// edge. `away` is used for a point on the very centre. Gives the cell's centre too.
float2 HexEdge(float2 position, float apothem, float2 away, out float2 cell)
{
    cell = HexCenter(position, apothem);
    float2 offset = position - cell;
    offset = dot(offset, offset) > Tiny * Tiny ? offset : away;
    return cell + offset * (apothem / max(HexMeasure(offset), Tiny));
}

// Reads: p0.xyz the hive's position (its base on the ground); p0.w the shell's radius in metres, grown by the level (0
// reads as 1.6); p1.x the side of the stick that hit last, as an angle on the ground from the hive (radians, from +x
// toward +z, as RingOffset); p1.y that hit's seconds after the cast, or -1; p1.z the radius in metres the cells burst out
// to at the release, grown by the level (0 reads as 2.2).
// The shell is a dome HoneycombHeightShare times as tall as it is wide. Each wasp's place on it is spread evenly by rank
// (height) and lane (angle), as on the Dome; the dome is laid flat round its crown (a point's distance from the crown
// along the dome becomes its distance from the plane's centre), the point snaps to its hexagon cell's edge in that plane,
// and goes back onto the dome. Laid flat that way the lattice needs no seam, and its cells only narrow a little toward
// the dome's foot.
Steer HoneycombSteer(SlotContext context)
{
    WaspStatic wasp = context.wasp;
    float seconds = context.seconds;
    float3 hive = context.p0.xyz;
    float radius = context.p0.w > 0.0 ? context.p0.w : DefaultHoneycombRadius;
    float burst = context.p1.z > 0.0 ? context.p1.z : DefaultHoneycombBurst;
    float apothem = radius * HoneycombCellShare * HalfSqrt3;

    // The wasp's cell edge, laid flat, then its place on the dome: from the crown, and round the hive.
    float2 away = float2(cos(wasp.lane * FullTurn), sin(wasp.lane * FullTurn));
    float2 flat = away * (acos(saturate(1.0 - context.u)) * radius);
    float2 cell;
    float2 edge = HexEdge(flat, apothem, away, cell);
    float2 outward = edge - cell;
    edge += outward * ((wasp.ringRadius - 0.5) * HoneycombStroke / max(length(outward), Tiny));
    float edgeReach = length(edge);
    float seatPolar = min(edgeReach / radius, HoneycombLowestPolar);
    float seatAround = (edgeReach > Tiny ? atan2(edge.y, edge.x) : 0.0) + seconds * HoneycombSpin;

    // Launch: a stream arcs from the river to the dome's foot, the river's head first; there each wasp winds up round
    // the hive in a helix to its cell.
    float leave = context.lane * HoneycombFlightStagger;
    float flight = saturate((seconds - leave) / HoneycombFlightSeconds);
    float wound = smoothstep(0.0, HoneycombWindSeconds, seconds - leave - HoneycombFlightSeconds);
    float polar = lerp(HoneycombLowestPolar, seatPolar, wound);
    float around = seatAround - (1.0 - wound) * HoneycombWindTurn;
    float3 unit = RingOffset(around, sin(polar)) + Up * cos(polar);
    float breath = 1.0 + HoneycombBreathShare * sin(seconds * HoneycombBreathSpeed);
    float3 seat = hive + float3(unit.x, unit.y * HoneycombHeightShare, unit.z) * (radius * breath);
    float heat = HoneycombGlow + HoneycombBreathGlow * sin(seconds * HoneycombBreathSpeed);

    // Peak: a stick's hit flashes its cell white and bulges it, and a ripple runs across the shell from that side.
    float sinceHit = context.p1.y >= 0.0 ? seconds - context.p1.y : -1.0;
    if (sinceHit >= 0.0 && sinceHit < HoneycombRippleSeconds)
    {
        float3 struck = RingOffset(context.p1.x, cos(HoneycombHitLatitude)) + Up * sin(HoneycombHitLatitude);
        float apart = acos(clamp(dot(unit, struck), -1.0, 1.0));
        float front = (apart - sinceHit * HoneycombRippleSpeed) / HoneycombRippleWidth;
        float wave = exp(-front * front) * (1.0 - sinceHit / HoneycombRippleSeconds) * wound;

        // The struck cell is found laid flat, as the wasps' cells are, with the shell's turn taken off.
        float struckAround = context.p1.x - seconds * HoneycombSpin;
        float2 struckFlat = float2(cos(struckAround), sin(struckAround)) * ((QuarterTurn - HoneycombHitLatitude) * radius);
        float2 struckOffset = cell - HexCenter(struckFlat, apothem);
        bool isStruck = dot(struckOffset, struckOffset) < apothem * apothem;
        float bulge = isStruck ? (1.0 - smoothstep(0.0, HoneycombBulgeSeconds, sinceHit)) * wound : 0.0;

        seat += unit * (wave * HoneycombRippleMeters + bulge * HoneycombBulgeMeters);
        heat = max(heat, wave * HoneycombRippleHeat);
        if (isStruck && sinceHit < HoneycombFlashSeconds && wound > 0.0)
        {
            heat = ImpactHeat;
        }
    }

    float3 control = (context.baseGoal + seat) * 0.5 + Up * (HoneycombArcHeight + HoneycombArcRise * distance(context.baseGoal, seat));
    float3 shape = Bezier(context.baseGoal, control, seat, smoothstep(0.0, 1.0, flight));

    // Return: each cell pops out to the burst radius and lifts off, lowest rank (the crown) first, then flies home. A
    // wasp still on its way (a shell let go at once, with no hive standing) just turns home.
    float released = context.released;
    float popAt = context.u * HoneycombPopStagger;
    float pop = released >= 0.0 ? smoothstep(0.0, HoneycombPopSeconds, released - popAt) * wound : 0.0;
    float home = released >= 0.0 ? smoothstep(0.0, HoneycombHomeSeconds, released - popAt - HoneycombPopSeconds) : 0.0;
    float3 popped = hive + (seat - hive) * (burst / radius) + Up * HoneycombLiftMeters;
    shape = lerp(shape, popped, pop);
    heat = max(heat, WindUpHeat * pop);

    float share = smoothstep(0.0, PeelSeconds, seconds - leave) * (1.0 - home);
    Steer steer = SteerOf(lerp(shape, context.baseGoal, home), share, heat);
    steer.isFast = flight > 0.0 && flight < 1.0 && home <= 0.0;
    steer.floorY = home < 1.0 && flight >= 1.0 ? hive.y + HoneycombFloorHeight : NoFloor;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// The slot dispatch.

SlotContext ContextOf(int slot, uint index, WaspStatic wasp, float3 baseGoal)
{
    float4 header = SlotHeader(slot);
    float4 p1 = _Slots[slot * SLOT_VECTORS + 2];

    SlotContext context;
    context.index = index;
    context.wasp = wasp;
    context.baseGoal = baseGoal;
    context.u = saturate((wasp.squad - header.z) / max(header.w - header.z, Tiny));
    context.lane = FlowLaneAt(wasp, header.y);
    context.seconds = max(_SimTime - header.y + BeatSlack, 0.0);
    context.released = p1.w >= 0.0 ? max(_SimTime - p1.w, 0.0) : -1.0;
    context.p0 = _Slots[slot * SLOT_VECTORS + 1];
    context.p1 = p1;
    return context;
}

// One case per slot song. A form this file does not know yet leaves its squad in the base form.
Steer SlotSteer(int form, SlotContext context)
{
    Steer steer = SteerOf(context.baseGoal, 0.0, RiverGlow);
    if (form == FormSting)
    {
        steer = StingSteer(context);
    }
    else if (form == FormTornado)
    {
        steer = TornadoSteer(context);
    }
    else if (form == FormMeteor)
    {
        steer = MeteorSteer(context);
    }
    else if (form == FormDome)
    {
        steer = DomeSteer(context);
    }
    else if (form == FormHydra)
    {
        steer = HydraSteer(context);
    }
    else if (form == FormScythe)
    {
        steer = ScytheSteer(context);
    }
    else if (form == FormLance)
    {
        steer = LanceSteer(context);
    }
    else if (form == FormNest)
    {
        steer = NestSteer(context);
    }
    else if (form == FormHoneycomb)
    {
        steer = HoneycombSteer(context);
    }

    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// Plan section X: the free swarm flows round the tall props, nest trees and hives instead of through them.

static const float ObstacleTopFade = 0.6;        // metres over an obstacle's top through which its bend fades out
static const float ObstacleSoftShare = 0.5;      // share of the bent radius over which a goal eases onto the edge
static const float ObstacleLeastSpeed = 0.6;     // m/s below which a wasp's way is unsure, so the bend leans to a push straight out
static const float ObstacleTieShare = 0.1;       // share of the radius by which a wasp's seed picks its side when dead centre
static const float ObstacleFadeShare = 0.8;      // share of an obstacle's reach from which its bend fades to nothing at the reach

// The smooth larger of two values: within about `width` of each other it rounds the corner, so a goal eases onto an
// obstacle's edge instead of creasing there.
float SoftMax(float first, float second, float width)
{
    float gap = first - second;
    return 0.5 * (first + second + sqrt(gap * gap + width * width));
}

// Bends a free wasp's goal round every obstacle below its top. In each obstacle's frame, along the way the wasp flies and
// across it, the goal's distance across is eased out to at least the radius plus _ObstacleMargin, from _ObstacleLead before
// the edge to _ObstacleClose past it, on the side the wasp itself is on (its seed picks one when it is dead centre). So the
// stream parts in two, hugs the obstacle, closes again behind it, and each wasp keeps its side: a wasp pushed out only
// moves further onto it. The goal also runs up to _ObstacleSpeedUp ahead past the middle and as far behind before it, so
// the wasps bunch a little before, speed up on the way round and ease off after. Where the obstacle is full on (from the
// edge before it to the edge past it) the bent goal lies outside the radius plus the margin whatever the way, so a turn of
// the way never pulls a goal in. A wasp too slow to have a sure way is pushed out on its own side instead, blended by its
// speed.
// It moves the goal once a frame, before the springs: they fly the bent path and are never fought. `share` is how much of
// the free swarm the wasp flies: 0 for a shape, a slot song or the giant.
float3 FlowAroundObstacles(float3 goal, float2 flow, WaspDynamic body, WaspStatic wasp, float share)
{
    // No early return: the Metal translation warns of one (as for FistHandOf); a wasp with no share loops over nothing.
    float weight = share * _ObstacleStrength;
    int count = weight > 0.0 ? _ObstacleCount : 0;

    // The way: the stream's own (the path at the wasp's place in the river, the loop's in the eight), which the swirl
    // through the river's cross-section never turns, signed the way the wasp flies; else, between a shape and the river,
    // the wasp's own velocity. A wasp's side is read in this frame, so a frame that wobbled would flip far wasps' sides.
    float2 travel = body.velocity.xz;
    float speed = length(travel);
    float2 moving = speed > Tiny ? travel / speed : float2(0.0, 1.0);
    float flowLength = length(flow);
    float2 stream = flowLength > Tiny ? flow / flowLength : moving;
    stream = dot(stream, moving) < 0.0 ? -stream : stream;
    float streamShare = saturate(flowLength);
    float2 way = normalize(lerp(moving, stream, streamShare));
    float sure = max(smoothstep(0.0, ObstacleLeastSpeed, speed), streamShare);
    float tie = frac(wasp.seed * 7.31) < 0.5 ? -1.0 : 1.0;
    float3 bent = goal;

    [loop]
    for (int index = 0; index < count; index++)
    {
        float4 obstacle = _Obstacles[index];
        float radius = obstacle.z + _ObstacleMargin;
        float reach = radius + max(_ObstacleLead, _ObstacleClose);
        float2 offset = bent.xz - obstacle.xy;
        float distanceSquared = dot(offset, offset);
        float below = 1.0 - smoothstep(obstacle.w, obstacle.w + ObstacleTopFade, bent.y);
        if (below > 0.0 && distanceSquared < reach * reach)
        {
            // The frame: along the way, turned toward straight round the obstacle past the wasp itself while the way is
            // unsure (a wasp between a shape and the river, nearly still), so then the goal is pushed out on the wasp's
            // own side and never swung across the obstacle. The two directions are kept within a right angle of each
            // other, so their blend never cancels.
            float distance = sqrt(distanceSquared);
            float2 fromMiddle = body.position.xz - obstacle.xy;
            float bodyReach = length(fromMiddle);
            float2 outward = bodyReach > Tiny ? fromMiddle / bodyReach : (distance > Tiny ? offset / distance : way);
            float2 circling = float2(-outward.y, outward.x);
            circling = dot(circling, way) < 0.0 ? -circling : circling;
            float2 along = normalize(lerp(circling, way, sure));
            float2 across = float2(-along.y, along.x);

            float ahead = dot(offset, along);
            float aside = dot(offset, across);
            float on = smoothstep(-(radius + _ObstacleLead), -radius, ahead)
                * (1.0 - smoothstep(radius, radius + _ObstacleClose, ahead));
            float side = dot(fromMiddle, across) + tie * ObstacleTieShare * radius >= 0.0 ? 1.0 : -1.0;
            float hugged = side * SoftMax(abs(aside), radius * on, ObstacleSoftShare * radius * on);
            float asideTo = lerp(aside, hugged, on);
            float aheadTo = ahead * (1.0 + _ObstacleSpeedUp * on);

            float fade = 1.0 - smoothstep(reach * ObstacleFadeShare, reach, distance);
            bent.xz += (along * (aheadTo - ahead) + across * (asideTo - aside)) * (weight * below * fade);
        }
    }

    return bent;
}

// ---------------------------------------------------------------------------------------------------------------------
// The Gust pulse, added on top of whatever a wasp is doing. Its time test reads uniforms only, so every thread takes the
// same branch.

float3 GustPush(float3 goal, WaspStatic wasp, out float heat)
{
    heat = 0.0;
    float3 push = Still;
    float age = _SimTime - _Pulse.z;
    float radius = _Pulse.w;

    if (radius > 0.0 && age >= 0.0 && age < GustPulseSeconds)
    {
        float2 away = goal.xz - _Pulse.xy;
        float reach = length(away);
        float2 direction = float2(cos(wasp.seed * FullTurn), sin(wasp.seed * FullTurn));
        if (reach > Tiny)
        {
            direction = away / reach;
        }

        float inside = reach <= radius ? 1.0 : 0.0;
        float inhale = smoothstep(0.0, GustInhaleSeconds, age) * (1.0 - smoothstep(GustInhaleSeconds, 2.0 * GustInhaleSeconds, age));
        float grown = saturate((age - GustInhaleSeconds) / GustRingSeconds);
        float front = lerp(GustStartRadius, radius, 1.0 - (1.0 - grown) * (1.0 - grown));
        float passed = age >= GustInhaleSeconds ? front - reach : -1.0;
        float wave = saturate(passed / GustPushRise) * (1.0 - saturate((passed - GustPushRise) / GustPushFall));
        wave *= (1.0 - smoothstep(GustFadeStart, GustPulseSeconds, age)) * inside;

        float outward = wave * GustPushMeters - inhale * inside * GustInhaleMeters;
        push = float3(direction.x, 0.0, direction.y) * outward + Up * (wave * GustLiftMeters);
        heat = wave * GustGlow;
    }

    return push;
}

// ---------------------------------------------------------------------------------------------------------------------
// The giant's hand launch (songs-v2 R). At the end of the arm's thrust the wasps of that hand and its forearm leave the
// arm in turn, the hand first, and fly as one tight fist on a low arc; all of them reach the target together, so the bolt
// tightens as it flies, and it speeds up into the hit. It bursts open over the target to the hit's radius, turns there,
// and streams home over the regrow, the forearm's wasps first and the fingers' last, so the arm grows again from the
// elbow. A fist the giant's end cuts off in flight never hits: its wasps ease back into the swarm from where it was.

static const float FistBoltShare = 0.3;          // the bolt's radius, as a share of the hit's radius: a tight fist
static const float FistStretch = 1.8;            // the bolt's length along its flight, as a share of its width
static const float FistStagger = 0.1;            // seconds from the first wasp leaving the arm to the last, at most
static const float FistStaggerShare = 0.4;       // ... and at most this share of a short flight
static const float FistChestHeight = 1.0;        // metres above the target's feet the fist flies at
static const float FistArcShare = 0.2;           // the flight's arc, as a share of its length: high enough that the chase
                                                 // camera, behind the giant, sees the fist rise over its shoulder
static const float FistMostArc = 2.0;            // metres
static const float FistTakeOffSeconds = 0.06;    // seconds a wasp eases from its place on the arm onto the fist's path
static const float FistBurstSeconds = 0.15;      // seconds the fist takes to burst open over the target
static const float FistBurstMostShare = 0.25;    // ... and at most this share of a short regrow, the rest for the way home
static const float FistCloudShare = 0.8;         // the burst's radius, as a share of the hit's radius
static const float FistCloudSpin = 1.5;          // radians per second the burst turns while it waits to stream home
static const float FistReturnSeconds = 0.55;     // seconds each wasp flies home; their starts spread over the regrow.
                                                 // A regrow shorter than the burst and one way home squeezes both, so
                                                 // every wasp is home as the arm is whole and the rules let it launch
static const float FistReturnArcShare = 0.15;
static const float FistMostReturnArc = 1.5;      // metres
static const float FistForearmShare = 0.55;      // the share of the regrow's starts the forearm's wasps take, before the hand's
static const float FistDropSeconds = 0.6;        // seconds a fist cut off in flight takes to ease back into the swarm
static const float FistFloor = 0.15;             // metres above the ground the burst keeps

struct FistSteer
{
    float3 goal;    // already blended with the form's goal by share
    float share;    // 0 while the wasp flies its form, 1 while the fist holds it
    float heat;
    float pin;
    float red;      // 0 to 1: how far the wasp has turned to the throw colour (songs-v2 W)
    bool isFast;
};

// The hand whose fist the wasp is part of, 0 right or 1 left, or -1.
int FistHandOf(WaspStatic wasp)
{
    if (!HasColossusPlace(wasp))
    {
        return -1;
    }

    int bone = BoneOf(wasp);
    if (bone >= (int)_FistBones.x && bone <= (int)_FistBones.y)
    {
        return 0;
    }

    return bone >= (int)_FistBones.z && bone <= (int)_FistBones.w ? 1 : -1;
}

bool IsForearm(WaspStatic wasp, int hand)
{
    return BoneOf(wasp) == (int)(hand == 0 ? _FistBones.x : _FistBones.z);
}

// A point in the unit ball, the same for the wasp every frame, spread evenly through the ball's volume.
float3 BallPoint(WaspStatic wasp)
{
    float height = wasp.level01 * 2.0 - 1.0;
    float around = wasp.phase01 * FullTurn;
    float ring = sqrt(saturate(1.0 - height * height));
    return float3(cos(around) * ring, height, sin(around) * ring) * pow(max(wasp.seed, Tiny), 1.0 / 3.0);
}

float3 TurnAboutUp(float3 offset, float angle)
{
    float turnSin;
    float turnCos;
    sincos(angle, turnSin, turnCos);
    return float3(offset.x * turnCos - offset.z * turnSin, offset.y, offset.x * turnSin + offset.z * turnCos);
}

float3 FistPath(float3 from, float3 to, float along, float arcShare, float mostArc)
{
    float arc = min(length(to - from) * arcShare, mostArc);
    return lerp(from, to, along) + Up * (sin(along * HalfTurn) * arc);
}

FistSteer FistSteerOf(int hand, WaspStatic wasp, float3 formGoal)
{
    FistSteer steer;
    steer.goal = formGoal;
    steer.share = 0.0;
    steer.heat = 0.0;
    steer.pin = 0.0;
    steer.red = 0.0;
    steer.isFast = false;

    int at = hand * FIST_VECTORS;
    float4 launch = _Fists[at];
    float t = _SimTime - launch.w;
    if (launch.w < 0.0 || t < 0.0)
    {
        return steer;
    }

    float4 hit = _Fists[at + 1];
    float4 grow = _Fists[at + 2];
    float flight = max(hit.w - launch.w, Tiny);
    float regrow = grow.x - hit.w;
    float dropped = grow.y < 0.0 ? -1.0 : grow.y - launch.w;
    bool isDropped = dropped >= 0.0 && dropped < flight;

    float3 from = launch.xyz;
    float3 to = hit.xyz + Up * FistChestHeight;
    float3 way = to - from;
    float wayLength = length(way);
    float3 forward = wayLength > Tiny ? way / wayLength : float3(0.0, 0.0, 1.0);
    float3 ball = BallPoint(wasp) * (FistBoltShare * grow.z);
    float3 bolt = ball + forward * (dot(ball, forward) * (FistStretch - 1.0));

    bool isForearm = IsForearm(wasp, hand);
    float leaves = (isForearm ? 0.5 + 0.5 * wasp.seed : 0.5 * wasp.seed) * min(FistStagger, flight * FistStaggerShare);
    float flown = isDropped ? min(t, dropped) : t;
    float along = saturate((flown - leaves) / max(flight - leaves, Tiny));
    float3 flying = FistPath(from, to, along * along, FistArcShare, FistMostArc) + bolt;

    if (isDropped)
    {
        float leftArm = smoothstep(0.0, FistTakeOffSeconds, dropped - leaves);
        steer.share = leftArm * (1.0 - smoothstep(0.0, FistDropSeconds, t - dropped));
        steer.goal = lerp(formGoal, flying, steer.share);
        steer.heat = HoldHeat;
        steer.red = steer.share;
        return steer;
    }

    if (t < flight)
    {
        float takeOff = smoothstep(0.0, FistTakeOffSeconds, t - leaves);
        steer.share = takeOff;
        steer.goal = lerp(formGoal, flying, takeOff);
        steer.pin = takeOff;
        steer.isFast = true;
        steer.heat = lerp(WindUpStartHeat, WindUpHeat, along);
        steer.red = takeOff * smoothstep(0.0, max(_ThrowRedSeconds, Tiny), t - leaves);
        return steer;
    }

    float sinceHit = t - flight;
    float burstSeconds = min(FistBurstSeconds, max(regrow, 0.0) * FistBurstMostShare);
    float returnSeconds = max(min(FistReturnSeconds, regrow - burstSeconds), Tiny);
    float3 cloud = lerp(bolt, ball * (FistCloudShare / FistBoltShare), smoothstep(0.0, max(burstSeconds, Tiny), sinceHit));
    float order = isForearm ? FistForearmShare * wasp.seed : FistForearmShare + (1.0 - FistForearmShare) * wasp.seed;
    float homeStart = burstSeconds + order * max(regrow - burstSeconds - returnSeconds, 0.0);
    float home = saturate((sinceHit - homeStart) / returnSeconds);
    if (home >= 1.0)
    {
        return steer;
    }

    steer.share = 1.0;
    steer.isFast = true;
    if (sinceHit < homeStart)
    {
        steer.goal = to + TurnAboutUp(cloud, sinceHit * FistCloudSpin);
        steer.heat = sinceHit < ImpactSeconds ? ImpactHeat : HoldHeat;
        steer.red = 1.0;
        return steer;
    }

    float eased = smoothstep(0.0, 1.0, home);
    float3 waited = to + TurnAboutUp(cloud, homeStart * FistCloudSpin);
    steer.goal = FistPath(waited, formGoal, eased, FistReturnArcShare, FistMostReturnArc);
    steer.pin = smoothstep(0.0, FistTakeOffSeconds, sinceHit - homeStart);
    steer.heat = HoldHeat * (1.0 - eased);
    steer.red = 1.0 - eased;
    return steer;
}

// ---------------------------------------------------------------------------------------------------------------------
// The giant's thrown wasps (songs-v2 W). On a move's hit a band of the wasps on the limbs it strikes with leaves the body in
// that move's shape, burning red, holds a moment and streams home along a low arc, gold again as it rejoins. A look only:
// the rules never see it. Each throw picks its wasps by their seed, in a band that moves on at every throw, so a quick
// chain of punches throws fresh wasps each time; a wasp two throws claim flies the later one. A flying fist keeps its own.

static const int ShapeCone = 1;
static const int ShapeFan = 2;
static const int ShapeRing = 3;
static const int ShapeSpray = 4;
static const int ShapeSpiral = 5;
static const int ShapeCrater = 6;

static const float ThrowStagger = 0.04;          // seconds over which a burst's wasps leave, the first on the hit's frame
static const float ThrowFanStagger = 0.08;       // the kick's fan sweeps across over this long, one side first
static const float ThrowTakeOffSeconds = 0.05;   // seconds a wasp eases from its place on the body onto the throw's path
static const float ThrowHoldSeconds = 0.05;      // seconds the burst hangs at its widest before the stream home
static const float ThrowReturnStagger = 0.12;    // seconds the starts home spread over, so the limb fills back in turn
static const float ThrowLeastReturnSeconds = 0.18;
static const float ThrowReturnArcShare = 0.25;
static const float ThrowMostReturnArc = 1.2;     // metres
static const float ThrowGroundHeight = 0.3;      // metres above the ground the fan, the rings and the crater skim
static const float ThrowSkimRise = 0.5;          // metres the skimming wasps spread up from there, by their seed
static const float ThrowConeNear = 0.3;          // the share of the reach the cone's nearest wasp flies, so it streams from the fist
static const float ThrowFanNear = 0.45;          // ... the fan's, so it fills from the foot out
static const float ThrowSprayNear = 0.4;         // ... the spray's
static const float ThrowFlashSeconds = 0.04;     // seconds a thrown wasp flashes white as it leaves, before it burns red
static const float ThrowHeat = 0.6;              // how hot it burns while it is out
static const float ThrowRingInner = 0.6;         // metres from the centre the rings and the spiral start
static const float ThrowDropShare = 0.3;         // share of the way out a ring's wasp takes to drop from the hand to the ground
static const float ThrowSprayLift = 0.6;         // radians the roar's spray rises at most
static const float ThrowSpiralLow = 0.4;         // metres above the ground the spiral's outer end turns
static const float ThrowSpiralRise = 1.6;        // ... and how much higher its inner end, so it unwinds outward and down
static const float ThrowSpiralTight = 0.2;       // the spiral's inner end's share of the reach: one arm, widening once round
static const float ThrowCraterLift = 0.9;        // metres the crater's slower ring arcs up as it goes
static const float ThrowFloor = 0.12;            // metres above the ground a thrown wasp keeps

struct ThrowSteer
{
    float3 goal;    // already blended with the form's goal
    float share;    // 0 while no throw holds the wasp
    float heat;
    float red;      // 0 to 1: how far the wasp has turned to the throw colour
    float pin;
    float start;    // the throw's hit, so the latest of two claims wins
};

int LimbsOfBone(int bone)
{
    if (bone < 0 || bone >= BONE_LIMB_VECTORS * 4)
    {
        return 0;
    }

    float4 four = _BoneLimbs[bone >> 2];
    int lane = bone & 3;
    float bits = lane == 0 ? four.x : (lane == 1 ? four.y : (lane == 2 ? four.z : four.w));
    return (int)(bits + 0.5);
}

// Where the throw holds the wasp `flown` seconds after it left, `outward` of the way out (0 to 1, eased).
float3 ThrowPoint(int shape, WaspStatic wasp, float3 formGoal, float3 center, float3 facing, float4 numbers, float outward, float flown)
{
    float spread = numbers.x;
    float reach = numbers.y;
    float3 side = float3(facing.z, 0.0, -facing.x);
    float skim = center.y + ThrowGroundHeight + ThrowSkimRise * wasp.seed;

    if (shape == ShapeCone)
    {
        // A tight cone straight out of the fist: each wasp keeps one direction within the spread of the facing.
        float around = wasp.phase01 * FullTurn;
        float off = sqrt(wasp.level01) * tan(min(spread, 1.4));
        float3 way = normalize(facing + side * (cos(around) * off) + Up * (sin(around) * off));
        return formGoal + way * (reach * outward * lerp(ThrowConeNear, 1.0, wasp.seed));
    }

    if (shape == ShapeFan)
    {
        // A low fan from the foot: across the spread by the wasp's phase, the side it sweeps from leaving first.
        float3 way = TurnFlat(facing, lerp(-spread, spread, wasp.phase01));
        float3 spot = formGoal + way * (reach * outward * lerp(ThrowFanNear, 1.0, wasp.seed));
        spot.y = lerp(formGoal.y, skim, saturate(outward * 2.0));
        return spot;
    }

    if (shape == ShapeSpray)
    {
        // A spray from the head and chest in a wide arc ahead, rising by the wasp's height.
        float lift = wasp.level01 * ThrowSprayLift;
        float3 way = TurnFlat(facing, lerp(-spread, spread, wasp.phase01)) * cos(lift) + Up * sin(lift);
        return formGoal + way * (reach * outward * lerp(ThrowSprayNear, 1.0, wasp.seed));
    }

    if (shape == ShapeSpiral)
    {
        // A spiral unwinding around the giant: one arm, its radius growing with the angle round it, turning as it widens.
        float arm = wasp.phase01;
        float angle = arm * FullTurn + numbers.w * flown;
        float3 spot = center + RingOffset(angle, ThrowRingInner + reach * outward * lerp(ThrowSpiralTight, 1.0, arm));
        spot.y = center.y + ThrowSpiralLow + ThrowSpiralRise * (1.0 - arm);
        return lerp(formGoal, spot, smoothstep(0.0, ThrowDropShare, outward));
    }

    // The slam's ring and the leap's crater race outward along the ground all around the centre. The crater sends its
    // second share of wasps as a slower ring that arcs up as it goes.
    bool isSecondRing = shape == ShapeCrater && wasp.level01 < numbers.w;
    float pace = isSecondRing ? numbers.w : 1.0;
    float3 ring = center + RingOffset(wasp.phase01 * FullTurn, ThrowRingInner + reach * pace * outward);
    ring.y = skim + (isSecondRing ? sin(outward * HalfTurn) * ThrowCraterLift : 0.0);
    return lerp(formGoal, ring, smoothstep(0.0, ThrowDropShare, outward));
}

ThrowSteer ThrowSteerOf(int index, WaspStatic wasp, int limbs, float3 formGoal)
{
    ThrowSteer steer;
    steer.goal = formGoal;
    steer.share = 0.0;
    steer.heat = 0.0;
    steer.red = 0.0;
    steer.pin = 0.0;
    steer.start = -1.0;

    int at = index * THROW_VECTORS;
    float4 header = _Throws[at];
    float4 aim = _Throws[at + 1];
    float4 band = _Throws[at + 2];
    float4 numbers = _Throws[at + 3];
    float back = band.w;
    float t = _SimTime - header.w;
    if (header.w < 0.0 || t < 0.0 || t >= back || ((int)(band.x + 0.5) & limbs) == 0 || frac(wasp.seed - band.z) >= band.y)
    {
        return steer;
    }

    int shape = (int)(aim.w + 0.5);
    float leaves = shape == ShapeFan ? wasp.phase01 * ThrowFanStagger : wasp.seed * ThrowStagger;
    float flown = t - leaves;
    if (flown < 0.0)
    {
        return steer;
    }

    float outSeconds = max(numbers.z, Tiny);
    float returnStart = min(outSeconds + ThrowHoldSeconds + wasp.seed * ThrowReturnStagger, back - leaves - ThrowLeastReturnSeconds);
    returnStart = max(returnStart, Tiny);
    float returnSeconds = max(back - leaves - returnStart, Tiny);
    float takeOff = smoothstep(0.0, ThrowTakeOffSeconds, flown);

    steer.start = header.w;
    if (flown < returnStart)
    {
        float outward = EaseOutCubic(flown / outSeconds);
        steer.goal = lerp(formGoal, ThrowPoint(shape, wasp, formGoal, header.xyz, aim.xyz, numbers, outward, flown), takeOff);
        steer.share = takeOff;
        steer.pin = takeOff;
        steer.heat = flown < ThrowFlashSeconds ? ImpactHeat : ThrowHeat;
        steer.red = smoothstep(0.0, max(_ThrowRedSeconds, Tiny), flown);
        return steer;
    }

    float home = saturate((flown - returnStart) / returnSeconds);
    if (home >= 1.0)
    {
        return steer;
    }

    float eased = smoothstep(0.0, 1.0, home);
    float3 widest = ThrowPoint(shape, wasp, formGoal, header.xyz, aim.xyz, numbers, EaseOutCubic(returnStart / outSeconds), returnStart);
    steer.goal = FistPath(widest, formGoal, eased, ThrowReturnArcShare, ThrowMostReturnArc);
    steer.share = 1.0;
    steer.pin = 1.0;
    steer.heat = ThrowHeat * (1.0 - eased);
    steer.red = 1.0 - eased;
    return steer;
}

// The latest throw that holds the wasp, if any. Only a wasp in its place on the giant can be thrown.
ThrowSteer ThrownSteerOf(WaspStatic wasp, float3 formGoal)
{
    ThrowSteer chosen;
    chosen.goal = formGoal;
    chosen.share = 0.0;
    chosen.heat = 0.0;
    chosen.red = 0.0;
    chosen.pin = 0.0;
    chosen.start = -1.0;

    int limbs = LimbsOfBone(BoneOf(wasp));
    if (limbs == 0)
    {
        return chosen;
    }

    [unroll]
    for (int index = 0; index < THROW_COUNT; index++)
    {
        ThrowSteer steer = ThrowSteerOf(index, wasp, limbs, formGoal);
        if (steer.share > 0.0 && steer.start > chosen.start)
        {
            chosen = steer;
        }
    }

    return chosen;
}

// ---------------------------------------------------------------------------------------------------------------------

// True in the one frame a wasp's river lane wraps from the tail (1) back to the core (0).
bool HasLaneWrapped(WaspStatic wasp)
{
    float now = wasp.lane + _SimTime * _FlowSpeed;
    float before = now - _DeltaTime * _FlowSpeed;
    return floor(now) != floor(before);
}

// The Colossus builds from the feet up. Every other whole-swarm form sweeps along the river as it was at the change,
// from its head to its tail, a little ragged by each wasp's seed.
float WaveOrderOf(int form, WaspStatic wasp, float startTime)
{
    float order = form == FormColossus ? wasp.height01 : FlowLaneAt(wasp, startTime);
    return WaveRank(order, wasp);
}

// How far a wasp has eased into a whole-swarm form, `seconds` after its change's wave reached it.
float HandOverOf(float seconds)
{
    return _FormBlendSeconds > 0.0 ? smoothstep(0.0, _FormBlendSeconds, seconds) : (seconds >= 0.0 ? 1.0 : 0.0);
}

// How many equal steps the springs cut this frame into, each at most _SpringStep long. The same for every thread.
int SpringSteps()
{
    return clamp((int)ceil(_DeltaTime / max(_SpringStep, Tiny) - 0.001), 1, MOST_SPRING_STEPS);
}

float3 LimitSpeed(float3 velocity, float maxSpeed)
{
    float speed = length(velocity);
    return speed > maxSpeed ? velocity * (maxSpeed / speed) : velocity;
}

// A wasp that reaches its floor skims along it instead of going through, and loses most of its speed.
void Skim(float floorY, inout WaspDynamic body)
{
    if (body.position.y < floorY)
    {
        body.position.y = floorY;
        body.velocity.y = max(body.velocity.y, 0.0);
        body.velocity.xz *= MeteorSkidKeep;
    }
}

// The spring of spec 9.4, stepped with semi-implicit Euler in equal steps of at most _SpringStep, so the swarm takes the
// same steps at 60 and at 120 frames a second (songs-v2 Q). Each wasp takes up a new whole-swarm form at
// formStartTime + order x FormWaveSeconds and eases into it over _FormBlendSeconds, so a change sweeps along the river
// (or up the Colossus) as a wave and no wasp's goal jumps. A wasp in a live slot's squad flies that slot's song instead,
// starting from and returning to where the whole-swarm form wants it.
void Fly(uint index, WaspStatic wasp, inout WaspDynamic body)
{
    float switchTime = _FormStartTime + WaveOrderOf(_Form, wasp, _FormStartTime) * _FormWaveSeconds;
    float formSeconds = _SimTime - switchTime;
    bool hasSwitched = formSeconds >= 0.0;
    float handOver = HandOverOf(formSeconds);

    int look = FormRiver;
    bool isShape = false;
    float wound = 1.0;
    float3 goal = Still;
    float4 tint = float4(0.0, 0.0, 0.0, 0.0);
    float stiffness = 0.0;
    float damping = 0.0;
    float freeShare = 0.0;                // how much of the free swarm the wasp flies, which flows round obstacles (songs-v2 X)
    float2 flow = float2(0.0, 0.0);       // the way the free swarm's stream runs here, either sign
    if (handOver > 0.0)
    {
        goal = GoalOf(_Form, wasp, look, isShape, wound, flow);
        freeShare = isShape ? 0.0 : 1.0;
        tint = TintOf(look, true);
        stiffness = isShape ? _ShapeSpring : _RiverSpring;
        damping = isShape ? _ShapeDamping : _RiverDamping;
    }

    // Only the form being taken up wobbles as it forms: the shape a wasp is leaving keeps its blended springs.
    bool isFormingShape = isShape;

    // Until the wave has eased it into the new form, the wasp flies (partly) the form before.
    if (handOver < 1.0)
    {
        int previousLook;
        bool wasShape;
        float previousWound;
        float2 previousFlow;
        float3 previousGoal = GoalOf(_PreviousForm, wasp, previousLook, wasShape, previousWound, previousFlow);
        float4 previousTint = TintOf(previousLook, false);
        float previousStiffness = wasShape ? _ShapeSpring : _RiverSpring;
        float previousDamping = wasShape ? _ShapeDamping : _RiverDamping;
        float previousFree = wasShape ? 0.0 : 1.0;

        // The change before may still be on its way through the swarm: a wasp its wave has not yet eased over still
        // flies (partly) the form before that, so a quick second change (Hive Call ending as the stores run dry) never
        // makes it jump.
        float earlierSeconds = _SimTime - (_PreviousFormStartTime + WaveOrderOf(_PreviousForm, wasp, _PreviousFormStartTime) * _FormWaveSeconds);
        float earlierHandOver = HandOverOf(earlierSeconds);
        if (earlierHandOver < 1.0)
        {
            int earlierLook;
            bool wasEarlierShape;
            float earlierWound;
            float2 earlierFlow;
            float3 earlierGoal = GoalOf(_EarlierForm, wasp, earlierLook, wasEarlierShape, earlierWound, earlierFlow);
            previousFlow = lerp(earlierFlow * sign(dot(earlierFlow, previousFlow) + Tiny), previousFlow, earlierHandOver);
            previousGoal = lerp(earlierGoal, previousGoal, earlierHandOver);
            previousTint = lerp(TintOf(earlierLook, false), previousTint, earlierHandOver);
            previousStiffness = lerp(wasEarlierShape ? _ShapeSpring : _RiverSpring, previousStiffness, earlierHandOver);
            previousDamping = lerp(wasEarlierShape ? _ShapeDamping : _RiverDamping, previousDamping, earlierHandOver);
            previousWound = lerp(earlierWound, previousWound, earlierHandOver);
            previousFree = lerp(wasEarlierShape ? 0.0 : 1.0, previousFree, earlierHandOver);
            if (earlierHandOver < 0.5)
            {
                previousLook = earlierLook;
                wasShape = wasEarlierShape;
            }
        }

        goal = lerp(previousGoal, goal, handOver);
        tint = lerp(previousTint, tint, handOver);
        stiffness = lerp(previousStiffness, stiffness, handOver);
        damping = lerp(previousDamping, damping, handOver);
        wound = lerp(previousWound, wound, handOver);
        freeShare = lerp(previousFree, freeShare, handOver);
        flow = lerp(previousFlow * sign(dot(previousFlow, flow) + Tiny), flow, handOver);
        if (handOver < 0.5)
        {
            look = previousLook;
            isShape = wasShape;
        }
    }

    if (look == FormRiver)
    {
        tint.w += EightCrossingHeat(goal);
    }

    // A shape that has just formed wobbles a moment; the river and the eight flow on without one, and so does a wasp
    // that is leaving a shape for the river through the first half of its hand-over.
    bool isWobbling = isFormingShape && hasSwitched && formSeconds < _WobbleSeconds;
    bool isFlowing = !isShape;
    float maxSpeed = MaxSpeed;
    float floorY = NoFloor;
    float tintSharpness = TintSharpness;
    float pin = 0.0;
    bool isFlashing = false;

    // The giant's hand launch: the wasps of a launched hand fly its fist instead of their places on the arm. Thrown wasps
    // and flying fists burn the throw colour while they are off the body (songs-v2 W).
    bool isThrown = false;
    bool isOnGiant = _Form == FormColossus && hasSwitched && HasColossusPlace(wasp);
    int fistHand = FistHandOf(wasp);
    bool isFistFlying = false;
    if (fistHand >= 0)
    {
        FistSteer fist = FistSteerOf(fistHand, wasp, goal);
        if (fist.share > 0.0)
        {
            isFistFlying = true;
            isThrown = true;
            goal = fist.goal;
            freeShare = 0.0;
            tint.a = lerp(tint.a, fist.heat, saturate(fist.share));
            tint.rgb = lerp(tint.rgb, _ThrowColor.rgb, saturate(fist.red));
            isWobbling = false;
            isFlowing = false;
            pin = saturate(fist.pin);
            floorY = FistFloor;
            if (fist.isFast)
            {
                stiffness = StrikeSpring;
                damping = StrikeDamping;
                maxSpeed = StrikeMaxSpeed;
            }
        }
    }

    if (isOnGiant && !isFistFlying)
    {
        ThrowSteer thrown = ThrownSteerOf(wasp, goal);
        if (thrown.share > 0.0)
        {
            isThrown = true;
            goal = thrown.goal;
            freeShare = 0.0;
            tint.a = lerp(tint.a, thrown.heat, saturate(thrown.share));
            tint.rgb = lerp(tint.rgb, _ThrowColor.rgb, saturate(thrown.red));
            isWobbling = false;
            isFlowing = false;
            pin = saturate(thrown.pin);
            floorY = ThrowFloor;
            stiffness = StrikeSpring;
            damping = StrikeDamping;
            maxSpeed = StrikeMaxSpeed;
        }
    }

    if (isThrown)
    {
        tintSharpness = SlotTintSharpness;
    }

    int slot = SlotOf(wasp);
    if (slot != NoSlot)
    {
        SlotContext context = ContextOf(slot, index, wasp, goal);
        Steer steer = SlotSteer((int)(SlotHeader(slot).x + 0.5), context);
        goal = steer.goal;
        freeShare *= 1.0 - steer.share;
        tint = lerp(tint, float4(_SlotColors[slot].rgb, steer.heat), steer.share);
        stiffness = lerp(stiffness, _ShapeSpring, steer.share);
        damping = lerp(damping, _ShapeDamping, steer.share);
        isWobbling = steer.share > 0.0 && context.seconds < _WobbleSeconds;
        isFlowing = isFlowing && steer.share <= 0.0;
        floorY = steer.floorY;
        tintSharpness = SlotTintSharpness;
        pin = saturate(steer.pin);

        // On the usual springs and speed cap a fast strike would trail metres behind its path and land late.
        if (steer.isFast)
        {
            stiffness = StrikeSpring;
            damping = StrikeDamping;
            maxSpeed = StrikeMaxSpeed;
            isWobbling = false;
        }

        // The cast flash: on the cast's frame, before any wasp has moved, the whole squad burns white in its colour.
        if (SlotFlashOf(slot) > 0.5)
        {
            tint = float4(_SlotColors[slot].rgb, ImpactHeat);
            isFlashing = true;
        }
    }

    float gustHeat;
    goal += GustPush(goal, wasp, gustHeat);
    tint.a = max(tint.a, gustHeat);

    // The free swarm parts round the trees, ruins, nest trees and hives (songs-v2 X). A wasp on its way to a strike or home
    // from one bends by the share of the free swarm it still flies, so a strike flies its own path and rejoins the bent river
    // smoothly; the giant, the halo and the slot songs' shapes never bend.
    goal = FlowAroundObstacles(goal, flow, body, wasp, freeShare);

    // A wasp that leaves the river's tail starts again at its head. Flying there would draw a straight, sparse
    // second river across every curve of the path, so it jumps instead; in the crowd at the head nobody sees it. Round
    // the whole eight its place runs on without a break, so there it flies on.
    if (isFlowing && HasLaneWrapped(wasp) && wound < 1.0)
    {
        body.position = goal;
        body.velocity = Still;
    }

    if (isWobbling)
    {
        damping = _WobbleDamping;
    }

    float3 before = body.position;
    int steps = SpringSteps();
    float stepSeconds = _DeltaTime / steps;
    float dampingRate = 2.0 * damping * sqrt(stiffness);

    [loop]
    for (int step = 0; step < steps; step++)
    {
        float3 acceleration = stiffness * (goal - body.position) - dampingRate * body.velocity;
        body.velocity = LimitSpeed(body.velocity + acceleration * stepSeconds, maxSpeed);
        body.position += body.velocity * stepSeconds;
    }

    // A pinned wasp is placed on its goal, or eased that far toward it, and its speed becomes what it moved: the draw
    // streaks it, and the spring takes its motion over when the pin lets go. While the pin eases in, the step is held to
    // the strike speed, so a wasp still far off its path flies there instead of jumping; once fully pinned it is placed,
    // so a blink strike lands on its frame. A paused step (no time) leaves it be.
    if (pin > 0.0 && _DeltaTime > 0.0)
    {
        float3 moved = lerp(body.position, goal, pin) - before;
        if (pin < 1.0)
        {
            moved = LimitSpeed(moved, StrikeMaxSpeed * _DeltaTime);
        }

        body.position = before + moved;
        body.velocity = moved / _DeltaTime;
    }

    Skim(floorY, body);

    body.stateTime += _DeltaTime;

    // A song's heat rises at once and cools at the tint's pace, so an impact flashes on the frame it lands. The cast
    // flash takes its colour at once too, so it shows on its frame even while the swarm is frozen.
    float4 blended = lerp(body.tint, tint, saturate(_DeltaTime * tintSharpness));
    if (slot != NoSlot || isThrown)
    {
        blended.a = max(blended.a, tint.a);
    }

    body.tint = isFlashing ? tint : blended;
}

float DistanceOnGround(float3 from, float3 to)
{
    float2 offset = from.xz - to.xz;
    return length(offset);
}

// Where a revived wasp appears: the nearest standing hive to the core, or the core when none stands.
// During Hive Call with both hives standing, half come from each, so streams fly in from every hive.
float3 SpawnPoint(WaspStatic wasp)
{
    bool firstStands = _HiveA.w > 0.5;
    bool secondStands = _HiveB.w > 0.5;
    float3 spawn = _CorePosition.xyz + Up * FlyHeight;

    if (firstStands || secondStands)
    {
        float3 hive = firstStands ? _HiveA.xyz : _HiveB.xyz;
        if (firstStands && secondStands)
        {
            bool isFirstNearer = DistanceOnGround(_HiveA.xyz, _CorePosition.xyz) <= DistanceOnGround(_HiveB.xyz, _CorePosition.xyz);
            bool takesFirst = _Form == FormHiveCall ? wasp.seed < 0.5 : isFirstNearer;
            hive = takesFirst ? _HiveA.xyz : _HiveB.xyz;
        }

        spawn = hive + Up * SpawnHeight;
    }

    return spawn;
}

float3 Scatter(WaspStatic wasp, float size)
{
    return (float3(wasp.phase01, wasp.level01, wasp.seed) - 0.5) * (2.0 * size);
}

void Revive(WaspStatic wasp, inout WaspDynamic body)
{
    body.position = SpawnPoint(wasp) + Scatter(wasp, SpawnScatter);
    body.velocity = Up * SpawnLift;
    body.state = (float)StateAlive;
    body.stateTime = 0.0;
}

// A lost wasp bursts away from the last hit, then falls.
void StartDying(WaspStatic wasp, inout WaspDynamic body)
{
    float3 away = body.position - _LastHit.xyz;
    float awayLength = length(away);
    float3 direction = awayLength > Tiny ? away / awayLength : RingOffset(wasp.phase01 * FullTurn, 1.0);
    direction = normalize(direction + Up * BurstLift);
    body.velocity = direction * (BurstSpeed * (BurstSpreadMin + BurstSpreadRange * wasp.level01));
    body.state = (float)StateDying;
    body.stateTime = 0.0;
}

void Fall(inout WaspDynamic body)
{
    body.velocity.y -= Gravity * _DeltaTime;
    body.velocity *= saturate(1.0 - FallDrag * _DeltaTime);
    body.position += body.velocity * _DeltaTime;

    float ground = _CorePosition.y;
    if (body.position.y < ground)
    {
        body.position.y = ground;
        body.velocity = Still;
    }

    body.stateTime += _DeltaTime;
    if (body.stateTime >= _DyingSeconds)
    {
        body.state = (float)StateDead;
        body.stateTime = 0.0;
        body.velocity = Still;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void Simulate(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_MaxWasps)
    {
        return;
    }

    WaspStatic wasp = _Static[index];
    WaspDynamic body = _Dynamic[index];
    bool isActive = index < (uint)max(_ActiveCount, 0);
    int state = StateOf(body);

    if (state == StateDead && isActive)
    {
        Revive(wasp, body);
        state = StateAlive;
    }
    else if (state == StateAlive && !isActive)
    {
        StartDying(wasp, body);
        state = StateDying;
    }

    if (state == StateAlive)
    {
        Fly(index, wasp, body);
    }
    else if (state == StateDying)
    {
        Fall(body);
    }

    _Dynamic[index] = body;
}

// Fills the dynamic buffer the first time: the active wasps in a loose cloud about the core, the rest dead.
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResetWasps(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint)_MaxWasps)
    {
        return;
    }

    WaspStatic wasp = _Static[index];
    bool isActive = index < (uint)max(_ActiveCount, 0);

    WaspDynamic body;
    body.position = _CorePosition.xyz + Up * FlyHeight + Scatter(wasp, ResetScatter);
    body.state = isActive ? (float)StateAlive : (float)StateDead;
    body.velocity = Still;
    body.stateTime = 0.0;
    body.tint = TintOf(FormRiver, true);
    _Dynamic[index] = body;
}
